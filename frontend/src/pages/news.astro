            </svg>
          </div>
          <span class="text-blue-800 font-bold"><span id="resultsCount">{articles.length + (featuredArticle ? 1 : 0)}</span> articles found</span>
        </div>
      </div>

      <!-- Enhanced Featured Article -->
      {featuredArticle ? (
