  // Load Chart.js library
  function loadChartJS() {
    return new Promise((resolve, reject) => {
      if (window.Chart) {
        resolve(window.Chart);
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
      script.onload = () => resolve(window.Chart);
      script.onerror = () => reject(new Error('Failed to load Chart.js'));
      document.head.appendChild(script);
    });
  }

  // Calculate project statistics
  function calculateProjectStatistics(projects) {
    const stats = {
      total: projects.length,
      notStarted: 0,
      ongoing: 0,
      delayed: 0,
      completed: 0,
      totalDepartments: 0,
      totalBudget: 0,
      averageProgress: 0,
      byCategory: {},
      byPriority: {},
      byDepartment: {},
      byLocation: {},
      progressDistribution: { zero: 0, low: 0, medium: 0, high: 0, complete: 0 }
    };

    const departments = new Set();
    let totalProgress = 0;
    let projectsWithProgress = 0;

    projects.forEach(project => {
      const status = (project.status || '').toLowerCase();
      
      // Count statuses (Delayed is also counted as Ongoing)
      if (status === 'not started' || status === 'not_started' || status === 'pending') {
        stats.notStarted++;
      } else if (status === 'completed' || status === 'done' || status === 'finished') {
        stats.completed++;
      } else if (status === 'delayed') {
        stats.delayed++;
        stats.ongoing++; // Delayed projects are also ongoing
      } else if (status === 'ongoing' || status === 'in_progress' || status === 'active' || !status) {
        stats.ongoing++;
      }

      // Count departments
      const dept = project.implementingUnitName || project.implementingOfficeName || project.department;
      if (dept) {
        departments.add(dept);
        stats.byDepartment[dept] = (stats.byDepartment[dept] || 0) + 1;
      }

      // Count categories
      const category = project.category || 'Uncategorized';
      stats.byCategory[category] = (stats.byCategory[category] || 0) + 1;

      // Count priorities
      const priority = project.priority || 'Not Specified';
      stats.byPriority[priority] = (stats.byPriority[priority] || 0) + 1;

      // Count locations
      const location = project.location || project.barangay || 'Not Specified';
      stats.byLocation[location] = (stats.byLocation[location] || 0) + 1;

      // Calculate budget
      const budget = Number(project.budget || project.totalBudget || 0);
      if (!isNaN(budget)) {
        stats.totalBudget += budget;
      }

      // Calculate progress
      const progress = Number(project.progress || 0);
      if (!isNaN(progress) && progress !== null && progress !== undefined) {
        totalProgress += progress;
        projectsWithProgress++;
        
        if (progress === 0) {
          stats.progressDistribution.zero++;
        } else if (progress > 0 && progress < 50) {
          stats.progressDistribution.low++;
        } else if (progress >= 50 && progress < 75) {
          stats.progressDistribution.medium++;
        } else if (progress >= 75 && progress < 100) {
          stats.progressDistribution.high++;
        } else if (progress >= 100) {
          stats.progressDistribution.complete++;
        }
      }
    });

    stats.totalDepartments = departments.size;
    stats.averageProgress = projectsWithProgress > 0 
      ? Math.round(totalProgress / projectsWithProgress) 
      : 0;

    return stats;
  }

  // Load and render project statistics
  async function loadProjectStatistics() {
    const loadingEl = document.getElementById('projectStatisticsLoading');
    const contentEl = document.getElementById('projectStatisticsContent');
    
    if (loadingEl) loadingEl.classList.remove('hidden');
    if (contentEl) contentEl.classList.add('hidden');

    try {
      // Load Chart.js
      const Chart = await loadChartJS();

      // Get projects data
      let projects = window.projectsData || [];
      
      console.log('Loading statistics with', projects.length, 'projects');
      
      // If no projects data, try to fetch directly from API
      if (projects.length === 0) {
        console.log('No projects in window.projectsData, attempting to fetch from API...');
        try {
          const getApiUrl = () => {
            const hostname = window.location.hostname;
            const protocol = window.location.protocol;
            if (hostname === 'localhost' || hostname === '127.0.0.1') {
              return 'http://localhost:3000/api';
            }
            if (hostname.includes('build-watch.com')) {
              if (protocol === 'https:') {
                return protocol + '//' + hostname + '/api';
              } else {
                return 'http://' + hostname + ':3000/api';
              }
            }
            return 'http://localhost:3000/api';
          };
          
          const apiUrl = getApiUrl();
          const response = await fetch(`${apiUrl}/projects/public?page=1&limit=1000`);
          const data = await response.json();
          
          if (data.success && data.projects) {
            projects = data.projects.map(project => ({
              id: project.id,
              name: project.name,
              code: project.projectCode,
              location: project.location,
              implementingUnitName: project.implementingOfficeName,
              implementingOfficeName: project.implementingOfficeName,
              department: project.implementingOfficeName,
              budget: project.totalBudget,
              totalBudget: project.totalBudget,
              status: project.status,
              progress: project.progress?.overall || project.progress?.overallProgress || project.overallProgress || 0,
              startDate: project.startDate,
              endDate: project.endDate,
              category: project.category,
              priority: project.priority,
              fundingSource: project.fundingSource,
              description: project.description,
              barangay: project.barangay,
              hasExternalPartner: project.hasExternalPartner,
              eiuPersonnelName: project.eiuPersonnelName,
              createdAt: project.createdAt,
              updatedAt: project.updatedAt
            }));
            window.projectsData = projects;
            console.log('Fetched', projects.length, 'projects from API');
          }
        } catch (fetchError) {
          console.error('Error fetching projects from API:', fetchError);
        }
      }

      if (projects.length === 0) {
        throw new Error('No projects data available');
      }

      // Calculate statistics
      const stats = calculateProjectStatistics(projects);
      console.log('Calculated statistics:', stats);

      // Render charts
      await renderProjectStatisticsCharts(Chart, stats);

      if (loadingEl) loadingEl.classList.add('hidden');
      if (contentEl) contentEl.classList.remove('hidden');
    } catch (error) {
      console.error('Error loading project statistics:', error);
      if (loadingEl) loadingEl.classList.add('hidden');
      if (contentEl) {
        contentEl.innerHTML = `
          <div class="text-center py-12">
            <p class="text-red-600 font-semibold">Failed to load statistics: ${error.message}</p>
            <p class="text-gray-600 mt-2 text-sm">Please refresh the page and try again.</p>
          </div>
        `;
        contentEl.classList.remove('hidden');
      }
    }
  }

  // Render all project statistics charts
  async function renderProjectStatisticsCharts(Chart, stats) {
    // Destroy existing charts
    if (window.projectStatisticsCharts) {
      Object.values(window.projectStatisticsCharts).forEach(chart => {
        if (chart && typeof chart.destroy === 'function') {
          chart.destroy();
        }
      });
    }
    window.projectStatisticsCharts = {};

    // Chart colors
    const colors = {
      notStarted: '#9CA3AF',
      ongoing: '#3B82F6',
      delayed: '#EF4444',
      completed: '#10B981',
      primary: '#3B82F6',
      secondary: '#8B5CF6',
      success: '#10B981',
      warning: '#F59E0B',
      danger: '#EF4444'
    };

    // 1. Project Status Distribution (Pie Chart)
    const statusCtx = document.getElementById('projectStatusChart');
    if (statusCtx) {
      window.projectStatisticsCharts.status = new Chart(statusCtx, {
        type: 'pie',
        data: {
          labels: ['Not Started', 'Ongoing', 'Delayed', 'Completed'],
          datasets: [{
            data: [stats.notStarted, stats.ongoing, stats.delayed, stats.completed],
            backgroundColor: [colors.notStarted, colors.ongoing, colors.delayed, colors.completed],
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                label: function(context) {
                  const label = context.label || '';
                  const value = context.parsed || 0;
                  const total = context.dataset.data.reduce((a, b) => a + b, 0);
                  const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                  return `${label}: ${value} (${percentage}%)`;
                }
              }
            }
          }
        }
      });
    }

    // 2. Projects by Category (Bar Chart)
    const categoryCtx = document.getElementById('projectCategoryChart');
    if (categoryCtx) {
      const categoryData = Object.entries(stats.byCategory)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 10);
      
      window.projectStatisticsCharts.category = new Chart(categoryCtx, {
        type: 'bar',
        data: {
          labels: categoryData.map(([name]) => name),
          datasets: [{
            label: 'Projects',
            data: categoryData.map(([, count]) => count),
            backgroundColor: colors.primary,
            borderRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 } }
          }
        }
      });
    }

    // 3. Projects by Priority (Doughnut Chart)
    const priorityCtx = document.getElementById('projectPriorityChart');
    if (priorityCtx) {
      const priorityData = Object.entries(stats.byPriority);
      const priorityColors = {
        'High': colors.danger,
        'Medium': colors.warning,
        'Low': colors.success,
        'Not Specified': colors.notStarted
      };
      
      window.projectStatisticsCharts.priority = new Chart(priorityCtx, {
        type: 'doughnut',
        data: {
          labels: priorityData.map(([name]) => name),
          datasets: [{
            data: priorityData.map(([, count]) => count),
            backgroundColor: priorityData.map(([name]) => 
              priorityColors[name] || colors.primary
            ),
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' }
          }
        }
      });
    }

    // 4. Projects by Department (Horizontal Bar Chart)
    const deptCtx = document.getElementById('projectDepartmentChart');
    if (deptCtx) {
      const deptData = Object.entries(stats.byDepartment)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 10);
      
      window.projectStatisticsCharts.department = new Chart(deptCtx, {
        type: 'bar',
        data: {
          labels: deptData.map(([name]) => name),
          datasets: [{
            label: 'Projects',
            data: deptData.map(([, count]) => count),
            backgroundColor: colors.secondary,
            borderRadius: 8
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: { beginAtZero: true, ticks: { stepSize: 1 } }
          }
        }
      });
    }

    // 5. Progress Distribution (Bar Chart)
    const progressCtx = document.getElementById('projectProgressChart');
    if (progressCtx) {
      window.projectStatisticsCharts.progress = new Chart(progressCtx, {
        type: 'bar',
        data: {
          labels: ['0%', '1-49%', '50-74%', '75-99%', '100%'],
          datasets: [{
            label: 'Projects',
            data: [
              stats.progressDistribution.zero,
              stats.progressDistribution.low,
              stats.progressDistribution.medium,
              stats.progressDistribution.high,
              stats.progressDistribution.complete
            ],
            backgroundColor: [
              colors.notStarted,
              colors.warning,
              colors.primary,
              colors.success,
              colors.completed
            ],
            borderRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 } }
          }
        }
      });
    }

    // 6. Budget Overview (Line Chart)
    const budgetCtx = document.getElementById('projectBudgetChart');
    if (budgetCtx) {
      const budgetRanges = [
        { label: '0-100K', min: 0, max: 100000 },
        { label: '100K-500K', min: 100000, max: 500000 },
        { label: '500K-1M', min: 500000, max: 1000000 },
        { label: '1M-5M', min: 1000000, max: 5000000 },
        { label: '5M+', min: 5000000, max: Infinity }
      ];
      
      const budgetCounts = budgetRanges.map(range => {
        return window.projectsData.filter(p => {
          const budget = Number(p.budget || p.totalBudget || 0);
          return budget >= range.min && budget < range.max;
        }).length;
      });

      window.projectStatisticsCharts.budget = new Chart(budgetCtx, {
        type: 'line',
        data: {
          labels: budgetRanges.map(r => r.label),
          datasets: [{
            label: 'Projects',
            data: budgetCounts,
            borderColor: colors.primary,
            backgroundColor: colors.primary + '20',
            fill: true,
            tension: 0.4,
            pointRadius: 6,
            pointBackgroundColor: colors.primary
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 } }
          }
        }
      });
    }

    // Update summary statistics
    document.getElementById('stat-total-projects').textContent = stats.total;
    document.getElementById('stat-total-departments').textContent = stats.totalDepartments;
    document.getElementById('stat-ongoing-projects').textContent = stats.ongoing;
    document.getElementById('stat-delayed-projects').textContent = stats.delayed;
    document.getElementById('stat-completed-projects').textContent = stats.completed;
    document.getElementById('stat-not-started-projects').textContent = stats.notStarted;
    document.getElementById('stat-avg-progress').textContent = stats.averageProgress + '%';
    document.getElementById('stat-total-budget').textContent = new Intl.NumberFormat('en-PH', {
      style: 'currency',
      currency: 'PHP',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    }).format(stats.totalBudget);
  }
</script>

