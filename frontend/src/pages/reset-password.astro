---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Reset Password | Build Watch Portal">
  <div class="min-h-screen w-full flex items-center justify-center font-[Montserrat] relative" style="background-image: url('/about-page-bg.png'); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <!-- Blue overlay to blend with the background image -->
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10, 69, 224, 0.95) 0%, rgba(8, 52, 168, 0.9) 25%, rgba(10, 69, 224, 0.85) 50%, rgba(12, 86, 240, 0.8) 75%, rgba(15, 103, 255, 0.75) 100%);"></div>
    
    <!-- Reset Password Form -->
    <div class="w-full max-w-md flex items-center justify-center p-4 sm:p-6 bg-transparent animate-slide-in-right relative z-10">
      <div class="w-full max-w-md rounded-[32px] shadow-2xl border border-white/30 p-8 sm:p-10 flex flex-col items-center animate-fade-in-up relative z-10"
        style="background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(60px) saturate(200%) brightness(110%); box-shadow: 0 30px 60px 0 rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(255, 255, 255, 0.15), inset 0.06px 0 rgba(255, 255, 255, 0.2); animation-delay: 0.3s;">
        <div class="flex flex-col items-center w-full">
          <img src="/login-logo.png" alt="Build Watch Logo" class="h-32 w-auto mb-6 animate-fade-in-up" style="animation-delay: 0.5s;" />
          <h2 class="text-3xl font-extrabold text-[#fff] mb-3 tracking-wide animate-fade-in-up" style="animation-delay: 0.7s;">RESET PASSWORD</h2>
          <p class="text-base text-white/90 mb-8 text-center animate-fade-in-up" style="animation-delay: 0.9s;">
            Enter your new password below
          </p>
          <hr class="w-full border-t border-white/30 mb-8 animate-fade-in-up" style="animation-delay: 1.1s;" />
          
          <!-- Loading State -->
          <div id="loadingState" class="hidden w-full flex flex-col items-center justify-center py-8">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-white mb-4"></div>
            <p class="text-white/90">Verifying reset token...</p>
          </div>
          
          <!-- Error State -->
          <div id="errorState" class="hidden w-full">
            <div class="bg-red-500/20 border border-red-500/50 text-red-200 px-4 py-3 rounded-lg text-sm font-medium mb-4">
              <p id="errorMessage"></p>
            </div>
            <a href="/login/lgu-pmt" class="block text-center text-white/80 hover:text-white underline transition-colors duration-200">
              Back to Login
            </a>
          </div>
          
          <!-- Reset Password Form -->
          <form id="resetPasswordForm" class="hidden w-full flex flex-col gap-6 animate-fade-in-up" style="animation-delay: 1.3s;">
            <div id="resetPasswordMessage" class="hidden bg-red-500/20 border border-red-500/50 text-red-200 px-4 py-3 rounded-lg text-sm font-medium"></div>
            
            <div class="animate-fade-in-up" style="animation-delay: 1.4s;">
              <label for="resetUserId" class="block text-sm font-bold text-[#fff] mb-2">Unique User ID</label>
              <input 
                type="text" 
                id="resetUserId" 
                name="userId" 
                required 
                class="w-full px-4 py-3 rounded-xl bg-white/90 text-blue-600 font-semibold border-2 border-transparent focus:ring-2 focus:ring-blue-600 focus:border-blue-600 placeholder:text-blue-600/60 transition-all duration-200 uppercase" 
                placeholder="Enter your Unique User ID (e.g., LGU-PMT-0001)" 
                style="text-transform: uppercase;"
              />
              <p class="text-xs text-white/70 mt-1">Please verify your Unique User ID</p>
            </div>
            
            <div class="animate-fade-in-up" style="animation-delay: 1.5s;">
              <label for="newPassword" class="block text-sm font-bold text-[#fff] mb-2">New Password</label>
              <div class="relative">
                <input 
                  type="password" 
                  id="newPassword" 
                  name="newPassword" 
                  required 
                  minlength="12"
                  class="w-full px-4 py-3 pr-12 rounded-xl bg-white/90 text-blue-600 font-semibold border-2 border-transparent focus:ring-2 focus:ring-blue-600 focus:border-blue-600 placeholder:text-blue-600/60 transition-all duration-200" 
                  placeholder="Enter your new password" 
                />
                <button 
                  type="button" 
                  id="newPasswordToggle" 
                  class="absolute right-3 top-1/2 transform -translate-y-1/2 text-blue-600 hover:text-blue-800 transition-colors duration-200 focus:outline-none p-1 rounded"
                >
                  <svg id="newEyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  <svg id="newEyeSlashIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"></path>
                  </svg>
                </button>
              </div>
              <div id="newPasswordError" class="text-red-300 text-xs mt-1 hidden"></div>
              
              <!-- Password Strength Indicator -->
              <div class="space-y-3 mt-3">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-white/90 font-medium">Password Strength</span>
                  <span id="strengthText" class="font-semibold text-red-400">Weak</span>
                </div>
                <div class="w-full bg-white/20 rounded-full h-3 overflow-hidden">
                  <div id="strengthBar" class="h-3 rounded-full transition-all duration-500 ease-out" style="width: 0%; background: linear-gradient(90deg, #ef4444 0%, #f97316 50%, #22c55e 100%);"></div>
                </div>
                <div class="space-y-2">
                  <div class="flex items-center gap-2">
                    <div id="lengthCheck" class="w-4 h-4 rounded-full border-2 border-white/40 flex items-center justify-center transition-all duration-300">
                      <svg class="w-2.5 h-2.5 text-white opacity-0 transition-opacity duration-300" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <span class="text-sm text-white/80">At least 12 characters</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <div id="caseCheck" class="w-4 h-4 rounded-full border-2 border-white/40 flex items-center justify-center transition-all duration-300">
                      <svg class="w-2.5 h-2.5 text-white opacity-0 transition-opacity duration-300" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <span class="text-sm text-white/80">Uppercase & lowercase</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <div id="numberCheck" class="w-4 h-4 rounded-full border-2 border-white/40 flex items-center justify-center transition-all duration-300">
                      <svg class="w-2.5 h-2.5 text-white opacity-0 transition-opacity duration-300" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <span class="text-sm text-white/80">Contains number</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <div id="specialCheck" class="w-4 h-4 rounded-full border-2 border-white/40 flex items-center justify-center transition-all duration-300">
                      <svg class="w-2.5 h-2.5 text-white opacity-0 transition-opacity duration-300" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <span class="text-sm text-white/80">Contains special character</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <div id="strengthCheck" class="w-4 h-4 rounded-full border-2 border-white/40 flex items-center justify-center transition-all duration-300">
                      <svg class="w-2.5 h-2.5 text-white opacity-0 transition-opacity duration-300" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <span class="text-sm text-white/80">Medium strength minimum</span>
                  </div>
                </div>
              </div>
              
              <div class="text-xs text-white/60 mt-4 mb-2 leading-relaxed">Password must be at least 12 characters, include uppercase & lowercase letters, numbers, and special characters. Minimum strength: Medium.</div>
            </div>
            
            <div class="animate-fade-in-up" style="animation-delay: 1.5s;">
              <label for="confirmPassword" class="block text-sm font-bold text-[#fff] mb-2">Confirm New Password</label>
              <div class="relative">
                <input 
                  type="password" 
                  id="confirmPassword" 
                  name="confirmPassword" 
                  required 
                  minlength="12"
                  disabled
                  class="w-full px-4 py-3 pr-12 rounded-xl bg-white/90 text-blue-600 font-semibold border-2 border-transparent focus:ring-2 focus:ring-blue-600 focus:border-blue-600 placeholder:text-blue-600/60 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed" 
                  placeholder="Confirm your new password" 
                />
                <button 
                  type="button" 
                  id="confirmPasswordToggle" 
                  class="absolute right-3 top-1/2 transform -translate-y-1/2 text-blue-600 hover:text-blue-800 transition-colors duration-200 focus:outline-none p-1 rounded"
                >
                  <svg id="confirmEyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  <svg id="confirmEyeSlashIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"></path>
                  </svg>
                </button>
              </div>
              <div id="confirmPasswordError" class="text-red-300 text-xs mt-1 hidden"></div>
            </div>
            
            <button 
              type="submit" 
              id="resetPasswordBtn" 
              class="w-full mt-6 py-3.5 rounded-xl bg-blue-600 text-white font-extrabold text-lg shadow-lg hover:bg-blue-800 transition-all duration-300 transform hover:scale-[1.02] animate-fade-in-up" 
              style="animation-delay: 1.7s;"
            >
              RESET PASSWORD
            </button>
          </form>
          
          <!-- Success State -->
          <div id="successState" class="hidden w-full flex flex-col items-center">
            <div class="bg-green-500/20 border border-green-500/50 text-green-200 px-4 py-3 rounded-lg text-sm font-medium mb-4 text-center">
              <p>Password has been reset successfully!</p>
            </div>
            <a 
              href="/login/lgu-pmt" 
              class="w-full mt-4 py-3.5 rounded-xl bg-blue-600 text-white font-extrabold text-lg shadow-lg hover:bg-blue-800 transition-all duration-300 transform hover:scale-[1.02] text-center"
            >
              GO TO LOGIN
            </a>
          </div>
          
          <!-- Back to Login Button -->
          <div class="w-full mt-8 pt-6 border-t border-white/20 animate-fade-in-up" style="animation-delay: 1.8s;">
            <a 
              href="/login/lgu-pmt" 
              class="group flex items-center justify-center gap-3 w-full px-4 py-3 rounded-xl bg-white/10 backdrop-blur-sm text-white font-medium text-sm hover:bg-white/20 transition-all duration-300 border border-white/20 hover:border-white/40 hover:shadow-lg hover:shadow-white/10 transform hover:scale-[1.02]"
            >
              <svg class="w-4 h-4 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
              <span>Back to Login</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Global API URL helper function - works for both localhost and production
    window.getApiUrl = function() {
      const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
      return isProd 
        ? `${window.location.protocol}//${window.location.hostname}/api`
        : 'http://localhost:3000/api';
    };
    document.addEventListener('DOMContentLoaded', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const token = urlParams.get('token');
      
      const loadingState = document.getElementById('loadingState');
      const errorState = document.getElementById('errorState');
      const resetPasswordForm = document.getElementById('resetPasswordForm');
      const successState = document.getElementById('successState');
      const errorMessage = document.getElementById('errorMessage');
      const resetPasswordMessage = document.getElementById('resetPasswordMessage');
      const resetPasswordBtn = document.getElementById('resetPasswordBtn');
      const resetUserIdInput = document.getElementById('resetUserId');
      const newPasswordInput = document.getElementById('newPassword');
      const confirmPasswordInput = document.getElementById('confirmPassword');
      const newPasswordToggle = document.getElementById('newPasswordToggle');
      const confirmPasswordToggle = document.getElementById('confirmPasswordToggle');
      const newEyeIcon = document.getElementById('newEyeIcon');
      const newEyeSlashIcon = document.getElementById('newEyeSlashIcon');
      const confirmEyeIcon = document.getElementById('confirmEyeIcon');
      const confirmEyeSlashIcon = document.getElementById('confirmEyeSlashIcon');
      const newPasswordError = document.getElementById('newPasswordError');
      const confirmPasswordError = document.getElementById('confirmPasswordError');
      const strengthText = document.getElementById('strengthText');
      const strengthBar = document.getElementById('strengthBar');
      const lengthCheck = document.getElementById('lengthCheck');
      const caseCheck = document.getElementById('caseCheck');
      const numberCheck = document.getElementById('numberCheck');
      const specialCheck = document.getElementById('specialCheck');
      const strengthCheck = document.getElementById('strengthCheck');
      
      // Password validation function (same as Add New User modal)
      function validatePassword(password) {
        const checks = {
          length: password.length >= 12,
          case: /[a-z]/.test(password) && /[A-Z]/.test(password),
          number: /[0-9]/.test(password),
          special: /[^a-zA-Z0-9]/.test(password) // All special characters (anything that's not alphanumeric)
        };
        
        // Calculate strength score
        let score = 0;
        if (checks.length) score += 30;
        if (checks.case) score += 25;
        if (checks.number) score += 20;
        if (checks.special) score += 25;
        
        // Determine strength level
        let strength = 'Weak';
        let color = '#ef4444'; // red
        
        if (score >= 90) {
          strength = 'Very Strong';
          color = '#059669'; // emerald
        } else if (score >= 70) {
          strength = 'Strong';
          color = '#10b981'; // green
        } else if (score >= 50) {
          strength = 'Medium';
          color = '#f59e0b'; // amber
        } else {
          strength = 'Weak';
          color = '#ef4444'; // red
        }
        
        // Update UI
        strengthText.textContent = strength;
        strengthText.className = 'font-semibold';
        
        // Set text color based on strength
        if (strength === 'Very Strong') {
          strengthText.classList.add('text-emerald-400');
          strengthText.classList.remove('text-green-400', 'text-yellow-400', 'text-red-400');
        } else if (strength === 'Strong') {
          strengthText.classList.add('text-green-400');
          strengthText.classList.remove('text-emerald-400', 'text-yellow-400', 'text-red-400');
        } else if (strength === 'Medium') {
          strengthText.classList.add('text-yellow-400');
          strengthText.classList.remove('text-emerald-400', 'text-green-400', 'text-red-400');
        } else {
          strengthText.classList.add('text-red-400');
          strengthText.classList.remove('text-emerald-400', 'text-green-400', 'text-yellow-400');
        }
        
        strengthBar.style.width = score + '%';
        strengthBar.style.backgroundColor = color;
        
        // Update checkmarks
        const lengthCheckElement = lengthCheck.querySelector('svg');
        const caseCheckElement = caseCheck.querySelector('svg');
        const numberCheckElement = numberCheck.querySelector('svg');
        const specialCheckElement = specialCheck.querySelector('svg');
        const strengthCheckElement = strengthCheck.querySelector('svg');
        
        if (checks.length) {
          lengthCheck.style.backgroundColor = '#22c55e';
          lengthCheck.style.borderColor = '#22c55e';
          lengthCheckElement.style.opacity = '1';
        } else {
          lengthCheck.style.backgroundColor = 'transparent';
          lengthCheck.style.borderColor = 'rgba(255, 255, 255, 0.4)';
          lengthCheckElement.style.opacity = '0';
        }
        
        if (checks.case) {
          caseCheck.style.backgroundColor = '#22c55e';
          caseCheck.style.borderColor = '#22c55e';
          caseCheckElement.style.opacity = '1';
        } else {
          caseCheck.style.backgroundColor = 'transparent';
          caseCheck.style.borderColor = 'rgba(255, 255, 255, 0.4)';
          caseCheckElement.style.opacity = '0';
        }
        
        if (checks.number) {
          numberCheck.style.backgroundColor = '#22c55e';
          numberCheck.style.borderColor = '#22c55e';
          numberCheckElement.style.opacity = '1';
        } else {
          numberCheck.style.backgroundColor = 'transparent';
          numberCheck.style.borderColor = 'rgba(255, 255, 255, 0.4)';
          numberCheckElement.style.opacity = '0';
        }
        
        if (checks.special) {
          specialCheck.style.backgroundColor = '#22c55e';
          specialCheck.style.borderColor = '#22c55e';
          specialCheckElement.style.opacity = '1';
        } else {
          specialCheck.style.backgroundColor = 'transparent';
          specialCheck.style.borderColor = 'rgba(255, 255, 255, 0.4)';
          specialCheckElement.style.opacity = '0';
        }
        
        if (score >= 50) {
          strengthCheck.style.backgroundColor = '#22c55e';
          strengthCheck.style.borderColor = '#22c55e';
          strengthCheckElement.style.opacity = '1';
        } else {
          strengthCheck.style.backgroundColor = 'transparent';
          strengthCheck.style.borderColor = 'rgba(255, 255, 255, 0.4)';
          strengthCheckElement.style.opacity = '0';
        }
        
        return score >= 50;
      }
      
      // Password field event listeners
      newPasswordInput.addEventListener('input', function() {
        const isValid = validatePassword(this.value);
        confirmPasswordInput.disabled = !isValid;
        
        if (confirmPasswordInput.value && this.value !== confirmPasswordInput.value) {
          confirmPasswordError.textContent = 'Passwords do not match';
          confirmPasswordError.classList.remove('hidden');
        } else {
          confirmPasswordError.classList.add('hidden');
        }
        
        if (this.value && !isValid) {
          newPasswordError.textContent = 'Password must meet all requirements';
          newPasswordError.classList.remove('hidden');
        } else {
          newPasswordError.classList.add('hidden');
        }
      });
      
      confirmPasswordInput.addEventListener('input', function() {
        if (this.value !== newPasswordInput.value) {
          confirmPasswordError.textContent = 'Passwords do not match';
          confirmPasswordError.classList.remove('hidden');
        } else {
          confirmPasswordError.classList.add('hidden');
        }
      });
      
      // Password visibility toggles
      newPasswordToggle.addEventListener('click', function() {
        const type = newPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        newPasswordInput.setAttribute('type', type);
        if (type === 'text') {
          newEyeIcon.classList.add('hidden');
          newEyeSlashIcon.classList.remove('hidden');
        } else {
          newEyeIcon.classList.remove('hidden');
          newEyeSlashIcon.classList.add('hidden');
        }
      });
      
      confirmPasswordToggle.addEventListener('click', function() {
        const type = confirmPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        confirmPasswordInput.setAttribute('type', type);
        if (type === 'text') {
          confirmEyeIcon.classList.add('hidden');
          confirmEyeSlashIcon.classList.remove('hidden');
        } else {
          confirmEyeIcon.classList.remove('hidden');
          confirmEyeSlashIcon.classList.add('hidden');
        }
      });
      
      // Verify token on page load
      if (!token) {
        showError('Invalid reset link. Please request a new password reset.');
        return;
      }
      
      verifyToken(token);
      
      async function verifyToken(token) {
        loadingState.classList.remove('hidden');
        
        try {
          // Use global API URL helper or create one
          const getApiUrl = () => {
            if (window.getApiUrl) {
              return window.getApiUrl();
            }
            const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
            return isProd 
              ? `${window.location.protocol}//${window.location.hostname}/api`
              : 'http://localhost:3000/api';
          };
          const apiUrl = getApiUrl();
          
          const response = await fetch(`${apiUrl}/auth/verify-reset-token?token=${encodeURIComponent(token)}`, {
            method: 'GET',
            headers: {
              'Content-Type': 'application/json'
            }
          });
          
          const data = await response.json();
          
          if (response.ok && data.success) {
            loadingState.classList.add('hidden');
            resetPasswordForm.classList.remove('hidden');
            // Pre-fill userId if provided
            if (data.userId) {
              resetUserIdInput.value = data.userId;
            }
          } else {
            showError(data.error || 'Invalid or expired reset token. Please request a new password reset.');
          }
        } catch (error) {
          console.error('Token verification error:', error);
          showError('An error occurred while verifying the reset token. Please try again.');
        }
      }
      
      function showError(message) {
        loadingState.classList.add('hidden');
        errorState.classList.remove('hidden');
        errorMessage.textContent = message;
      }
      
      // Reset password form submission
      resetPasswordForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const userId = resetUserIdInput.value.trim().toUpperCase();
        const newPassword = newPasswordInput.value;
        const confirmPassword = confirmPasswordInput.value;
        
        // Validation
        if (!userId) {
          showResetPasswordMessage('Please enter your Unique User ID.', 'error');
          return;
        }
        
        // Validate password strength
        const passwordValidation = validatePassword(newPassword);
        if (!passwordValidation) {
          showResetPasswordMessage('Password must meet all requirements: at least 12 characters, include uppercase & lowercase letters, numbers, and special characters. Minimum strength: Medium.', 'error');
          return;
        }
        
        if (newPassword !== confirmPassword) {
          showResetPasswordMessage('Passwords do not match.', 'error');
          return;
        }
        
        // Show loading state
        resetPasswordBtn.disabled = true;
        resetPasswordBtn.textContent = 'Resetting...';
        resetPasswordMessage.classList.add('hidden');
        
        try {
          // Use global API URL helper or create one
          const getApiUrl = () => {
            if (window.getApiUrl) {
              return window.getApiUrl();
            }
            const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
            return isProd 
              ? `${window.location.protocol}//${window.location.hostname}/api`
              : 'http://localhost:3000/api';
          };
          const apiUrl = getApiUrl();
          
          const response = await fetch(`${apiUrl}/auth/reset-password`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ 
              token: token,
              userId: userId,
              newPassword: newPassword,
              confirmPassword: confirmPassword
            })
          });
          
          const data = await response.json();
          
          if (response.ok && data.success) {
            resetPasswordForm.classList.add('hidden');
            successState.classList.remove('hidden');
          } else {
            showResetPasswordMessage(data.error || 'Failed to reset password. Please verify your Unique User ID and try again.', 'error');
            resetPasswordBtn.disabled = false;
            resetPasswordBtn.textContent = 'RESET PASSWORD';
          }
        } catch (error) {
          console.error('Reset password error:', error);
          showResetPasswordMessage('An error occurred. Please try again later.', 'error');
          resetPasswordBtn.disabled = false;
          resetPasswordBtn.textContent = 'RESET PASSWORD';
        }
      });
      
      function showResetPasswordMessage(message, type) {
        resetPasswordMessage.textContent = message;
        resetPasswordMessage.classList.remove('hidden');
        if (type === 'success') {
          resetPasswordMessage.className = 'mb-4 p-3 rounded-lg text-sm bg-green-100 border border-green-400 text-green-700';
        } else {
          resetPasswordMessage.className = 'mb-4 p-3 rounded-lg text-sm bg-red-100 border border-red-400 text-red-700';
        }
      }
    });
  </script>

  <style>
    @keyframes slideInRight {
      from {
        opacity: 0;
        transform: translateX(100px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-slide-in-right {
      animation: slideInRight 1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .animate-fade-in-up {
      animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      opacity: 0;
    }
  </style>
</Layout>

