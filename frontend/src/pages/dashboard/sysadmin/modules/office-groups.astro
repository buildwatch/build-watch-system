      // Load Chart.js and render statistics
      async function showStatistics() {
        const modal = document.getElementById('statisticsModal');
        const loadingEl = document.getElementById('departmentStatisticsLoading');
        const contentEl = document.getElementById('statisticsContent');
        
        if (!modal || !loadingEl || !contentEl) return;
        
        // Show modal and loading
        modal.classList.remove('hidden');
        loadingEl.classList.remove('hidden');
        contentEl.style.display = 'none';
        
        try {
          // Load Chart.js dynamically
          if (typeof Chart === 'undefined') {
            await new Promise((resolve, reject) => {
              const script = document.createElement('script');
              script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
              script.onload = resolve;
              script.onerror = () => reject(new Error('Failed to load Chart.js'));
              document.head.appendChild(script);
            });
          }
          
          // Process data and render charts
          await renderDepartmentStatistics();
          
          // Hide loading, show content
          loadingEl.classList.add('hidden');
          contentEl.style.display = 'block';
        } catch (error) {
          console.error('Error loading statistics:', error);
          loadingEl.classList.add('hidden');
          contentEl.innerHTML = `
            <div class="text-center py-12">
              <p class="text-red-500">Failed to load statistics. Please try again.</p>
            </div>
          `;
        }
      }

      async function renderDepartmentStatistics() {
        const { departments, groups, users } = window.officeGroupsData;
        const timeRange = document.getElementById('departmentStatisticsTimeRange')?.value || 'all';
        
        // Calculate date filter
        const now = new Date();
        let filterDate = null;
        if (timeRange !== 'all') {
          filterDate = new Date(now);
          filterDate.setDate(filterDate.getDate() - parseInt(timeRange));
        }
        
        // Process department data
        const deptStats = departments.map(dept => {
          const deptUsers = users.filter(u => {
            const userDept = u.department || '';
            const matches = userDept === dept.name || userDept === dept.code;
            if (filterDate && matches) {
              const userCreated = u.createdAt ? new Date(u.createdAt) : null;
              return !userCreated || userCreated >= filterDate;
            }
            return matches;
          });
          
          const activeUsers = deptUsers.filter(u => u.isActive === true).length;
          const deptUserGroups = new Set();
          deptUsers.forEach(user => {
            if (user.group && user.group.trim() !== '') {
              deptUserGroups.add(user.group.trim());
            }
          });
          
          return {
            name: dept.name,
            code: dept.code,
            totalUsers: deptUsers.length,
            activeUsers: activeUsers,
            inactiveUsers: deptUsers.length - activeUsers,
            groups: Array.from(deptUserGroups),
            hasActiveUsers: activeUsers > 0,
            createdAt: dept.createdAt
          };
        });
        
        // Render all charts
        renderDepartmentGrowthChart(deptStats, filterDate);
        renderUserDistributionChart(deptStats);
        renderActiveInactiveChart(deptStats);
        renderGroupDistributionChart(deptStats);
        renderTopDepartmentsChart(deptStats);
        renderActivityLevelsChart(deptStats);
        renderSizeDistributionChart(deptStats);
        renderUserGroupChart(users);
        renderActivityHeatmapChart(deptStats);
        renderAssignmentTrendsChart(users, filterDate);
      }

      function renderDepartmentGrowthChart(deptStats, filterDate) {
        const ctx = document.getElementById('departmentGrowthChart');
        if (!ctx) return;
        
        // Destroy existing chart
        if (window.departmentStatisticsCharts.growth) {
          window.departmentStatisticsCharts.growth.destroy();
        }
        
        // Group by creation date
        const growthData = {};
        deptStats.forEach(dept => {
          if (dept.createdAt) {
            const date = new Date(dept.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            growthData[date] = (growthData[date] || 0) + 1;
          }
        });
        
        const sortedDates = Object.keys(growthData).sort((a, b) => new Date(a) - new Date(b));
        const cumulative = [];
        let total = 0;
        sortedDates.forEach(date => {
          total += growthData[date];
          cumulative.push(total);
        });
        
        window.departmentStatisticsCharts.growth = new Chart(ctx, {
          type: 'line',
          data: {
            labels: sortedDates,
            datasets: [{
              label: 'Total Departments',
              data: cumulative,
              borderColor: 'rgb(59, 130, 246)',
              backgroundColor: 'rgba(59, 130, 246, 0.1)',
              tension: 0.4,
              fill: true
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: true, position: 'top' }
            },
            scales: {
              y: { beginAtZero: true, ticks: { stepSize: 1 } }
            }
          }
        });
      }

