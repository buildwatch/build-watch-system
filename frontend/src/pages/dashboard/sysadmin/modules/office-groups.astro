        if (!ctx) return;
        
        if (window.departmentStatisticsCharts.userDistribution) {
          window.departmentStatisticsCharts.userDistribution.destroy();
        }
        
        const sorted = [...deptStats].sort((a, b) => b.totalUsers - a.totalUsers).slice(0, 10);
        
        window.departmentStatisticsCharts.userDistribution = new Chart(ctx, {
