      // HTML escape function
      function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      // JavaScript string escape function for use in onclick attributes
      function escapeJsString(str) {
        if (!str) return '';
        return String(str)
          .replace(/\\/g, '\\\\')
          .replace(/'/g, "\\'")
          .replace(/"/g, '\\"')
          .replace(/\n/g, '\\n')
          .replace(/\r/g, '\\r')
          .replace(/\t/g, '\\t');
      }

      // Get department logo based on department name
      function getDepartmentLogo(deptName) {
        const name = deptName.toLowerCase();
        
        if (name.includes('agriculturist') || name.includes('agricultur')) {
          return '/mao-logo.jfif';
        } else if (name.includes('disaster') || name.includes('risk reduction') || name.includes('mdrrmo')) {
          return '/mdrrmo-logo.jfif';
        } else if (name.includes('environment') || name.includes('natural resources') || name.includes('menro')) {
          return '/menro-logo.jfif';
        } else if (name.includes('engineer') || name.includes('engineering')) {
          return '/meo-logo.jfif';
        } else if (name.includes('social welfare') || name.includes('welfare') || name.includes('mswdo')) {
          return '/mswdo-logo.jfif';
        } else if (name.includes('planning') || name.includes('development') || name.includes('mpado')) {
          return '/mpado_logo.png';
        } else {
          // Default logo for departments without specific logos
          return '/santa-cruz-seal.png';
        }
      }



