      async function performBulkAction(action) {
        const type = window.currentBulkType;
        const selected = type === 'departments' ? window.officeGroupsData.selectedDepts : window.officeGroupsData.selectedGroups;
        
        if (selected.length === 0) return;

        showLoading();
        try {
          const token = getToken();
          const apiUrl = getAPIUrl();
          const endpoint = type === 'departments' ? 'departments' : 'groups';

          for (const id of selected) {
            if (action === 'delete') {
              await fetch(`${apiUrl}/${endpoint}/${id}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token}` }
              });
            } else {
              await fetch(`${apiUrl}/${endpoint}/${id}`, {
                method: 'PUT',
             headers: {
                  'Content-Type': 'application/json',
               'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ status: action === 'activate' ? 'active' : 'inactive' })
              });
            }
          }

          showSuccess(`Bulk ${action} completed successfully!`);
          closeBulkActionsModal();
          await fetchAllData();
        } catch (error) {
          console.error('Error performing bulk action:', error);
          alert('Error performing bulk action');
        } finally {
          hideLoading();
        }
      }


