    <!-- Success Modal -->
    <div id="successModal" class="fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm hidden z-[100] items-center justify-center" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100vw; height: 100vh; margin: 0; padding: 0;">
      <div class="bg-white rounded-2xl shadow-2xl p-8 text-center" style="margin: auto; position: relative;">
        <div class="w-20 h-20 mx-auto mb-4 bg-green-100 rounded-full flex items-center justify-center">
          <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <p id="successMessage" class="text-lg font-semibold text-gray-900">Success!</p>
        <button onclick="closeSuccessModal()" class="mt-4 btn-primary">OK</button>
      </div>
    </div>

    <script define:vars={{ API_URL }}>
      // Global state
      window.officeGroupsData = {
        departments: [],
        groups: [],
        users: [],
        selectedDepts: [],
        selectedGroups: [],
        currentTab: 'departments'
      };

      // API URL
      window.API_URL = API_URL || (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' 
        ? 'http://localhost:3000/api/admin' 
        : `${window.location.protocol}//${window.location.hostname}/api/admin`);

      // Immediately hide all modals on page load (before DOM is ready)
      (function() {
        // This runs immediately when the script loads
        setTimeout(function() {
          const loadingModal = document.getElementById('loadingModal');
          const successModal = document.getElementById('successModal');
          
          if (loadingModal) {
            loadingModal.classList.add('hidden');
            loadingModal.classList.remove('flex');
            loadingModal.style.display = 'none';
          }
          
          if (successModal) {
            successModal.classList.add('hidden');
            successModal.classList.remove('flex');
            successModal.style.display = 'none';
          }
        }, 0);
      })();

      // Initialize module
      console.log('Departments & User Groups module initialized');
    </script>

    <script>
      // ==================== COMPREHENSIVE OFFICE GROUPS MANAGEMENT ====================
      
      // Get authentication token
      function getToken() {
        return localStorage.getItem('token') || '';
      }

      // Get API URL
      function getAPIUrl() {
        return window.API_URL || (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' 
          ? 'http://localhost:3000/api/admin' 
          : `${window.location.protocol}//${window.location.hostname}/api/admin`);
      }

      // Show loading modal
      function showLoading() {
        const modal = document.getElementById('loadingModal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      }

      // Hide loading modal
      function hideLoading() {
        const modal = document.getElementById('loadingModal');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      }

      // Show success modal
      function showSuccess(message = 'Operation completed successfully!') {
        const modal = document.getElementById('successModal');
        const messageEl = document.getElementById('successMessage');
        if (messageEl) messageEl.textContent = message;
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      }

      // Close success modal
      window.closeSuccessModal = function() {
        const modal = document.getElementById('successModal');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          modal.style.display = 'none';
        }
      };

      // ==================== DATA FETCHING ====================
      
      // Auto-generate department description based on name
      function generateDepartmentDescription(deptName) {
        const name = deptName.toLowerCase();
        
        // Common department descriptions
        const descriptions = {
          'executive office': 'Oversees executive functions and administrative coordination for the municipality.',
          'external partner company': 'External partner organizations and companies collaborating with the municipality.',
          'information technology': 'Manages information systems, technology infrastructure, and digital services.',
          'municipal agriculturist\'s office': 'Handles agricultural programs, services, and development initiatives for the municipality.',
          'municipal disaster and risk reduction management office': 'Coordinates disaster preparedness, response activities, and risk reduction programs.',
          'municipal engineer\'s office': 'Manages engineering projects, infrastructure development, and public works.',
          'municipal environment and natural resources office': 'Oversees environmental protection, natural resources management, and sustainability programs.',
          'municipal planning and development office': 'Handles urban planning, development projects, and strategic planning initiatives.',
          'municipal social welfare and development office': 'Implements social welfare programs, community development, and social services.',
          'municipal general services office': 'Provides general services, maintenance, and support for municipal facilities and operations.',
          'municipal treasurer\'s office': 'Manages municipal finances, revenue collection, and financial administration.',
          'municipal budget office': 'Handles budget planning, allocation, and financial resource management.',
          'municipal health office': 'Oversees public health services, medical programs, and health initiatives.',
          'municipal civil registry office': 'Manages civil registration, vital records, and official documentation services.'
        };

        // Check for exact match first
        if (descriptions[name]) {
          return descriptions[name];
        }

        // Check for partial matches
        for (const [key, desc] of Object.entries(descriptions)) {
          if (name.includes(key) || key.includes(name)) {
            return desc;
          }
        }

        // Generate description based on keywords
        if (name.includes('agricultur') || name.includes('agriculture')) {
          return 'Handles agricultural programs, services, and development initiatives.';
        } else if (name.includes('disaster') || name.includes('risk reduction') || name.includes('mdrrmo')) {
          return 'Coordinates disaster preparedness, response activities, and risk reduction programs.';
        } else if (name.includes('engineer') || name.includes('engineering')) {
          return 'Manages engineering projects, infrastructure development, and public works.';
        } else if (name.includes('environment') || name.includes('natural resources')) {
          return 'Oversees environmental protection, natural resources management, and sustainability programs.';
        } else if (name.includes('planning') || name.includes('development')) {
          return 'Handles planning, development projects, and strategic initiatives.';
        } else if (name.includes('social welfare') || name.includes('welfare')) {
          return 'Implements social welfare programs, community development, and social services.';
        } else if (name.includes('general services') || name.includes('services')) {
          return 'Provides general services, maintenance, and support for municipal operations.';
        } else if (name.includes('treasurer') || name.includes('treasury')) {
          return 'Manages municipal finances, revenue collection, and financial administration.';
        } else if (name.includes('budget')) {
          return 'Handles budget planning, allocation, and financial resource management.';
        } else if (name.includes('health') || name.includes('medical')) {
          return 'Oversees public health services, medical programs, and health initiatives.';
        } else if (name.includes('civil registry') || name.includes('registry')) {
          return 'Manages civil registration, vital records, and official documentation services.';
        } else if (name.includes('information technology') || name.includes('it') || name.includes('technology')) {
          return 'Manages information systems, technology infrastructure, and digital services.';
        } else if (name.includes('executive') || name.includes('office')) {
          return 'Oversees executive functions and administrative coordination.';
        } else if (name.includes('external') || name.includes('partner') || name.includes('company')) {
          return 'External partner organizations and companies collaborating with the municipality.';
        }

        // Default generic description
        return `Provides services and manages operations for ${deptName}.`;
      }
      
      // Fetch all data
      async function fetchAllData() {
        showLoading();
        try {
          const token = getToken();
          const apiUrl = getAPIUrl();
          
          // Determine users API URL (same as user-management.astro)
          const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
          const usersApiUrl = isLocalhost 
            ? 'http://localhost:3000/api/users' 
            : `${window.location.protocol}//${window.location.hostname}/api/users`;
          
          console.log('🔍 Fetching data from:', usersApiUrl);
          
          // First, fetch users to get complete department list (same as user-management.astro)
          const usersRes = await fetch(`${usersApiUrl}?limit=1000`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (usersRes.ok) {
            const usersData = await usersRes.json();
            let fetchedUsers = (usersData.users || []).filter(u => u.role !== 'SYS.AD' && u.status !== 'deleted');
            
            // Fetch activity status for all users to determine isActive
            const userIds = fetchedUsers.map(u => u.id || u.userId || u.email).filter(Boolean);
            if (userIds.length > 0) {
              try {
                const activityRes = await fetch(`${usersApiUrl}/activity/status`, {
                  method: 'POST',
            headers: { 
              'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                  },
                  body: JSON.stringify({ userIds: userIds })
                });
                
                if (activityRes.ok) {
                  const activityData = await activityRes.json();
                  if (activityData.success && activityData.statusMap) {
                    // Map isActive status to users
                    fetchedUsers = fetchedUsers.map(user => {
                      const identifier = user.id || user.userId || user.email;
                      const status = activityData.statusMap[identifier];
                      return {
                        ...user,
                        isActive: status ? status.isActive : false
                      };
                    });
                    console.log('✅ Fetched activity status for users');
                  }
                }
              } catch (error) {
                console.warn('⚠️ Could not fetch activity status, using fallback:', error);
                // Fallback: calculate isActive based on lastLoginAt and lastLogoutAt
                fetchedUsers = fetchedUsers.map(user => {
                  const lastLogin = user.lastLoginAt ? new Date(user.lastLoginAt) : null;
                  const lastLogout = user.lastLogoutAt ? new Date(user.lastLogoutAt) : null;
                  const isActive = lastLogin && (!lastLogout || lastLogout < lastLogin);
                  return {
                    ...user,
                    isActive: isActive || false
                  };
                });
              }
            }
            
            window.officeGroupsData.users = fetchedUsers;
            console.log('✅ Fetched users:', window.officeGroupsData.users.length);
          } else {
            console.error('❌ Failed to fetch users:', usersRes.status);
          }

          // Fetch departments from users ONLY (complete list - same source as user-management)
          // This is the REAL source of truth - only departments that actually exist in the system
          // Departments are managed through user management, not here
          let departmentsFromUsers = [];
          
          try {
            const deptFromUsersRes = await fetch(`${usersApiUrl}/departments`, {
              headers: { 'Authorization': `Bearer ${token}` }
            });
            
            if (deptFromUsersRes.ok) {
              const deptFromUsersData = await deptFromUsersRes.json();
              if (deptFromUsersData.success && deptFromUsersData.departments) {
                departmentsFromUsers = deptFromUsersData.departments || [];
                console.log('✅ Fetched departments from API:', departmentsFromUsers);
          } else {
                console.warn('⚠️ API response format unexpected:', deptFromUsersData);
              }
            } else {
              console.error('❌ Failed to fetch departments from API. Status:', deptFromUsersRes.status);
              const errorText = await deptFromUsersRes.text();
              console.error('Error response:', errorText);
            }
        } catch (error) {
            console.error('❌ Error fetching departments from API:', error);
          }

          // Fallback: Extract departments directly from users if API fails
          if (departmentsFromUsers.length === 0 && window.officeGroupsData.users.length > 0) {
            console.log('📋 Extracting departments directly from users data...');
            const uniqueDepartments = new Set();
            window.officeGroupsData.users.forEach(user => {
              if (user.department && user.department.trim() !== '') {
                uniqueDepartments.add(user.department.trim());
              }
            });
            departmentsFromUsers = Array.from(uniqueDepartments).sort();
            console.log('✅ Extracted departments from users:', departmentsFromUsers);
          }

          // Build departments list from user data only
          // Each department name from users becomes a department entry
          const departmentsList = [];
          
          departmentsFromUsers.forEach(deptName => {
            if (deptName && deptName.trim()) {
              // Create department entry from user data
              // Generate a simple code from the department name
              const code = deptName
                .split(' ')
                .map(word => word.charAt(0).toUpperCase())
                .join('')
                .substring(0, 10) || deptName.substring(0, 5).toUpperCase().replace(/\s+/g, '');
              
              // Generate description for the department
              const description = generateDepartmentDescription(deptName);
              
              departmentsList.push({
                id: `dept-${deptName.replace(/\s+/g, '-').replace(/'/g, '').toLowerCase()}`,
                name: deptName,
                code: code,
                description: description,
                status: 'active',
                createdAt: new Date().toISOString()
              });
            }
          });

          // Sort by name
          window.officeGroupsData.departments = departmentsList.sort((a, b) => 
            a.name.localeCompare(b.name)
          );
          
          console.log('✅ Final departments list:', window.officeGroupsData.departments);

          // Fetch groups
          const groupRes = await fetch(`${apiUrl}/groups`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (groupRes.ok) {
            const groupData = await groupRes.json();
            window.officeGroupsData.groups = groupData.groups || [];
          }

          updateSummaryCards();
          renderDepartmentsTable();
        } catch (error) {
          console.error('Error fetching data:', error);
        } finally {
          hideLoading();
        }
      }

      // Update summary cards
      function updateSummaryCards() {
        const { departments, groups, users } = window.officeGroupsData;
        
        document.getElementById('totalDepartments').textContent = departments.length;
        
        // Count unique groups from users (only the 4 valid groups: EIU, LGU-PMT, LGU-IU, Admin Office)
        const validGroups = new Set(['EIU', 'LGU-PMT', 'LGU-IU', 'Admin Office']);
        const userGroups = new Set();
        
        users.forEach(user => {
          if (user.group && user.group.trim() !== '') {
            const groupName = user.group.trim();
            // Only count if it's one of the valid groups
            if (validGroups.has(groupName)) {
              userGroups.add(groupName);
            }
          }
        });
        
        // Also check for "Admin Office" in Executive Office and Information Technology departments
        departments.forEach(dept => {
          if (dept.name === 'Executive Office' || dept.name === 'Information Technology') {
            userGroups.add('Admin Office');
          }
        });
        
        const activeGroupsCount = userGroups.size;
        const totalDepartmentsCount = departments.length;
        document.getElementById('activeGroups').textContent = activeGroupsCount;
        document.getElementById('totalUsers').textContent = users.length;
        
        // Update header display
        const headerTotalLabel = document.getElementById('headerTotalLabel');
        const headerActiveGroups = document.getElementById('headerActiveGroups');
        if (headerTotalLabel) {
          headerTotalLabel.textContent = `Total Departments`;
        }
        if (headerActiveGroups) {
          headerActiveGroups.textContent = `${activeGroupsCount} Active Groups`;
        }
        
        // Count unassigned users accurately
        const unassigned = users.filter(u => {
          const hasDept = u.department && u.department.trim() !== '';
          const hasGroup = u.group && u.group.trim() !== '';
          return !hasDept && !hasGroup;
        }).length;
        document.getElementById('unassignedUsers').textContent = unassigned;
      }


      // ==================== DEPARTMENTS MANAGEMENT ====================
      
      // Render departments table
      function renderDepartmentsTable() {
        const { departments, users } = window.officeGroupsData;
        const tbody = document.getElementById('departmentsTableBody');
        if (!tbody) return;

        const search = document.getElementById('deptSearch')?.value.toLowerCase() || '';
        const statusFilter = document.getElementById('deptStatusFilter')?.value || '';
        const sortBy = document.getElementById('deptSortBy')?.value || 'name';

        let filtered = departments.filter(dept => {
          const matchesSearch = !search || 
            dept.name.toLowerCase().includes(search) ||
            dept.code.toLowerCase().includes(search) ||
            (dept.head && dept.head.toLowerCase().includes(search));
          const matchesStatus = !statusFilter || dept.status === statusFilter;
          return matchesSearch && matchesStatus;
        });

        // Sort
        filtered.sort((a, b) => {
          if (sortBy === 'name') return a.name.localeCompare(b.name);
          if (sortBy === 'code') return a.code.localeCompare(b.code);
          if (sortBy === 'createdAt') return new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
          return 0;
        });

        if (filtered.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                <div class="flex flex-col items-center gap-2">
                  <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
                  <p class="text-lg font-medium">No departments found</p>
                  <p class="text-sm text-gray-400">Departments are created automatically when users are assigned to them in User Management</p>
            </div>
              </td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = filtered.map(dept => {
          // Count users accurately - match by exact department name
          const deptUsers = users.filter(u => {
            const userDept = u.department || '';
            return userDept === dept.name || userDept === dept.code;
          });
          
          // Get unique groups from users in this department
          const deptUserGroups = new Set();
          deptUsers.forEach(user => {
            if (user.group && user.group.trim() !== '') {
              deptUserGroups.add(user.group.trim());
            }
          });
          const groupsList = Array.from(deptUserGroups).sort();
          
          // Generate description if not present
          const description = dept.description || generateDepartmentDescription(dept.name);
          
          // Check if department has active users based on session activity (isActive)
          const hasActiveUsers = deptUsers.some(user => user.isActive === true);
          const statusDotColor = hasActiveUsers ? 'bg-green-500' : 'bg-gray-400';
          
          // Get department logo
          const deptLogo = getDepartmentLogo(dept.name);
          
          return `
            <tr class="table-row-hover">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="relative w-10 h-10 flex-shrink-0">
                    <img src="${escapeHtml(deptLogo)}" alt="${escapeHtml(dept.name)}" class="w-10 h-10 rounded-lg object-cover border border-gray-200" onerror="this.onerror=null; this.src='/santa-cruz-seal.png';">
                    <div class="absolute bottom-0 right-0 w-3 h-3 ${statusDotColor} rounded-full border-2 border-white shadow-sm"></div>
                  </div>
                  <div>
                    <div class="font-semibold text-gray-900">${escapeHtml(dept.name)}</div>
                    <div class="text-sm text-gray-500">${escapeHtml(description)}</div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 bg-gray-100 text-gray-800 rounded text-sm font-medium">${escapeHtml(dept.code)}</span>
              </td>
              <td class="px-6 py-4">
