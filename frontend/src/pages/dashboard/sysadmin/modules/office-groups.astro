      function renderActivityHeatmapChart(deptStats) {
        const ctx = document.getElementById('activityHeatmapChart');
        if (!ctx) return;
        
        if (window.departmentStatisticsCharts.activityHeatmap) {
          window.departmentStatisticsCharts.activityHeatmap.destroy();
        }
        
        const sorted = [...deptStats].sort((a, b) => b.activeUsers - a.activeUsers).slice(0, 8);
        
        window.departmentStatisticsCharts.activityHeatmap = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: sorted.map(d => d.name.length > 20 ? d.name.substring(0, 20) + '...' : d.name),
            datasets: [{
              label: 'Active Users',
              data: sorted.map(d => d.activeUsers),
              backgroundColor: sorted.map(d => 
                d.activeUsers > 0 ? 'rgba(16, 185, 129, 0.8)' : 'rgba(156, 163, 175, 0.8)'
              )
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              y: { beginAtZero: true, ticks: { stepSize: 1 } }
            }
          }
        });
      }

      function renderAssignmentTrendsChart(users, filterDate) {
        const ctx = document.getElementById('assignmentTrendsChart');
        if (!ctx) return;
        
        if (window.departmentStatisticsCharts.assignmentTrends) {
          window.departmentStatisticsCharts.assignmentTrends.destroy();
        }
        
        // Group users by creation date
        const trends = {};
        users.forEach(user => {
          if (user.createdAt) {
            const date = new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            if (!filterDate || new Date(user.createdAt) >= filterDate) {
              if (!trends[date]) trends[date] = { assigned: 0, unassigned: 0 };
              const hasDept = user.department && user.department.trim() !== '';
              const hasGroup = user.group && user.group.trim() !== '';
              if (hasDept || hasGroup) {
                trends[date].assigned++;
           } else {
                trends[date].unassigned++;
              }
            }
          }
        });
        
        const sortedDates = Object.keys(trends).sort((a, b) => new Date(a) - new Date(b));
        
        window.departmentStatisticsCharts.assignmentTrends = new Chart(ctx, {
          type: 'line',
          data: {
            labels: sortedDates,
            datasets: [{
              label: 'Assigned Users',
              data: sortedDates.map(d => trends[d].assigned),
              borderColor: 'rgb(16, 185, 129)',
              backgroundColor: 'rgba(16, 185, 129, 0.1)',
              tension: 0.4,
              fill: true
            }, {
              label: 'Unassigned Users',
              data: sortedDates.map(d => trends[d].unassigned),
              borderColor: 'rgb(239, 68, 68)',
              backgroundColor: 'rgba(239, 68, 68, 0.1)',
              tension: 0.4,
              fill: true
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: true, position: 'top' }
            },
            scales: {
              y: { beginAtZero: true, ticks: { stepSize: 1 } }
            }
          }
        });
      }

