          if (modalContent) {
            modalContent.style.transition = 'all 0.2s ease-in';
            modalContent.style.transform = 'scale(0.95) translateY(20px)';
            modalContent.style.opacity = '0';
          }
          
          modal.style.transition = 'opacity 0.2s ease-in';
          modal.style.opacity = '0';
          
          setTimeout(() => {
            modal.classList.add('hidden');
          }, 200);
        }
      };

      // Navigate to user-management.astro with user filter
      // ==================== DEPARTMENT COMPARISON ====================
      
      // Store selected department for comparison
      window.comparisonSelectedDept = null;
      
      // Select department for comparison
      window.selectDepartmentForComparison = function(deptId) {
        window.comparisonSelectedDept = deptId;
        openComparisonSelectionModal();
      };
      
      // Open comparison selection modal
      function openComparisonSelectionModal() {
        const modal = document.getElementById('comparisonSelectionModal');
        const select1 = document.getElementById('compareDept1');
        const select2 = document.getElementById('compareDept2');
        
        if (!modal || !select1 || !select2) return;
        
        // Populate department selects
        const { departments } = window.officeGroupsData;
        select1.innerHTML = '<option value="">Select first department...</option>';
        select2.innerHTML = '<option value="">Select second department...</option>';
        
        departments.forEach(dept => {
          const option1 = document.createElement('option');
          option1.value = dept.id;
          option1.textContent = `${dept.name} (${dept.code})`;
          if (window.comparisonSelectedDept === dept.id) {
            option1.selected = true;
          }
          select1.appendChild(option1);
          
          const option2 = document.createElement('option');
          option2.value = dept.id;
          option2.textContent = `${dept.name} (${dept.code})`;
          select2.appendChild(option2);
        });
        
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
      
      // Close comparison selection modal
      window.closeComparisonSelectionModal = function() {
        const modal = document.getElementById('comparisonSelectionModal');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
        window.comparisonSelectedDept = null;
      };
      
      // Show notice modal
      function showNoticeModal(title, message) {
        const modal = document.getElementById('noticeModal');
        const titleEl = document.getElementById('noticeTitle');
        const messageEl = document.getElementById('noticeMessage');
        
        if (modal && titleEl && messageEl) {
          titleEl.textContent = title || 'Notice';
          messageEl.textContent = message || 'Please check your input and try again.';
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      }
      
      // Close notice modal
      window.closeNoticeModal = function() {
        const modal = document.getElementById('noticeModal');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      };
      
      // Start comparison
      window.startComparison = function() {
        const dept1Id = document.getElementById('compareDept1')?.value;
        const dept2Id = document.getElementById('compareDept2')?.value;
        
        if (!dept1Id || !dept2Id) {
          showNoticeModal('Selection Required', 'Please select both departments to compare.');
          return;
        }
        
        if (dept1Id === dept2Id) {
          showNoticeModal('Invalid Selection', 'Please select two different departments to compare.');
          return;
        }
        
        closeComparisonSelectionModal();
        renderComparison(dept1Id, dept2Id);
      };
      
      // Render comparison
      function renderComparison(dept1Id, dept2Id) {
        const { departments, users } = window.officeGroupsData;
        const dept1 = departments.find(d => d.id === dept1Id);
        const dept2 = departments.find(d => d.id === dept2Id);
        
        if (!dept1 || !dept2) {
          alert('One or both departments not found');
          return;
        }
        
        // Get users for each department
        const dept1Users = users.filter(u => {
          const userDept = u.department || '';
          return userDept === dept1.name || userDept === dept1.code;
        });
        
        const dept2Users = users.filter(u => {
          const userDept = u.department || '';
          return userDept === dept2.name || userDept === dept2.code;
        });
        
        // Calculate metrics
        const dept1ActiveUsers = dept1Users.filter(u => u.isActive === true).length;
        const dept2ActiveUsers = dept2Users.filter(u => u.isActive === true).length;
        
        // Get unique groups
        const dept1Groups = new Set();
        dept1Users.forEach(user => {
          if (user.group && user.group.trim() !== '') {
            dept1Groups.add(user.group.trim());
          }
        });
        
        const dept2Groups = new Set();
        dept2Users.forEach(user => {
          if (user.group && user.group.trim() !== '') {
            dept2Groups.add(user.group.trim());
          }
        });
        
        const dept1GroupsList = Array.from(dept1Groups).sort();
        const dept2GroupsList = Array.from(dept2Groups).sort();
        
        // Get department logos
        const dept1Logo = getDepartmentLogo(dept1.name);
        const dept2Logo = getDepartmentLogo(dept2.name);
        
        // Check active status
        const dept1HasActive = dept1Users.some(u => u.isActive === true);
        const dept2HasActive = dept2Users.some(u => u.isActive === true);
        
        // Helper function to highlight differences
        function highlightDiff(val1, val2, isHigher = true) {
          if (val1 === val2) return 'border-gray-200';
          if (isHigher) {
            return val1 > val2 ? 'border-green-300 border-2' : 'border-red-300 border-2';
          } else {
            return val1 < val2 ? 'border-green-300 border-2' : 'border-red-300 border-2';
          }
        }
        
        const content = document.getElementById('comparisonContent');
        if (!content) return;
        
        content.innerHTML = `
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Department 1 -->
            <div class="space-y-6">
              <div class="profile-card p-6">
                <div class="flex items-center gap-4 mb-6">
                  <div class="relative w-16 h-16 flex-shrink-0">
                    <img src="${escapeHtml(dept1Logo)}" alt="${escapeHtml(dept1.name)}" class="w-16 h-16 rounded-xl object-cover border-2 border-gray-200" onerror="this.onerror=null; this.src='/santa-cruz-seal.png';">
                    <div class="absolute bottom-0 right-0 w-4 h-4 ${dept1HasActive ? 'bg-green-500' : 'bg-gray-400'} rounded-full border-2 border-white shadow-md"></div>
                  </div>
                  <div class="flex-1">
                    <h4 class="text-2xl font-bold text-gray-900">${escapeHtml(dept1.name)}</h4>
                    <p class="text-sm text-gray-600">${escapeHtml(dept1.code)}</p>
                  </div>
                </div>
                
                <div class="space-y-4">
                  <!-- Basic Info -->
                  <div class="border-t border-gray-200 pt-4">
                    <h5 class="text-sm font-semibold text-gray-700 mb-3">Basic Information</h5>
                    <div class="space-y-2">
                      <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Description:</span>
                        <span class="text-sm font-medium text-gray-900 text-right">${escapeHtml(dept1.description || generateDepartmentDescription(dept1.name))}</span>
                      </div>
                      <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Status:</span>
                        <span class="px-2 py-1 rounded text-xs font-medium ${dept1.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700'}">${dept1.status || 'active'}</span>
                      </div>
                    </div>
                  </div>
                  
                  <!-- User Metrics -->
                  <div class="border-t border-gray-200 pt-4">
                    <h5 class="text-sm font-semibold text-gray-700 mb-3">User Metrics</h5>
                    <div class="grid grid-cols-2 gap-3">
                      <div class="p-3 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg border ${highlightDiff(dept1Users.length, dept2Users.length)}">
                        <div class="text-xs text-gray-600 mb-1">Total Users</div>
                        <div class="text-2xl font-bold text-gray-900">${dept1Users.length}</div>
                      </div>
                      <div class="p-3 bg-gradient-to-br from-green-50 to-green-100 rounded-lg border ${highlightDiff(dept1ActiveUsers, dept2ActiveUsers)}">
                        <div class="text-xs text-gray-600 mb-1">Active Users</div>
                        <div class="text-2xl font-bold text-gray-900">${dept1ActiveUsers}</div>
                      </div>
                      <div class="p-3 bg-gradient-to-br from-gray-50 to-gray-100 rounded-lg border ${highlightDiff(dept1Users.length - dept1ActiveUsers, dept2Users.length - dept2ActiveUsers, false)}">
                        <div class="text-xs text-gray-600 mb-1">Inactive Users</div>
                        <div class="text-2xl font-bold text-gray-900">${dept1Users.length - dept1ActiveUsers}</div>
                      </div>
                      <div class="p-3 bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg border">
                        <div class="text-xs text-gray-600 mb-1">Activity Rate</div>
                        <div class="text-2xl font-bold text-gray-900">${dept1Users.length > 0 ? Math.round((dept1ActiveUsers / dept1Users.length) * 100) : 0}%</div>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Groups -->
                  <div class="border-t border-gray-200 pt-4">
                    <h5 class="text-sm font-semibold text-gray-700 mb-3">User Groups</h5>
                    <div class="flex flex-wrap gap-2">
                      ${(() => {
                        if (dept1.name === 'Executive Office' || dept1.name === 'Information Technology') {
                          return '<span class="px-2 py-1 bg-gray-100 text-gray-800 rounded text-xs font-medium">Admin Office</span>';
                        }
                        if (dept1GroupsList.length > 0) {
                          return dept1GroupsList.map(group => {
                            let badgeClass = '';
                            if (group === 'EIU') badgeClass = 'bg-green-100 text-green-700';
                            else if (group === 'LGU-IU') badgeClass = 'bg-amber-100 text-amber-800';
                            else if (group === 'LGU-PMT') badgeClass = 'bg-blue-100 text-blue-700';
                            else badgeClass = 'bg-gray-100 text-gray-700';
                            return `<span class="px-2 py-1 ${badgeClass} rounded text-xs font-medium">${escapeHtml(group)}</span>`;
                          }).join('');
                        }
                        return '<span class="text-sm text-gray-400">No groups assigned</span>';
                      })()}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Department 2 -->
            <div class="space-y-6">
              <div class="profile-card p-6">
                <div class="flex items-center gap-4 mb-6">
                  <div class="relative w-16 h-16 flex-shrink-0">
                    <img src="${escapeHtml(dept2Logo)}" alt="${escapeHtml(dept2.name)}" class="w-16 h-16 rounded-xl object-cover border-2 border-gray-200" onerror="this.onerror=null; this.src='/santa-cruz-seal.png';">
                    <div class="absolute bottom-0 right-0 w-4 h-4 ${dept2HasActive ? 'bg-green-500' : 'bg-gray-400'} rounded-full border-2 border-white shadow-md"></div>
                  </div>
                  <div class="flex-1">
                    <h4 class="text-2xl font-bold text-gray-900">${escapeHtml(dept2.name)}</h4>
                    <p class="text-sm text-gray-600">${escapeHtml(dept2.code)}</p>
                  </div>
                </div>
                
                <div class="space-y-4">
                  <!-- Basic Info -->
                  <div class="border-t border-gray-200 pt-4">
                    <h5 class="text-sm font-semibold text-gray-700 mb-3">Basic Information</h5>
                    <div class="space-y-2">
                      <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Description:</span>
                        <span class="text-sm font-medium text-gray-900 text-right">${escapeHtml(dept2.description || generateDepartmentDescription(dept2.name))}</span>
                      </div>
                      <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Status:</span>
                        <span class="px-2 py-1 rounded text-xs font-medium ${dept2.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700'}">${dept2.status || 'active'}</span>
                      </div>
                    </div>
                  </div>
                  
                  <!-- User Metrics -->
                  <div class="border-t border-gray-200 pt-4">
                    <h5 class="text-sm font-semibold text-gray-700 mb-3">User Metrics</h5>
                    <div class="grid grid-cols-2 gap-3">
                      <div class="p-3 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg border ${highlightDiff(dept2Users.length, dept1Users.length)}">
                        <div class="text-xs text-gray-600 mb-1">Total Users</div>
                        <div class="text-2xl font-bold text-gray-900">${dept2Users.length}</div>
                      </div>
                      <div class="p-3 bg-gradient-to-br from-green-50 to-green-100 rounded-lg border ${highlightDiff(dept2ActiveUsers, dept1ActiveUsers)}">
                        <div class="text-xs text-gray-600 mb-1">Active Users</div>
                        <div class="text-2xl font-bold text-gray-900">${dept2ActiveUsers}</div>
                      </div>
                      <div class="p-3 bg-gradient-to-br from-gray-50 to-gray-100 rounded-lg border ${highlightDiff(dept2Users.length - dept2ActiveUsers, dept1Users.length - dept1ActiveUsers, false)}">
                        <div class="text-xs text-gray-600 mb-1">Inactive Users</div>
                        <div class="text-2xl font-bold text-gray-900">${dept2Users.length - dept2ActiveUsers}</div>
                      </div>
                      <div class="p-3 bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg border">
                        <div class="text-xs text-gray-600 mb-1">Activity Rate</div>
                        <div class="text-2xl font-bold text-gray-900">${dept2Users.length > 0 ? Math.round((dept2ActiveUsers / dept2Users.length) * 100) : 0}%</div>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Groups -->
                  <div class="border-t border-gray-200 pt-4">
                    <h5 class="text-sm font-semibold text-gray-700 mb-3">User Groups</h5>
                    <div class="flex flex-wrap gap-2">
                      ${(() => {
                        if (dept2.name === 'Executive Office' || dept2.name === 'Information Technology') {
                          return '<span class="px-2 py-1 bg-gray-100 text-gray-800 rounded text-xs font-medium">Admin Office</span>';
                        }
                        if (dept2GroupsList.length > 0) {
                          return dept2GroupsList.map(group => {
                            let badgeClass = '';
                            if (group === 'EIU') badgeClass = 'bg-green-100 text-green-700';
                            else if (group === 'LGU-IU') badgeClass = 'bg-amber-100 text-amber-800';
                            else if (group === 'LGU-PMT') badgeClass = 'bg-blue-100 text-blue-700';
                            else badgeClass = 'bg-gray-100 text-gray-700';
                            return `<span class="px-2 py-1 ${badgeClass} rounded text-xs font-medium">${escapeHtml(group)}</span>`;
                          }).join('');
                        }
                        return '<span class="text-sm text-gray-400">No groups assigned</span>';
                      })()}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Summary Section -->
          <div class="mt-6 profile-card p-6">
            <h5 class="text-lg font-bold text-gray-900 mb-4">Comparison Summary</h5>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="p-4 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg border border-blue-200">
                <div class="text-sm text-gray-600 mb-1">User Count Difference</div>
                <div class="text-2xl font-bold ${dept1Users.length > dept2Users.length ? 'text-green-700' : dept1Users.length < dept2Users.length ? 'text-red-700' : 'text-gray-700'}">
                  ${dept1Users.length > dept2Users.length ? '+' : ''}${dept1Users.length - dept2Users.length}
                </div>
                <div class="text-xs text-gray-600 mt-1">${dept1.name} has ${Math.abs(dept1Users.length - dept2Users.length)} ${dept1Users.length > dept2Users.length ? 'more' : 'fewer'} users</div>
              </div>
              <div class="p-4 bg-gradient-to-br from-green-50 to-green-100 rounded-lg border border-green-200">
                <div class="text-sm text-gray-600 mb-1">Active User Difference</div>
                <div class="text-2xl font-bold ${dept1ActiveUsers > dept2ActiveUsers ? 'text-green-700' : dept1ActiveUsers < dept2ActiveUsers ? 'text-red-700' : 'text-gray-700'}">
                  ${dept1ActiveUsers > dept2ActiveUsers ? '+' : ''}${dept1ActiveUsers - dept2ActiveUsers}
                </div>
                <div class="text-xs text-gray-600 mt-1">${dept1.name} has ${Math.abs(dept1ActiveUsers - dept2ActiveUsers)} ${dept1ActiveUsers > dept2ActiveUsers ? 'more' : 'fewer'} active users</div>
              </div>
              <div class="p-4 bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg border border-purple-200">
                <div class="text-sm text-gray-600 mb-1">Activity Rate Difference</div>
                ${(() => {
                  const rate1 = dept1Users.length > 0 ? (dept1ActiveUsers / dept1Users.length) * 100 : 0;
                  const rate2 = dept2Users.length > 0 ? (dept2ActiveUsers / dept2Users.length) * 100 : 0;
                  const diff = rate1 - rate2;
                  return `
                    <div class="text-2xl font-bold ${diff > 0 ? 'text-green-700' : diff < 0 ? 'text-red-700' : 'text-gray-700'}">
                      ${diff > 0 ? '+' : ''}${diff.toFixed(1)}%
                    </div>
                    <div class="text-xs text-gray-600 mt-1">${dept1.name} is ${Math.abs(diff).toFixed(1)}% ${diff > 0 ? 'more' : diff < 0 ? 'less' : 'equally'} active</div>
                  `;
                })()}
              </div>
            </div>
          </div>
        `;
        
        // Show comparison modal
        const modal = document.getElementById('comparisonModal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      }
      
      // Close comparison modal
      window.closeComparisonModal = function() {
        const modal = document.getElementById('comparisonModal');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      };

      window.navigateToUser = function(username, email, fullName) {
        // Close the modal first
        closeDepartmentUsersModal();
        
        // Build URL with search parameter (user-management.astro uses 'search' param)
        // Try username first, then email, then name
        const searchTerm = username || email || fullName;
        const baseUrl = window.location.origin;
        const userManagementUrl = `${baseUrl}/dashboard/sysadmin/modules/user-management?search=${encodeURIComponent(searchTerm)}`;
        
        // Navigate to user-management page
        window.location.href = userManagementUrl;
      };

      window.viewGroupDetails = function(id) {
        const group = window.officeGroupsData.groups.find(g => g.id === id);
        if (!group) return;

        // Count group users accurately
        const groupUsers = window.officeGroupsData.users.filter(u => {
          const userGroup = u.group || '';
          return userGroup === group.name || userGroup === group.code;
        });
        const dept = window.officeGroupsData.departments.find(d => d.id === group.departmentId);

        alert(`Group: ${group.name}\nCode: ${group.code}\nDepartment: ${dept?.name || 'Not assigned'}\nLeader: ${group.leader || 'Not assigned'}\nMembers: ${groupUsers.length}\nStatus: ${group.status}`);
      };

      // ==================== INITIALIZATION ====================
      
      // Ensure all modals are hidden on initialization
      function initializeModals() {
        const loadingModal = document.getElementById('loadingModal');
        const successModal = document.getElementById('successModal');
        
        if (loadingModal) {
          loadingModal.classList.add('hidden');
          loadingModal.classList.remove('flex');
        }
        
        if (successModal) {
          successModal.classList.add('hidden');
          successModal.classList.remove('flex');
        }
      }
      
      // Initialize on page load
      document.addEventListener('DOMContentLoaded', () => {
        initializeModals();
        fetchAllData();
        populateDepartmentFilters();
      });

      // Also run if DOM is already loaded
      if (document.readyState !== 'loading') {
        initializeModals();
        fetchAllData();
        populateDepartmentFilters();
      } else {
        // If still loading, ensure modals are hidden immediately
        initializeModals();
      }
    </script>
  </SysAdminLayout>
</Layout> 
