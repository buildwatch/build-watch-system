        function escapeHtml(text) {
          const div = document.createElement('div');
          div.textContent = text;
          return div.innerHTML;
        }

        // Refresh functionality
        document.getElementById('refreshLogs').addEventListener('click', function() {
          window.location.reload();
        });

        // Chart.js instances storage
        window.statisticsCharts = {};

        // Show statistics modal
        document.getElementById('viewStatisticsBtn')?.addEventListener('click', function() {
          showStatisticsModal();
        });

        // Show statistics modal - make globally accessible
        window.showStatisticsModal = function() {
          const modal = document.getElementById('statisticsModal');
          if (modal) {
            modal.classList.remove('hidden');
            loadStatistics();
          }
        };

        // Close statistics modal - make globally accessible
        window.closeStatisticsModal = function() {
          const modal = document.getElementById('statisticsModal');
          if (modal) {
            modal.classList.add('hidden');
            // Destroy all charts to free memory
            Object.values(window.statisticsCharts).forEach(chart => {
              if (chart && typeof chart.destroy === 'function') {
                chart.destroy();
              }
            });
            window.statisticsCharts = {};
          }
        };

        // Close statistics modal when clicking outside
        document.getElementById('statisticsModal')?.addEventListener('click', function(e) {
          if (e.target === this) {
            closeStatisticsModal();
          }
        });

        // Load Chart.js library
        function loadChartJS() {
          return new Promise((resolve, reject) => {
            if (window.Chart) {
              resolve(window.Chart);
              return;
            }
            
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
            script.onload = () => resolve(window.Chart);
            script.onerror = () => reject(new Error('Failed to load Chart.js'));
            document.head.appendChild(script);
          });
        }

        // Load statistics data and render charts
        async function loadStatistics() {
          const loadingEl = document.getElementById('statisticsLoading');
          const contentEl = document.getElementById('statisticsContent');
          
          if (loadingEl) loadingEl.classList.remove('hidden');
          if (contentEl) contentEl.classList.add('hidden');

          try {
            // Load Chart.js
            const Chart = await loadChartJS();
            
            // Get time range
            const timeRange = parseInt(document.getElementById('statisticsTimeRange')?.value || '30');
            const daysAgo = new Date();
            daysAgo.setDate(daysAgo.getDate() - timeRange);
            
            // Fetch statistics data
            const token = document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1] || '';
            // Use dynamic API URL detection
            const API_URL = window.getApiUrl() + '/activity-logs';
            
            // Fetch all logs for the time range
            const response = await fetch(`${API_URL}?limit=10000&dateFrom=${daysAgo.toISOString().split('T')[0]}`, {
              headers: { 'Authorization': `Bearer ${token}` }
            });
            
            if (!response.ok) {
              throw new Error('Failed to fetch statistics data');
            }
            
            const data = await response.json();
            if (!data.success) {
              throw new Error(data.error || 'Failed to fetch statistics data');
            }
            
            const logs = data.logs || [];
            
            // Process data and render charts
            await renderAllCharts(Chart, logs, timeRange);
            
            if (loadingEl) loadingEl.classList.add('hidden');
            if (contentEl) contentEl.classList.remove('hidden');
            
          } catch (error) {
            console.error('Error loading statistics:', error);
            if (loadingEl) loadingEl.classList.add('hidden');
            if (contentEl) {
              contentEl.innerHTML = `
                <div class="text-center py-12">
                  <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-10 h-10 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                    </svg>
                  </div>
                  <p class="text-gray-700 font-semibold text-lg mb-2">Failed to load statistics</p>
                  <p class="text-gray-500 text-sm">${error.message}</p>
                </div>
              `;
              contentEl.classList.remove('hidden');
            }
          }
        }

        // Render all charts
        async function renderAllCharts(Chart, logs, timeRange) {
          // Destroy existing charts
          Object.values(window.statisticsCharts).forEach(chart => {
            if (chart && typeof chart.destroy === 'function') {
              chart.destroy();
            }
          });
          window.statisticsCharts = {};

          // Process data
          const processedData = processStatisticsData(logs, timeRange);
          
          // Render all charts
          renderActivityTrendsChart(Chart, processedData.trends);
          renderActivityLevelChart(Chart, processedData.byLevel);
          renderActivityStatusChart(Chart, processedData.byStatus);
          renderActivityModuleChart(Chart, processedData.byModule);
          renderActivityCategoryChart(Chart, processedData.byCategory);
          renderTopUsersChart(Chart, processedData.topUsers);
          renderSecurityInsightsChart(Chart, processedData.security);
          renderActivityHeatmapChart(Chart, processedData.heatmap);
          renderTopActionsChart(Chart, processedData.topActions);
        }

        // Process statistics data
        function processStatisticsData(logs, timeRange) {
          const trends = {};
          const byLevel = {};
          const byStatus = {};
          const byModule = {};
          const byCategory = {};
          const byUser = {};
          const byAction = {};
          const security = { failedLogins: 0, criticalErrors: 0, warnings: 0 };
          const heatmap = {};
          
          const actionCategories = {
            'Authentication': ['LOGIN', 'LOGOUT', 'PASSWORD_CHANGE', 'FAILED_LOGIN', 'ACCOUNT_LOCKOUT', 'RESET_PASSWORD'],
            'User Management': ['CREATE_USER', 'UPDATE_USER', 'DELETE_USER', 'ENABLE_USER', 'DISABLE_USER', 'CHANGE_ROLE'],
            'System Admin': ['UPDATE_CONFIGURATION', 'BACKUP_CREATED', 'BACKUP_RESTORED', 'SYSTEM_MAINTENANCE', 'SECURITY_UPDATE'],
            'Data Management': ['CREATE_ANNOUNCEMENT', 'UPDATE_ANNOUNCEMENT', 'DELETE_ANNOUNCEMENT', 'EXPORT_DATA', 'IMPORT_DATA'],
            'Audit & Monitoring': ['VIEW_AUDIT_LOG', 'EXPORT_AUDIT_LOG', 'SECURITY_ALERT', 'PERFORMANCE_ALERT'],
            'Other': []
          };

          logs.forEach(log => {
            // Trends by date
            const date = new Date(log.createdAt).toISOString().split('T')[0];
            trends[date] = (trends[date] || 0) + 1;
            
            // By level
            const level = log.level || 'Info';
            byLevel[level] = (byLevel[level] || 0) + 1;
            
            // By status
            const status = log.status || 'Success';
            byStatus[status] = (byStatus[status] || 0) + 1;
            
            // By module
            const module = log.module || 'Unknown';
            byModule[module] = (byModule[module] || 0) + 1;
            
            // By category
            const action = log.action || '';
            let category = 'Other';
            for (const [cat, actions] of Object.entries(actionCategories)) {
              if (actions.includes(action)) {
                category = cat;
                break;
              }
            }
            byCategory[category] = (byCategory[category] || 0) + 1;
            
            // By user
            const userName = log.userName || 'System';
            byUser[userName] = (byUser[userName] || 0) + 1;
            
            // By action
            if (action) {
              byAction[action] = (byAction[action] || 0) + 1;
            }
            
            // Security insights
            if (status === 'Failed' && (action === 'FAILED_LOGIN' || action === 'LOGIN')) {
              security.failedLogins++;
            }
            if (level === 'Critical') {
              security.criticalErrors++;
            }
            if (level === 'Warning') {
              security.warnings++;
            }
            
            // Heatmap by hour
            const hour = new Date(log.createdAt).getHours();
            heatmap[hour] = (heatmap[hour] || 0) + 1;
          });

          // Sort and get top items
          const topUsers = Object.entries(byUser)
            .sort((a, b) => b[1] - a[1])
            .slice(0, 10)
            .map(([name, count]) => ({ name, count }));

          const topActions = Object.entries(byAction)
            .sort((a, b) => b[1] - a[1])
            .slice(0, 10)
            .map(([action, count]) => ({ action, count }));

          // Sort trends by date
          const sortedTrends = Object.entries(trends)
            .sort((a, b) => new Date(a[0]) - new Date(b[0]))
            .reduce((acc, [date, count]) => {
              acc.labels.push(date);
              acc.data.push(count);
              return acc;
            }, { labels: [], data: [] });

          return {
            trends: sortedTrends,
            byLevel,
            byStatus,
            byModule,
            byCategory,
            topUsers,
            topActions,
            security,
            heatmap
          };
        }

