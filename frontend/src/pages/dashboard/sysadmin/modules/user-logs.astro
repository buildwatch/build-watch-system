        function generatePDF(logs) {
          const { jsPDF } = window.jspdf;
          const doc = new jsPDF('l', 'mm', 'a4'); // landscape orientation
          
          // Add title
          doc.setFontSize(16);
          doc.text('User Logs Monitoring Report', 14, 15);
          doc.setFontSize(10);
          doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 22);
          doc.text(`Total Records: ${logs.length}`, 14, 27);
          
          // Prepare table data
          const headers = [['Timestamp', 'User', 'Action', 'Level', 'Status', 'Details']];
          const tableData = logs.map(log => [
            new Date(log.createdAt).toLocaleString().substring(0, 16),
            (log.userName || 'System').substring(0, 20),
            (log.action || '').substring(0, 25),
            log.level || 'Info',
            log.status || 'Success',
            (log.details || '').substring(0, 40)
          ]);
          
          // Use autoTable if available, otherwise create simple table
          if (doc.autoTable) {
            doc.autoTable({
              head: headers,
              body: tableData,
              startY: 35,
              styles: { fontSize: 7, cellPadding: 2 },
              headStyles: { fillColor: [0, 0, 0], textColor: [255, 255, 255], fontStyle: 'bold' },
              alternateRowStyles: { fillColor: [245, 245, 245] },
              margin: { top: 35 }
            });
          } else {
            // Fallback: simple text-based table
            let yPos = 35;
            doc.setFontSize(8);
            headers[0].forEach((header, i) => {
              doc.text(header, 14 + (i * 40), yPos);
            });
            yPos += 10;
            tableData.slice(0, 30).forEach(row => {
              row.forEach((cell, i) => {
                doc.text(cell, 14 + (i * 40), yPos);
              });
              yPos += 8;
              if (yPos > 190) {
                doc.addPage();
                yPos = 20;
              }
            });
          }
          
          // Save PDF
          doc.save(`audit-trail-${new Date().toISOString().split('T')[0]}.pdf`);
        }

