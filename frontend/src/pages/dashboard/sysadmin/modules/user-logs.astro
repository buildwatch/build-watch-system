      <script define:vars={{ activeUsersList: summary.activeUsersList || [], logsData: logs }}>
        // Global API URL helper function - works for both localhost and production
        window.getApiUrl = function() {
          const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
          return isProd 
            ? `${window.location.protocol}//${window.location.hostname}/api`
            : 'http://localhost:3000/api';
        };

        // Store summary data for JavaScript access
        window.summaryData = {
          activeUsersList: activeUsersList
        };

        // Store logs data globally for viewLogDetails function
        window.logsData = logsData || [];

        // ============================================
        // PROFILE PICTURE DEBUGGING CODE
        // ============================================
        // This debugging code helps identify why profile pictures are not showing.
        // Open the browser console (F12) to see detailed logs with these emojis:
        // 🔍 = Debug information
        // ✅ = Success
        // ⚠️ = Warning
        // ❌ = Error
        // 
        // What to check:
        // 1. Are user IDs being found? (Look for "Unique User IDs found")
        // 2. Is the API endpoint correct? (Look for "Fetching from")
        // 3. Is the API returning data? (Look for "API Response")
        // 4. Are image elements being found? (Look for "Found X profile image elements")
        // 5. Are images loading? (Look for "Image loaded successfully" or "Image failed to load")
        // ============================================
        
        // Helper function to convert base64 data URL to blob URL to avoid HTTP/2 protocol errors
        const convertBase64ToBlobUrl = (dataUrl) => {
          if (!dataUrl || !dataUrl.startsWith('data:')) {
            return dataUrl; // Not a base64 data URL, return as is
          }
          try {
            // Extract MIME type and base64 data
            const matches = dataUrl.match(/^data:([^;]+);base64,(.+)$/);
            if (!matches) {
              console.warn('⚠️ [Profile Picture Debug] Invalid base64 data URL format');
              return dataUrl; // Return original if parsing fails
            }
            const mimeType = matches[1];
            const base64Data = matches[2];
            
            // Convert base64 to binary
            const byteCharacters = atob(base64Data);
            const byteNumbers = new Array(byteCharacters.length);
            for (let i = 0; i < byteCharacters.length; i++) {
              byteNumbers[i] = byteCharacters.charCodeAt(i);
            }
            const byteArray = new Uint8Array(byteNumbers);
            
            // Create blob and blob URL
            const blob = new Blob([byteArray], { type: mimeType });
            const blobUrl = URL.createObjectURL(blob);
            
            console.log('✅ [Profile Picture Debug] Converted base64 to blob URL:', {
              originalLength: dataUrl.length,
              blobUrl: blobUrl.substring(0, 50) + '...',
              mimeType: mimeType
            });
            
            return blobUrl;
          } catch (error) {
            console.error('❌ [Profile Picture Debug] Error converting base64 to blob URL:', error);
            return dataUrl; // Return original on error
          }
        };
        
        // Helper function to format profile picture URL
        const formatProfilePictureUrl = (url) => {
          console.log('🔍 [Profile Picture Debug] Formatting URL:', url);
          if (!url) {
            console.log('⚠️ [Profile Picture Debug] URL is null or undefined');
            return null;
          }
          // If it's a base64 data URL, convert to blob URL to avoid HTTP/2 errors
          if (url.startsWith('data:')) {
            console.log('🔍 [Profile Picture Debug] Detected base64 data URL, converting to blob URL');
            return convertBase64ToBlobUrl(url);
          }
          // If already absolute URL, return as is
          if (url.startsWith('http://') || url.startsWith('https://')) {
            console.log('✅ [Profile Picture Debug] URL is already absolute:', url);
            return url;
          }
          // If relative URL, prepend API base URL
          const apiUrl = window.getApiUrl();
          console.log('🔍 [Profile Picture Debug] API URL:', apiUrl);
          // Remove /api from the end if present, then add the relative path
          const baseUrl = apiUrl.replace(/\/api$/, '');
          const finalUrl = url.startsWith('/') ? `${baseUrl}${url}` : `${baseUrl}/${url}`;
          console.log('✅ [Profile Picture Debug] Formatted final URL:', finalUrl);
          return finalUrl;
        };
        
        // Function to load profile picture for a single user (can be called on page load or when modal opens)
        async function loadUserProfilePicture(userId) {
          if (!userId || userId === 'system') {
            console.log('⚠️ [Profile Picture Debug] Skipping profile picture load for invalid userId:', userId);
            return;
          }
          
          console.log(`🔍 [Profile Picture Debug] Loading profile picture for user: ${userId}`);
          try {
            const token = localStorage.getItem('token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1] || '';
            const apiUrl = window.getApiUrl();
            const profilePictureEndpoint = `${apiUrl}/profile/picture/${userId}`;
            
            const response = await fetch(profilePictureEndpoint, {
              headers: { 'Authorization': `Bearer ${token}` }
            });
            
            if (response.ok) {
              const result = await response.json();
              
              if (result.success && result.profilePictureUrl) {
                const formattedUrl = formatProfilePictureUrl(result.profilePictureUrl);
                
                // Update all profile pictures for this user in the table
                const profileImgsById = document.querySelectorAll(`img[id="profile-picture-${userId}"]`);
                const profileImgsByData = document.querySelectorAll(`img[data-user-id="${userId}"]`);
                const profileImgs = profileImgsById.length > 0 ? profileImgsById : profileImgsByData;
                
                profileImgs.forEach((img) => {
                  const fallback = img.nextElementSibling;
                  if (formattedUrl) {
                    img.src = formattedUrl;
                    img.style.display = 'block';
                    if (fallback) fallback.style.display = 'none';
                    img.onerror = function() {
                      this.style.display = 'none';
                      if (fallback) fallback.style.display = 'flex';
                    };
                    img.onload = function() {
                      this.style.display = 'block';
                      if (fallback) fallback.style.display = 'none';
                    };
                  }
                });
                
                // Update profile picture in modal
                const modalImgsById = document.querySelectorAll(`img[id="modal-profile-picture-${userId}"]`);
                const modalImgsByData = document.querySelectorAll(`img[data-user-id="${userId}"][id^="modal-profile-picture-"]`);
                const modalImgs = modalImgsById.length > 0 ? modalImgsById : modalImgsByData;
                
                modalImgs.forEach((img) => {
                  const fallback = img.nextElementSibling;
                  if (formattedUrl) {
                    img.src = formattedUrl;
                    img.style.display = 'block';
                    if (fallback) fallback.style.display = 'none';
                    img.onerror = function() {
                      this.style.display = 'none';
                      if (fallback) fallback.style.display = 'flex';
                    };
                    img.onload = function() {
                      this.style.display = 'block';
                      if (fallback) fallback.style.display = 'none';
                    };
                  }
                });
                
                console.log(`✅ [Profile Picture Debug] Profile picture loaded for user: ${userId}`, {
                  tableImages: profileImgs.length,
                  modalImages: modalImgs.length
                });
              }
            }
          } catch (error) {
            console.error(`❌ [Profile Picture Debug] Error loading profile picture for user ${userId}:`, error);
          }
        }
        
        // Load profile pictures for all users in the logs
        async function loadProfilePictures() {
          console.log('🔍 [Profile Picture Debug] ===========================================');
          console.log('🔍 [Profile Picture Debug] Starting profile picture loading...');
          console.log('🔍 [Profile Picture Debug] ===========================================');
          
          // Extract userIds from logs - try multiple sources
          const userIdsFromLogs = logsData
            .filter(log => {
              // Try log.userId first, then log.user?.userId, then log.user?.id
              return log.userId || (log.user && (log.user.userId || log.user.id));
            })
            .map(log => {
              // Prefer userId from user object if available, otherwise use log.userId
              if (log.user && log.user.userId) return log.user.userId;
              if (log.user && log.user.id) return log.user.id.toString();
              return log.userId;
            });
          
          const uniqueUserIds = [...new Set(userIdsFromLogs)];
          console.log('🔍 [Profile Picture Debug] Unique User IDs found:', uniqueUserIds);
          console.log('🔍 [Profile Picture Debug] Total logs:', logsData.length);
          console.log('🔍 [Profile Picture Debug] Logs with userId:', logsData.filter(log => log.userId || (log.user && (log.user.userId || log.user.id))).length);
          
          // Debug: Check if logs have user data
          if (logsData.length > 0) {
            const sampleLog = logsData[0];
            console.log('🔍 [Profile Picture Debug] Sample log entry:', {
              userId: sampleLog.userId,
              userName: sampleLog.userName,
              user: sampleLog.user,
              hasUserObject: !!sampleLog.user,
              userObjectKeys: sampleLog.user ? Object.keys(sampleLog.user) : [],
              extractedUserId: sampleLog.user && sampleLog.user.userId ? sampleLog.user.userId : (sampleLog.user && sampleLog.user.id ? sampleLog.user.id.toString() : sampleLog.userId)
            });
          }
          
          console.log('🔍 [Profile Picture Debug] Starting to load profile pictures for', uniqueUserIds.length, 'users');
          
          // Load profile pictures for all users in parallel
          await Promise.all(uniqueUserIds.map(userId => loadUserProfilePicture(userId)));
          
          console.log('🔍 [Profile Picture Debug] Finished loading profile pictures');
        }

          // Debug: Check DOM elements on page load
        function debugProfilePictureElements() {
          console.log('🔍 [Profile Picture Debug] Checking DOM elements...');
          const allProfileImgs = document.querySelectorAll('img[id^="profile-picture-"]');
          const allModalImgs = document.querySelectorAll('img[id^="modal-profile-picture-"]');
          console.log('🔍 [Profile Picture Debug] Found profile images:', allProfileImgs.length);
          console.log('🔍 [Profile Picture Debug] Found modal profile images:', allModalImgs.length);
          
          if (allProfileImgs.length > 0) {
            console.log('🔍 [Profile Picture Debug] Sample profile image:', {
              id: allProfileImgs[0].id,
              src: allProfileImgs[0].src,
              display: window.getComputedStyle(allProfileImgs[0]).display,
              hasFallback: !!allProfileImgs[0].nextElementSibling
            });
          }
          
          // Check logsData
          console.log('🔍 [Profile Picture Debug] Logs data available:', {
            totalLogs: logsData ? logsData.length : 0,
            hasLogsData: !!logsData,
            sampleLog: logsData && logsData.length > 0 ? {
              userId: logsData[0].userId,
              userName: logsData[0].userName,
              hasUser: !!logsData[0].user,
              userObject: logsData[0].user ? {
                id: logsData[0].user.id,
                userId: logsData[0].user.userId,
                email: logsData[0].user.email
              } : null
            } : null
          });
        }
        
        // Load profile pictures on page load
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => {
            debugProfilePictureElements();
            loadProfilePictures();
          });
        } else {
          debugProfilePictureElements();
          loadProfilePictures();
        }

        // Show export format modal - make globally accessible
        window.showExportFormatModal = function() {
          const modal = document.getElementById('exportFormatModal');
          if (modal) {
            modal.classList.remove('hidden');
          }
        };

        // Export button click handler
        document.getElementById('exportLogs').addEventListener('click', function() {
          showExportFormatModal();
        });

        // Close export format modal - make globally accessible
        window.closeExportFormatModal = function() {
          const modal = document.getElementById('exportFormatModal');
          if (modal) {
            modal.classList.add('hidden');
          }
        };

        // Close export format modal when clicking outside
        document.getElementById('exportFormatModal').addEventListener('click', function(e) {
          if (e.target === this) {
            closeExportFormatModal();
          }
        });

        // Export data function - make globally accessible
        window.exportData = async function(format) {
          try {
            closeExportFormatModal();
            
            // Show loading modal
            showExportLoadingModal();
            
            // Get current filters from URL
          const currentUrl = new URL(window.location);
            const params = new URLSearchParams();
            
            // Copy all current filter parameters
            const searchParams = currentUrl.searchParams;
            for (const [key, value] of searchParams.entries()) {
              if (key !== 'page' && key !== 'export') {
                params.append(key, value);
              }
            }
            
            // Get all logs data (we'll need to fetch all, not just current page)
            const token = document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1] || '';
            // Use dynamic API URL detection
            const API_URL = window.getApiUrl() + '/activity-logs';
            
            // Fetch all logs with current filters
            const response = await fetch(`${API_URL}?${params.toString()}&limit=10000`, {
              headers: { 'Authorization': `Bearer ${token}` }
            });
            
            if (!response.ok) {
              throw new Error('Failed to fetch logs');
            }
            
            const data = await response.json();
            if (!data.success) {
              throw new Error(data.error || 'Failed to fetch logs');
            }
            
            const logs = data.logs || window.logsData || [];
            
            // Small delay to show loading animation
            await new Promise(resolve => setTimeout(resolve, 500));
            
            // Export based on format
            switch(format) {
              case 'excel':
                await exportToExcel(logs);
                break;
              case 'pdf':
                await exportToPDF(logs);
                break;
              case 'html':
                exportToHTML(logs);
                break;
              default:
                throw new Error('Invalid export format');
            }
            
            // Hide loading modal and show success modal
            hideExportLoadingModal();
            showExportSuccessModal(format.toUpperCase());
            
          } catch (error) {
            console.error('Export error:', error);
            hideExportLoadingModal();
            showErrorToast('Failed to export data: ' + error.message);
          }
        }

        // Show export loading modal
        function showExportLoadingModal() {
          const modal = document.getElementById('exportLoadingModal');
          if (modal) {
            modal.classList.remove('hidden');
          }
        }

        // Hide export loading modal
        function hideExportLoadingModal() {
          const modal = document.getElementById('exportLoadingModal');
          if (modal) {
            modal.classList.add('hidden');
          }
        }

        // Show export success modal
        function showExportSuccessModal(format) {
          const modal = document.getElementById('exportSuccessModal');
          const title = document.getElementById('exportSuccessTitle');
          const message = document.getElementById('exportSuccessMessage');
          
          if (modal && title && message) {
            title.textContent = 'Export Successful!';
            message.textContent = `Your data has been exported successfully as ${format}.`;
            modal.classList.remove('hidden');
            
            // Auto-close after 3 seconds
            setTimeout(() => {
              closeExportSuccessModal();
            }, 3000);
          }
        }

        // Close export success modal
        window.closeExportSuccessModal = function() {
          const modal = document.getElementById('exportSuccessModal');
          if (modal) {
            modal.classList.add('hidden');
          }
        };

        // Close export success modal when clicking outside
        document.getElementById('exportSuccessModal').addEventListener('click', function(e) {
          if (e.target === this) {
            closeExportSuccessModal();
          }
        });

        // Export to Excel (CSV format that opens in Excel)
        async function exportToExcel(logs) {
          const csvHeader = 'Timestamp,User,Action,Level,Status,Module,Entity Type,Entity ID,Details\n';
          const csvData = logs.map(log => {
            const timestamp = new Date(log.createdAt).toLocaleString();
