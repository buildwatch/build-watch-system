              },
              scales: {
                x: { beginAtZero: true, ticks: { stepSize: 1 } }
              }
            }
          });
        }


        // Time range change handler
        document.getElementById('statisticsTimeRange')?.addEventListener('change', function() {
          loadStatistics();
        });

        // Refresh statistics button
        document.getElementById('refreshStatisticsBtn')?.addEventListener('click', function() {
          loadStatistics();
        });

        // Show active users modal
        function showActiveUsersModal() {
          const modal = document.getElementById('activeUsersModal');
          const content = document.getElementById('activeUsersContent');
          const activeUsers = window.summaryData?.activeUsersList || [];
          
          if (activeUsers.length === 0) {
            content.innerHTML = `
              <div class="text-center py-8">
                <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                </svg>
                <p class="text-gray-500 font-medium">No active users today</p>
                <p class="text-gray-400 text-sm mt-2">No users have logged in successfully today</p>
              </div>
            `;
          } else {
            content.innerHTML = `
              <div class="space-y-4">
                ${activeUsers.map(user => `
                  <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
                    <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center text-white text-lg font-semibold shadow-md">
                      ${(user.name || user.username || user.email || 'U').charAt(0).toUpperCase()}
                    </div>
                    <div class="flex-1">
                      <div class="font-semibold text-gray-900">${user.name || user.username || 'Unknown User'}</div>
                      <div class="text-sm text-gray-600">${user.email || 'No email'}</div>
                      <div class="text-xs text-gray-500 mt-1">Role: ${user.role || 'N/A'}</div>
                    </div>
                    <div class="text-right">
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700 border border-green-200">
                        Active
                      </span>
                    </div>
                  </div>
                `).join('')}
              </div>
            `;
          }
          
          modal.classList.remove('hidden');
        }

        // Close active users modal
        function closeActiveUsersModal() {
          document.getElementById('activeUsersModal').classList.add('hidden');
        }

        // Close active users modal when clicking outside
        document.getElementById('activeUsersModal').addEventListener('click', function(e) {
          if (e.target === this) {
            closeActiveUsersModal();
          }
        });

        // View log details - make it globally accessible
        window.viewLogDetails = function(logId) {
          const modal = document.getElementById('logDetailsModal');
          const content = document.getElementById('logDetailsContent');
          
          if (!modal || !content) {
            console.error('Modal elements not found');
            return;
          }
          
          // Find the log data from the stored logs
          const log = window.logsData ? window.logsData.find(l => l.id === logId || l.id === parseInt(logId)) : null;
          
          if (log) {
            // Escape HTML to prevent XSS
            const escapeHtml = (text) => {
              const div = document.createElement('div');
              div.textContent = text;
              return div.innerHTML;
            };
            
            // Extract userId consistently - same logic as loadProfilePictures function
            const getUserId = (log) => {
              if (log.user && log.user.userId) return log.user.userId;
              if (log.user && log.user.id) return log.user.id.toString();
              return log.userId || 'system';
            };
            
            const formatDate = (dateString) => {
              const date = new Date(dateString);
              return date.toLocaleString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: true
              });
            };
            
            const userId = getUserId(log);
            const userName = log.userName || 'System';
            const userInitial = userName.charAt(0).toUpperCase();
            
            content.innerHTML = `
              <div class="space-y-6">
                <!-- Main Information Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <!-- Timestamp Card -->
                  <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-4 border border-blue-100">
                    <div class="flex items-center gap-3 mb-2">
                      <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                  </div>
                      <label class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Timestamp</label>
                  </div>
                    <p class="text-sm font-semibold text-gray-900">${escapeHtml(formatDate(log.createdAt))}</p>
                  </div>
                  
                  <!-- User Card -->
                  <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-4 border border-purple-100">
                    <div class="flex items-center gap-3 mb-2">
                      <img 
                        id="modal-profile-picture-${userId}"
                        data-user-id="${userId}"
                        src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23A855F7'/%3E%3Ctext x='50' y='50' font-family='Arial' font-size='40' font-weight='bold' text-anchor='middle' dy='.3em' fill='white'%3E${userInitial}%3C/text%3E%3C/svg%3E"
                        alt="${escapeHtml(userName)}"
                        class="w-8 h-8 rounded-lg object-cover border-2 border-white shadow-sm"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                      <div class="w-8 h-8 bg-purple-500 rounded-lg flex items-center justify-center" style="display: none;">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                      </div>
                      <label class="text-xs font-semibold text-gray-600 uppercase tracking-wide">User</label>
                    </div>
                    <p class="text-sm font-semibold text-gray-900">${escapeHtml(userName)}</p>
                  </div>
                  
                  <!-- Action Card -->
                  <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-xl p-4 border border-emerald-100">
                    <div class="flex items-center gap-3 mb-2">
                      <div class="w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                      </div>
                      <label class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Action</label>
                    </div>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-700 border border-emerald-200">
                      ${escapeHtml(log.action || 'N/A')}
                    </span>
                  </div>
                </div>
                
                <!-- Status and Level Badges -->
                <div class="flex flex-wrap gap-4">
                  <div class="flex-1 min-w-[150px]">
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-2">Level</label>
                    <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold border shadow-sm ${log.level === 'Warning' ? 'bg-yellow-100 text-yellow-800 border-yellow-300' : log.level === 'Error' ? 'bg-red-100 text-red-800 border-red-300' : log.level === 'Critical' ? 'bg-purple-100 text-purple-800 border-purple-300' : 'bg-blue-100 text-blue-800 border-blue-300'}">
                      ${escapeHtml(log.level || 'Info')}
                    </span>
                  </div>
                  <div class="flex-1 min-w-[150px]">
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide mb-2">Status</label>
                    <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold border shadow-sm ${log.status === 'Failed' ? 'bg-red-100 text-red-800 border-red-300' : log.status === 'Pending' ? 'bg-yellow-100 text-yellow-800 border-yellow-300' : 'bg-green-100 text-green-800 border-green-300'}">
                      ${escapeHtml(log.status || 'Success')}
                    </span>
                  </div>
                </div>
                
                <!-- Details Section -->
                <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="w-8 h-8 bg-gray-600 rounded-lg flex items-center justify-center">
                      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    </div>
                    <label class="text-sm font-semibold text-gray-700">Details</label>
                  </div>
                  <p class="text-sm text-gray-900 leading-relaxed">${escapeHtml(log.details || 'No details provided')}</p>
                </div>
                
                ${log.entityType ? `
                <!-- Entity Information -->
                <div class="bg-gradient-to-br from-indigo-50 to-blue-50 rounded-xl p-5 border border-indigo-100">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center">
                      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                      </svg>
                    </div>
                    <label class="text-sm font-semibold text-gray-700">Entity Information</label>
                  </div>
                  <div class="space-y-2">
                <div>
                      <span class="text-xs font-medium text-gray-600">Type:</span>
                      <span class="ml-2 text-sm font-semibold text-gray-900">${escapeHtml(log.entityType)}</span>
                    </div>
                    ${log.entityId ? `
                <div>
                      <span class="text-xs font-medium text-gray-600">ID:</span>
                      <span class="ml-2 text-sm font-semibold text-gray-900 font-mono">${escapeHtml(log.entityId)}</span>
                </div>
                ` : ''}
                  </div>
                </div>
                ` : ''}
                
                ${log.userAgent ? `
                <!-- User Agent -->
                <div class="bg-gradient-to-br from-slate-50 to-gray-50 rounded-xl p-5 border border-gray-200">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="w-8 h-8 bg-gray-600 rounded-lg flex items-center justify-center">
                      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                      </svg>
                    </div>
                    <label class="text-sm font-semibold text-gray-700">User Agent</label>
                  </div>
                  <p class="text-xs text-gray-700 font-mono break-all leading-relaxed bg-white p-3 rounded-lg border border-gray-200">${escapeHtml(log.userAgent)}</p>
                </div>
                ` : ''}
              </div>
            `;
          } else {
            content.innerHTML = `
              <div class="text-center py-12">
                <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg class="w-10 h-10 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                  </svg>
                </div>
                <p class="text-gray-700 font-semibold text-lg mb-2">Log details not available</p>
                <p class="text-gray-500 text-sm">The requested log entry could not be found</p>
              </div>
            `;
          }
          
          modal.classList.remove('hidden');
          
          // Load profile picture for the user when modal opens
          if (log) {
            const userId = getUserId(log);
            if (userId && userId !== 'system') {
              // Small delay to ensure modal DOM is ready
              setTimeout(() => {
                loadUserProfilePicture(userId);
              }, 100);
            }
          }
        };

        // Close modal - make it globally accessible
        window.closeLogDetails = function() {
          document.getElementById('logDetailsModal').classList.add('hidden');
        };

        // Close modal when clicking outside
        document.getElementById('logDetailsModal').addEventListener('click', function(e) {
          if (e.target === this) {
            closeLogDetails();
          }
        });

        // Real-time monitoring - fetch new logs without full page reload
        let realTimeInterval = null;
        let lastFetchTime = Date.now();
        
        function startRealTimeMonitoring() {
          if (realTimeInterval) return; // Already running
          
          realTimeInterval = setInterval(async function() {
            // Only fetch if page is visible and user is not actively interacting
            if (document.hidden) return;
            
            try {
              const token = localStorage.getItem('token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1] || '';
              const API_URL = window.getApiUrl() + '/activity-logs';
              
              // Fetch only new logs (last 1 minute)
              const oneMinuteAgo = new Date(Date.now() - 60000).toISOString();
              const response = await fetch(`${API_URL}?limit=50&dateFrom=${oneMinuteAgo}`, {
                headers: { 'Authorization': `Bearer ${token}` }
              });
              
              if (response.ok) {
                const data = await response.json();
                if (data.success && data.logs && data.logs.length > 0) {
                  // Check if there are actually new logs
                  const newLogs = data.logs.filter(log => new Date(log.createdAt).getTime() > lastFetchTime);
                  if (newLogs.length > 0) {
                    lastFetchTime = Date.now();
                    // Show a subtle notification
                    const notification = document.createElement('div');
                    notification.className = 'fixed top-4 right-4 bg-green-500 text-white px-4 py-2 rounded-lg shadow-lg z-[100] flex items-center gap-2 animate-fade-in';
                    notification.innerHTML = `
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                      </svg>
                      <span>${newLogs.length} new activity log${newLogs.length > 1 ? 's' : ''} detected. <a href="javascript:location.reload()" class="underline font-semibold">Refresh</a></span>
                    `;
                    document.body.appendChild(notification);
                    setTimeout(() => {
                      notification.style.opacity = '0';
                      notification.style.transition = 'opacity 0.3s';
                      setTimeout(() => notification.remove(), 300);
                    }, 5000);
                  }
                }
              }
            } catch (error) {
              console.log('Real-time monitoring error:', error);
            }
          }, 10000); // Check every 10 seconds
        }
        
        // Start real-time monitoring
        startRealTimeMonitoring();
        
        // Stop monitoring when page is hidden
        document.addEventListener('visibilitychange', function() {
          if (document.hidden && realTimeInterval) {
            clearInterval(realTimeInterval);
            realTimeInterval = null;
          } else if (!document.hidden && !realTimeInterval) {
            startRealTimeMonitoring();
          }
        });
      </script>
    </section>
  </SysAdminLayout>
</Layout> 