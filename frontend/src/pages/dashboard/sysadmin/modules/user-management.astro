          renderUserGroupChart(Chart, stats.byGroup);
          renderUserStatusChart(Chart, stats.byStatus);
          renderUserDepartmentChart(Chart, stats.topDepartments);
          renderRegistrationTrendsChart(Chart, stats.registrationTrends);
          renderActiveInactiveChart(Chart, stats.activeInactiveTrends);
          renderUserRoleChart(Chart, stats.byRole);
          renderUserActivityHeatmapChart(Chart, stats.heatmapData);
          renderDepartmentActivityChart(Chart, stats.departmentActivity);
          renderUserRetentionChart(Chart, stats.statusBreakdown);
