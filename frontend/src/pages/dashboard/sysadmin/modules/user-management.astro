        function renderHistoryUsers() {
          console.log(`🎨 RENDER: Starting renderHistoryUsers...`);
          console.log(`🎨 RENDER: ${filteredHistoryUsers.length} users to render`);
          console.log(`🎨 RENDER: historyUsers.length = ${historyUsers.length}`);
          
          const scrollContainer = document.getElementById('historyScrollContainer');
          const emptyState = document.getElementById('historyEmptyState');
          const historyTemplate = document.getElementById('historyUserTemplate');
          
          console.log('🔍 RENDER: Container elements:', {
            scrollContainer: !!scrollContainer,
            emptyState: !!emptyState,
            historyTemplate: !!historyTemplate
          });
          
          // CRITICAL: Hide the template to prevent it from showing
          if (historyTemplate) {
            historyTemplate.classList.add('hidden');
            historyTemplate.style.display = 'none';
            console.log('✅ Hidden history template');
          }
          
          // CRITICAL: Clear ALL content from scroll container
          if (scrollContainer) {
            // Remove ALL child nodes, including any from the template
            while (scrollContainer.firstChild) {
              scrollContainer.removeChild(scrollContainer.firstChild);
            }
            scrollContainer.innerHTML = '';
            console.log('🧹 Cleared ALL content from scroll container');
            
            // Double-check: count any remaining cards
            const remainingCards = scrollContainer.querySelectorAll('.deleted-history-card');
            if (remainingCards.length > 0) {
              console.warn(`⚠️ WARNING: Found ${remainingCards.length} cards still in container after clearing!`);
              remainingCards.forEach(card => card.remove());
            }
          }
          
          // Show empty state if no users
          if (filteredHistoryUsers.length === 0) {
            console.log('📭 Showing empty state - no users match filters');
            if (emptyState) {
              emptyState.classList.remove('hidden');
              emptyState.style.display = 'block';
            }
            return;
          } else {
            console.log('📋 Hiding empty state - users will be displayed');
            if (emptyState) {
              emptyState.classList.add('hidden');
              emptyState.style.display = 'none';
            }
          }
          
          console.log('📜 Rendering users in scroll mode');
          // Render all users in scroll mode
          filteredHistoryUsers.forEach((user, index) => {
            if (user && user.element && scrollContainer) {
              try {
                const userElement = user.element.cloneNode(true);
                scrollContainer.appendChild(userElement);
                console.log(`✅ Added user ${index + 1} (${user.name || 'Unknown'}) to scroll container`);
              } catch (error) {
                console.error(`❌ Error adding user ${index + 1}:`, error);
              }
            } else {
              console.warn(`⚠️ User ${index + 1} missing element or scrollContainer:`, {
                hasUser: !!user,
                hasElement: !!(user && user.element),
                hasContainer: !!scrollContainer
              });
            }
          });
          
          // Verify what's actually in the container
          const finalCards = scrollContainer.querySelectorAll('.deleted-history-card');
          console.log(`✅ RENDER COMPLETE: ${finalCards.length} user cards in container`);
          
          // Load profile pictures after rendering
          setTimeout(() => {
            loadHistoryProfilePictures();
          }, 100);
        }
        
