                      <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                      </svg>
                      <p class="text-sm font-medium">No Gmail feedback users yet</p>
                      <p class="text-xs text-gray-400">Users who log in via Google to comment on projects will appear here</p>
                    </div>
                  </td>
                </tr>
              ) : (
                feedbackUsers.map((user) => {
                  const formatDate = (dateString) => {
                    if (!dateString) return 'Never';
                    try {
                      const date = new Date(dateString);
                      return date.toLocaleString('en-US', {
                        timeZone: 'Asia/Manila',
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        hour12: true
                      });
                    } catch (e) {
                      return 'Invalid Date';
                    }
                  };

                  const activityText = user.commentCount > 0
                    ? `${user.commentCount} comment${user.commentCount !== 1 ? 's' : ''} posted${user.latestActivity ? ` • Latest: ${formatDate(user.latestActivity.date)}` : ''}`
                    : 'No activity yet';

                  return (
                    <tr class="hover:bg-gray-50 transition-colors">
                      <td class="px-6 py-4 whitespace-nowrap">
