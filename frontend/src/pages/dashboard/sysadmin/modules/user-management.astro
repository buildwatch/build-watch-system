        // Export to Excel function
        function downloadComprehensiveAuditReportExcel(users) {
          const csvHeader = 'User Name,Email,User ID,Role,Department,Deletion Date,Deleted By,Status\n';
          const csvData = users.map(user => {
            const userName = (user.fullName || user.name || 'N/A').replace(/"/g, '""');
            const email = (user.email || 'N/A').replace(/"/g, '""');
            const userId = (user.userId || 'N/A').replace(/"/g, '""');
            const role = ((user.role || 'N/A') + (user.subRole ? ' - ' + user.subRole : '')).replace(/"/g, '""');
            const department = (user.department || 'N/A').replace(/"/g, '""');
            const deletionDate = new Date(user.deletedAt || user.permanentDeletedAt).toLocaleString().replace(/"/g, '""');
            const deletedBy = (user.deletedByUser || 'System Administrator').replace(/"/g, '""');
            const status = 'PERMANENTLY DELETED';
            
            return `"${userName}","${email}","${userId}","${role}","${department}","${deletionDate}","${deletedBy}","${status}"`;
          }).join('\n');
          
          const csvContent = csvHeader + csvData;
          const blob = new Blob(['\ufeff' + csvContent], { type: 'text/csv;charset=utf-8;' });
          const link = document.createElement('a');
          const url = URL.createObjectURL(blob);
          
          const currentDate = new Date().toISOString().split('T')[0];
          link.setAttribute('href', url);
          link.setAttribute('download', `deleted-users-audit-report-${currentDate}.csv`);
          link.style.visibility = 'hidden';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        }

        // Download All Receipts Button
        document.getElementById('downloadAllReceipts')?.addEventListener('click', async function() {
          const deletedHistoryCards = document.querySelectorAll('.deleted-history-card');
          if (deletedHistoryCards.length === 0) {
            alert('No deleted users to generate receipts for.');
            return;
          }
          
          // Show format selection dialog
          const format = await showFormatSelectionDialog();
          if (!format) return;
          
          try {
            // Show loading modal
            showExportLoadingModal();
            
            // Fetch complete deleted users history data from API
            const token = localStorage.getItem('token') || '';
            const response = await fetch('http://localhost:3000/api/users/deleted-history', {
              method: 'GET',
              credentials: 'include',
              headers: { 
                'Accept': 'application/json',
                'Authorization': `Bearer ${token}`
              }
            });
            
            if (!response.ok) {
              const errorText = await response.text();
              console.error('API Error:', response.status, errorText);
              throw new Error(`Failed to fetch deleted users data: ${response.status} ${response.statusText}`);
            }
            
            const data = await response.json();
            if (!data.success) {
              throw new Error(data.error || 'API returned error');
            }
            
            if (!data.users || data.users.length === 0) {
              hideExportLoadingModal();
              alert('No deleted users found to generate report for.');
              return;
            }
            
            // Small delay to show loading animation
            await new Promise(resolve => setTimeout(resolve, 500));
            
            // Generate comprehensive audit report
            if (format === 'html') {
              downloadComprehensiveAuditReport(data.users);
            } else if (format === 'pdf') {
              await downloadComprehensiveAuditReportPDF(data.users);
            } else if (format === 'excel') {
              downloadComprehensiveAuditReportExcel(data.users);
            }
            
            // Hide loading modal and show success modal
            hideExportLoadingModal();
            showExportSuccessModal(format.toUpperCase());
            
          } catch (error) {
            console.error('Error generating comprehensive audit report:', error);
            hideExportLoadingModal();
            alert('Failed to generate audit report: ' + error.message);
          }
