        // Function to check if EIU user has active projects
        window.checkEIUActiveProjects = async function(userId, userName) {
          try {
            const token = localStorage.getItem('token');
            if (!token) {
              console.error('No authentication token found');
              return { hasActiveProjects: false, projects: [] };
            }

            // Fetch projects assigned to this EIU user
            // Note: The projects API filters by eiuPersonnelId when the user role is EIU
            // We need to use a different approach - fetch all projects and filter client-side
            // OR create a backend endpoint to get projects by EIU user ID
            // For now, we'll fetch projects and filter by eiuPersonnelId
            const apiUrl = window.getApiUrl();
            const response = await fetch(`${apiUrl}/projects?limit=1000`, {
              headers: {
                'Authorization': `Bearer ${token}`
              }
            });

            if (!response.ok) {
              console.error('Failed to fetch projects for EIU user');
              return { hasActiveProjects: false, projects: [] };
            }

            const data = await response.json();
            if (!data.success || !data.projects) {
              return { hasActiveProjects: false, projects: [] };
            }

            // Filter projects assigned to this EIU user
            const eiuProjects = data.projects.filter(project => {
              return project.eiuPersonnelId === userId || 
                     (project.eiuPersonnel && project.eiuPersonnel.id === userId);
            });

            // Filter for active projects (not Complete or Cancelled)
            const activeProjects = eiuProjects.filter(project => {
              const status = project.status?.toLowerCase();
              return status !== 'complete' && status !== 'cancelled' && status !== 'archived';
            });

            return {
              hasActiveProjects: activeProjects.length > 0,
              projects: activeProjects
            };
          } catch (error) {
            console.error('Error checking EIU active projects:', error);
            return { hasActiveProjects: false, projects: [] };
          }
        };

