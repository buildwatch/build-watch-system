              </div>
              <div>
                <h3 class="text-xl font-bold text-black">Gmail Feedback Users</h3>
                <p class="text-sm text-gray-600">Users who logged in via Google to provide feedback on public projects</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
