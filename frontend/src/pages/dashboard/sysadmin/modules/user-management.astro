              options: Array.from(statusFilterEl?.options || []).map(opt => ({ value: opt.value, text: opt.text, selected: opt.selected }))
            },
            departmentFilterEl: {
              value: departmentFilterEl?.value,
              selectedIndex: departmentFilterEl?.selectedIndex,
              selectedOptions: departmentFilterEl?.selectedOptions?.[0]?.text
            },
            groupFilterEl: {
              value: groupFilterEl?.value,
              selectedIndex: groupFilterEl?.selectedIndex,
              selectedOptions: groupFilterEl?.selectedOptions?.[0]?.text,
              options: Array.from(groupFilterEl?.options || []).map(opt => ({ value: opt.value, text: opt.text, selected: opt.selected }))
            }
          });
          
          // FIX: If groupFilter is empty but there's a selected option, get the text value
          if (!groupFilter && groupFilterEl && groupFilterEl.selectedIndex > 0) {
            const selectedOption = groupFilterEl.options[groupFilterEl.selectedIndex];
            if (selectedOption) {
              groupFilter = selectedOption.value || selectedOption.text;
              console.log('🔧 FIX: Group filter was empty, using selected option:', {
                value: selectedOption.value,
                text: selectedOption.text,
                finalGroupFilter: groupFilter
              });
            }
          }
          
          // Same fix for department filter
          let finalDepartmentFilter = departmentFilter;
          if (!finalDepartmentFilter && departmentFilterEl && departmentFilterEl.selectedIndex > 0) {
            const selectedOption = departmentFilterEl.options[departmentFilterEl.selectedIndex];
            if (selectedOption) {
              finalDepartmentFilter = selectedOption.value || selectedOption.text;
              console.log('🔧 FIX: Department filter was empty, using selected option:', {
                value: selectedOption.value,
                text: selectedOption.text,
                finalDepartmentFilter: finalDepartmentFilter
              });
            }
          }
          
          // DEBUG: Log final filter values
          console.log('📊 DEBUG: Final filter values:', { 
            statusFilter, 
            departmentFilter: finalDepartmentFilter, 
            groupFilter, 
            searchTerm, 
            sortBy,
            totalUsers: historyUsers.length 
          });
          
          // DEBUG: Log ALL user data for debugging
          console.log('👥 DEBUG: ALL users before filtering:', historyUsers.map(u => ({
            name: u.name,
            group: u.group,
            department: u.department,
            status: u.status
          })));
          
          // Filter users
          const beforeFilterCount = historyUsers.length;
          filteredHistoryUsers = historyUsers.filter((user, index) => {
            let passed = true;
            const reasons = [];
            
            // Status filter - check if status matches
            if (statusFilter && statusFilter !== '' && statusFilter !== 'Show All') {
              // The filter value is already in the correct format (e.g., "recently-deleted", "permanently-deleted")
              const expectedStatus = statusFilter.toLowerCase();
              const userStatus = (user.status || 'permanently-deleted').toLowerCase();
              
              if (userStatus !== expectedStatus) {
                passed = false;
                reasons.push(`Status mismatch: filter="${expectedStatus}" vs user="${userStatus}"`);
              }
            }
            
            // Department filter - exact match (case-sensitive)
            if (finalDepartmentFilter && finalDepartmentFilter !== '' && finalDepartmentFilter !== 'All Departments' && passed) {
              const userDept = (user.department || '').trim();
              const filterDept = finalDepartmentFilter.trim();
              console.log(`🔍 DEBUG: Department check - filter:"${filterDept}" vs user:"${userDept}"`);
              if (userDept !== filterDept) {
                passed = false;
                reasons.push(`Department mismatch: filter="${filterDept}" vs user="${userDept}"`);
              }
            }
            
            // Group filter - exact match (case-sensitive)
            if (groupFilter && groupFilter !== '' && groupFilter !== 'All Groups' && passed) {
              const userGroup = (user.group || '').trim();
              const filterGroup = groupFilter.trim();
              console.log(`🔍 DEBUG: Group check - filter:"${filterGroup}" vs user:"${userGroup}"`);
              if (userGroup !== filterGroup) {
                passed = false;
                reasons.push(`Group mismatch: filter="${filterGroup}" vs user="${userGroup}"`);
              }
            }
            
            // Search filter - search across multiple fields
            if (searchTerm && passed) {
              const searchFields = [
                user.name || '',
                user.email || '',
                user.userId || '',
                user.group || '',
                user.department || ''
              ].map(field => field.toLowerCase().trim());
              
              const matches = searchFields.some(field => field.includes(searchTerm));
              if (!matches) {
                passed = false;
                reasons.push(`Search term "${searchTerm}" not found in: ${searchFields.join(', ')}`);
              }
            }
            
            // DEBUG: Log filtering details for ALL users
            console.log(`🔍 DEBUG: User ${index + 1} (${user.name || 'Unknown'}):`, {
              passed,
              group: user.group,
              department: user.department,
              status: user.status,
              reasons: reasons.length > 0 ? reasons : ['All filters passed']
            });
            
            return passed;
          });
          
          const afterFilterCount = filteredHistoryUsers.length;
          console.log(`✅ DEBUG: Filtering complete: ${beforeFilterCount} → ${afterFilterCount} users`);
          
          if (afterFilterCount === 0 && beforeFilterCount > 0) {
            console.log('ℹ️  No users match the current filters. This is expected if filters are restrictive.');
