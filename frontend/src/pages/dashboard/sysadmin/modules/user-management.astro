        window.showRestoreUserModal = function(userId, userName = '') {
          // Remove any existing restore modal first
          const existingModal = document.getElementById('restoreUserModal');
          if (existingModal) {
            existingModal.remove();
          }

          // Create modal HTML
          const modalHTML = `
            <div id="restoreUserModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
              <div class="bg-white rounded-2xl p-8 max-w-md w-full mx-4" onclick="event.stopPropagation()">
                <div class="flex items-center justify-between mb-6">
                  <h3 class="text-xl font-bold text-gray-900">Restore User</h3>
                  <button id="closeRestoreUserModal" class="text-gray-400 hover:text-gray-600 transition-colors" type="button">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                </div>
                
                <p class="text-gray-600 mb-6">Are you sure you want to restore <strong>${userName || 'this user'}</strong>? The user will be reactivated and can log in again.</p>
                
                <div class="flex gap-3 pt-4">
                  <button id="cancelRestoreUser" type="button" class="btn-action flex-1 px-6 py-3 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 hover:shadow-gray-500/25">
                    Cancel
                  </button>
                  <button id="confirmRestoreUser" type="button" class="btn-action flex-1 px-6 py-3 rounded-lg bg-green-600 text-white hover:bg-green-700 hover:shadow-green-500/25">
                    Restore User
                  </button>
                </div>
              </div>
            </div>
          `;
          
          // Add modal to page
          document.body.insertAdjacentHTML('beforeend', modalHTML);
          
          // Wait for DOM to update, then get elements
          setTimeout(() => {
            const modal = document.getElementById('restoreUserModal');
            const closeBtn = document.getElementById('closeRestoreUserModal');
            const cancelBtn = document.getElementById('cancelRestoreUser');
            const confirmBtn = document.getElementById('confirmRestoreUser');
            
            if (!modal || !closeBtn || !cancelBtn || !confirmBtn) {
              console.error('❌ Failed to find restore modal elements');
              return;
            }
            
            // Close modal function
            const closeModal = () => {
              console.log('🔒 Closing restore user modal');
              if (modal) {
                modal.remove();
              }
            };
            
            // Event listeners
            closeBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              closeModal();
            });
            
            cancelBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              closeModal();
            });
            
            // Close on background click
            modal.addEventListener('click', (e) => {
              if (e.target === modal) {
                closeModal();
              }
            });
            
            // Escape key to close
            const escapeHandler = (e) => {
              if (e.key === 'Escape' && modal && document.body.contains(modal)) {
                closeModal();
                document.removeEventListener('keydown', escapeHandler);
              }
            };
            document.addEventListener('keydown', escapeHandler);
            
            // Confirm restore
            confirmBtn.addEventListener('click', async () => {
              try {
                const token = localStorage.getItem('token') || '';
                const res = await fetch(`http://localhost:3000/api/users/${userId}/restore`, {
                  method: 'PUT',
                  headers: {
                    'Authorization': `Bearer ${token}`
                  }
                });
                const data = await res.json();
                if (res.ok && data.success) {
                  // Close confirmation modal
                  closeModal();
                  // Show success modal
                  window.showRestoreSuccessModal(userName);
                } else {
                  alert('Failed to restore user: ' + (data.error || 'Unknown error'));
                }
              } catch (err) {
                alert('Failed to restore user: ' + err.message);
              }
            });
          }, 10);
        };

