                        <div class="text-sm font-medium text-gray-900">{user.role}</div>
                      </td>
                      <td class="px-6 py-4">
                        <div class="text-sm text-gray-600">{user.subRole || '-'}</div>
                      </td>
                      <td class="px-6 py-4">
                        <div class="text-sm text-gray-600">{user.externalCompanyName || (user.group === 'EIU' ? 'N/A' : '-')}</div>
