          });
          
          // Get filter values - CRITICAL: Check both value and selectedIndex
          const statusFilter = statusFilterEl?.value || '';
          const departmentFilter = departmentFilterEl?.value || '';
          let groupFilter = groupFilterEl?.value || '';
          const searchTerm = (searchInputEl?.value || '').trim().toLowerCase();
          const sortBy = sortFilterEl?.value || 'date-newest';
          
          // DEBUG: Log raw filter element values
          console.log('📊 DEBUG: Raw filter element values:', {
            statusFilterEl: {
              value: statusFilterEl?.value,
