            isModified = true;
          }
          if (contactNumber !== origContactNumber) {
            console.log(`🔍 [BUTTON STATE DEBUG] Field contactNumber changed: "${origContactNumber}" -> "${contactNumber}"`);
            isModified = true;
          }
          if (profilePhotoChanged) {
            console.log('🔍 [BUTTON STATE DEBUG] Profile photo has been changed');
            isModified = true;
          }
          
          console.log('🔍 [BUTTON STATE DEBUG] Form modified:', isModified);
          console.log('🔍 [BUTTON STATE DEBUG] Original values:', originalFormValues);
