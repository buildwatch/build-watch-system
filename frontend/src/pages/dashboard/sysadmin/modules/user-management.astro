                                onclick="if (typeof window.showActivityHistory === 'function') { const btn = this; const userId = btn.getAttribute('data-user-id'); const userName = btn.getAttribute('data-user-name'); const commentCount = parseInt(btn.getAttribute('data-comment-count')); window.showActivityHistory(userId, userName, commentCount); } else { console.error('showActivityHistory function not available'); alert('Activity history feature is loading. Please try again in a moment.'); }"
                                data-user-id={user.id}
                                data-user-name={user.name || user.email}
                                data-comment-count={user.commentCount}
                                class="text-left font-medium text-blue-600 hover:text-blue-700 hover:underline cursor-pointer"
                                title="Click to view activity history"
                              >
                                {user.commentCount} comment{user.commentCount !== 1 ? 's' : ''} posted
                              </button>
                              {user.latestActivity && (
                                <span class="text-xs text-gray-500">
                                  Latest: {formatDate(user.latestActivity.date)}
                                  {user.latestActivity.isDeleted && (
                                    <span class="text-red-600 ml-1">(Deleted)</span>
                                  )}
                                </span>
                              )}
                            </div>
                          ) : (
                            <span class="text-gray-400">No activity yet</span>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </div>

        <!-- History of Deleted Comments Section -->
        <div class="profile-card mt-8">
          <!-- Header -->
          <div class="bg-gradient-to-r from-red-50 to-orange-50 border-b border-gray-200 px-6 py-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
