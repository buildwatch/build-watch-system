            const backdrop = document.getElementById('downloadFormatBackdrop');
            const modalContent = document.getElementById('downloadFormatContent');
            
            let isClosing = false;
            let resolved = false;
            
            const closeModal = (result = null) => {
              if (isClosing || resolved) {
                return;
              }
              
              isClosing = true;
              resolved = true;
              
              // Resolve the promise immediately
              resolve(result);
              
              // Animate and remove
              if (backdrop) {
                backdrop.style.animation = 'fadeOut 0.2s ease-out';
                backdrop.style.opacity = '0';
              }
              
              setTimeout(() => {
                if (document.body.contains(modal)) {
                  document.body.removeChild(modal);
                }
              }, 200);
            };

            // Wait for DOM to be ready before attaching listeners
            setTimeout(() => {
              const selectHTMLBtn = modal.querySelector('#selectHTML');
              const selectPDFBtn = modal.querySelector('#selectPDF');
              const selectExcelBtn = modal.querySelector('#selectExcel');
              const cancelBtn = modal.querySelector('#cancelFormat');
              const closeBtn = modal.querySelector('#closeModal');
              
              // Handle button clicks - prevent event bubbling
              const handleButtonClick = (result) => {
                return function(e) {
                  e.preventDefault();
                  e.stopPropagation();
                  e.stopImmediatePropagation();
                  
                  if (!isClosing && !resolved) {
                    closeModal(result);
                  }
                };
              };
              
              if (selectHTMLBtn) {
                selectHTMLBtn.onclick = handleButtonClick('html');
              }
              
              if (selectPDFBtn) {
                selectPDFBtn.onclick = handleButtonClick('pdf');
              }
              
              if (selectExcelBtn) {
                selectExcelBtn.onclick = handleButtonClick('excel');
              }
              
              if (cancelBtn) {
                cancelBtn.onclick = handleButtonClick(null);
              }

              if (closeBtn) {
                closeBtn.onclick = handleButtonClick(null);
              }
              
              // Prevent clicks on modal content from closing the modal
              if (modalContent) {
                modalContent.addEventListener('click', (e) => {
                  e.stopPropagation();
                });
              }
              
              // Close modal when clicking on backdrop (but not on modal content)
              if (backdrop) {
                backdrop.addEventListener('click', (e) => {
                  // Only close if clicking directly on the backdrop, not on child elements
                  if (e.target === backdrop && !isClosing && !resolved) {
                    e.preventDefault();
                    e.stopPropagation();
                    closeModal(null);
                  }
                });
              }
            }, 10);

            // Add fadeOut animation to styles
            const style = modal.querySelector('style');
            style.textContent += `
              @keyframes fadeOut {
                from { opacity: 1; }
                to { opacity: 0; }
              }
            `;
          });
