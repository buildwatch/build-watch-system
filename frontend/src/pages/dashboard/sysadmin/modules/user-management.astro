        // Export functions for Main Users
        function exportMainUsersExcel(users) {
          const csvHeader = 'Full Name,Email,Contact Number,Birthdate,Group,Office/Department,Role,Subrole\n';
          const csvData = users.map(user => {
            const fullName = (user.fullName || user.name || 'N/A').replace(/"/g, '""');
            const email = (user.email || 'N/A').replace(/"/g, '""');
            const contact = (user.contactNumber || 'N/A').replace(/"/g, '""');
            const birthdate = user.birthdate ? new Date(user.birthdate).toLocaleDateString() : 'N/A';
            const group = (user.group || 'N/A').replace(/"/g, '""');
            const department = (user.department || 'N/A').replace(/"/g, '""');
            const role = (user.role || 'N/A').replace(/"/g, '""');
            const subrole = (user.subRole || 'N/A').replace(/"/g, '""');
            
            return `"${fullName}","${email}","${contact}","${birthdate}","${group}","${department}","${role}","${subrole}"`;
          }).join('\n');
          
          const csvContent = csvHeader + csvData;
          const blob = new Blob(['\ufeff' + csvContent], { type: 'text/csv;charset=utf-8;' });
          const link = document.createElement('a');
          const url = URL.createObjectURL(blob);
          const currentDate = new Date().toISOString().split('T')[0];
          link.setAttribute('href', url);
          link.setAttribute('download', `users-export-${currentDate}.csv`);
          link.style.visibility = 'hidden';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        }

        async function exportMainUsersPDF(users) {
          const loaded = await loadJsPDFLibrary();
          if (!loaded) {
            alert('Failed to load PDF library. Please use Excel or HTML format.');
            return;
          }
          
          let jsPDF = window.jsPDF?.jsPDF || window.jsPDF || window.jspdf?.jsPDF || window.jspdf;
          if (!jsPDF || typeof jsPDF !== 'function') {
            alert('PDF library failed to initialize. Please use Excel or HTML format.');
            return;
          }
          
          const doc = new jsPDF('l', 'mm', 'a4');
          doc.setFontSize(16);
          doc.text('User Management Report', 14, 15);
          doc.setFontSize(10);
          doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 22);
          doc.text(`Total Users: ${users.length}`, 14, 27);
          
          const headers = [['Full Name', 'Email', 'Contact', 'Group', 'Department', 'Role']];
          const tableData = users.map(user => [
            (user.fullName || user.name || 'N/A').substring(0, 20),
            (user.email || 'N/A').substring(0, 25),
            (user.contactNumber || 'N/A').substring(0, 15),
            (user.group || 'N/A').substring(0, 15),
            (user.department || 'N/A').substring(0, 20),
            (user.role || 'N/A').substring(0, 15)
          ]);
          
          if (doc.autoTable) {
            doc.autoTable({
              head: headers,
              body: tableData,
              startY: 35,
              styles: { fontSize: 7, cellPadding: 2 },
              headStyles: { fillColor: [0, 0, 0], textColor: [255, 255, 255], fontStyle: 'bold' },
              alternateRowStyles: { fillColor: [245, 245, 245] }
            });
          }
          
          const currentDate = new Date().toISOString().split('T')[0];
          doc.save(`users-export-${currentDate}.pdf`);
        }

