                  // Update cache
                  const elementUserId = img.id.replace('profile-img-', '');
                  profilePictureCache.set(elementUserId, profilePictureUrl);
                  
                  // Preload and update
                  const preloadImg = new Image();
                  preloadImg.onload = function() {
                    const profileImg = row.querySelector('[id^="profile-img-"]');
                    if (profileImg) {
                      // Hide fallback before updating
                      const fallback = profileImg.nextElementSibling;
                      if (fallback && fallback.classList.contains('profile-picture-fallback')) {
                        fallback.style.display = 'none';
                      }
                      
                      // Update src
                      profileImg.src = profilePictureUrl;
                      profileImg.style.display = 'block';
                      console.log(`✅ User Management: Profile picture updated via fallback method for ${elementUserId}`);
                      updated = true;
                    }
                  };
                  preloadImg.onerror = function() {
                    console.log(`⚠️ Failed to preload image for element ${index + 1}`);
                    // Still try to update
                    const profileImg = row.querySelector('[id^="profile-img-"]');
                    if (profileImg) {
                      profileImg.src = profilePictureUrl;
                      profileImg.style.display = 'block';
                      const fallback = profileImg.nextElementSibling;
                      if (fallback && fallback.classList.contains('profile-picture-fallback')) {
                        fallback.style.display = 'none';
                      }
                    }
                  };
                  preloadImg.src = profilePictureUrl;
                }
              }
            });
            
            if (!updated) {
              console.log('❌ User Management: Could not find matching profile picture element even with fallback search');
              console.log('💡 Debugging info:', {
                searchedUserIds: validUserIds,
                userDataEmail: userData?.email,
                userDataUsername: userData?.username,
                userDataUserId: userData?.userId,
                totalElementsFound: allProfileImgs.length
              });
            }
          }
        }

        // Listen for generic profile picture updates
        window.addEventListener('profilePictureUpdated', function(event) {
          const { profilePictureUrl, userId, userData } = event.detail;
          console.log('🔄 User Management: Generic profilePictureUpdated event received', { userId, email: userData?.email });
          updateUserManagementProfilePicture(profilePictureUrl, userId, userData);
        });

        // Listen for EIU profile picture updates
        window.addEventListener('eiuProfilePictureUpdated', function(event) {
          const { profilePictureUrl, userId, userData } = event.detail;
          console.log('🔄 User Management: EIU profile picture update received', { userId, email: userData?.email });
          updateUserManagementProfilePicture(profilePictureUrl, userId, userData);
        });

        // Listen for LGU-IU profile picture updates
        window.addEventListener('iuProfilePictureUpdated', function(event) {
          const { profilePictureUrl, userId, userData } = event.detail;
          console.log('🔄 User Management: LGU-IU profile picture update received', { 
            userId, 
            email: userData?.email,
            userDataUserId: userData?.userId,
            profilePictureUrl: profilePictureUrl ? profilePictureUrl.substring(0, 50) + '...' : 'null'
          });
          updateUserManagementProfilePicture(profilePictureUrl, userId, userData);
        });
        
        // CRITICAL: Listen for localStorage changes (works across tabs/windows)
        window.addEventListener('storage', function(e) {
          // Check if it's a profile picture update
          if (e.key === 'iu_profile_picture' || e.key === 'lgu_iu_profile_picture') {
            console.log('🔄 User Management: Profile picture updated in localStorage (cross-tab)', {
              key: e.key,
              newValue: e.newValue ? e.newValue.substring(0, 50) + '...' : 'null'
            });
            
            // Get user data from localStorage to find the user
            const userDataStr = localStorage.getItem('user');
            if (userDataStr) {
              try {
                const userData = JSON.parse(userDataStr);
                // Only process if it's an LGU-IU user
                if (userData.role === 'LGU-IU' || userData.role === 'IU') {
                  const profilePictureUrl = e.newValue;
                  const userId = userData.userId || userData.id;
                  
                  console.log('🔄 User Management: Processing localStorage update for LGU-IU user', {
                    userId,
                    email: userData.email
                  });
                  
                  updateUserManagementProfilePicture(profilePictureUrl, userId, userData);
                }
              } catch (error) {
                console.log('⚠️ Error parsing user data from localStorage:', error);
              }
            }
          }
        });
        
        // Also listen for custom storage event (dispatched when profile picture is updated)
        window.addEventListener('profilePictureStorageUpdated', function(e) {
          console.log('🔄 User Management: Custom storage event received', e.detail);
          const { profilePictureUrl, userId, userData } = e.detail;
          updateUserManagementProfilePicture(profilePictureUrl, userId, userData);
        });

        // Listen for MPMEC profile picture updates
        window.addEventListener('mpmecProfilePictureUpdated', function(event) {
          const { profilePictureUrl, userId, userData } = event.detail;
          console.log('🔄 User Management: MPMEC profile picture update received');
          updateUserManagementProfilePicture(profilePictureUrl, userId, userData);
        });

        // Listen for Secretariat profile picture updates
        window.addEventListener('secretariatProfilePictureUpdated', function(event) {
          const { profilePictureUrl, userId, userData } = event.detail;
          console.log('🔄 User Management: Secretariat profile picture update received');
          updateUserManagementProfilePicture(profilePictureUrl, userId, userData);
        });

        // Listen for Executive Viewer profile picture updates
        window.addEventListener('executiveProfilePictureUpdated', function(event) {
          const { profilePictureUrl, userId, userData } = event.detail;
          console.log('🔄 User Management: Executive Viewer profile picture update received');
          updateUserManagementProfilePicture(profilePictureUrl, userId, userData);
        });

        // Listen for System Admin profile picture updates
        window.addEventListener('sysadminProfilePictureUpdated', function(event) {
          const { profilePictureUrl, userId, userData } = event.detail;
          console.log('🔄 User Management: System Admin profile picture update received');
          updateUserManagementProfilePicture(profilePictureUrl, userId, userData);
        });

      </script>
      
      <!-- Global Profile Picture Updater -->
      <script src="/src/scripts/global-profile-picture-updater.js"></script>
    </section>
  </SysAdminLayout>
</Layout>


