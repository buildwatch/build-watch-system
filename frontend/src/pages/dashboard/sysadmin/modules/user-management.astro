        function updateUserManagementProfilePicture(profilePictureUrl, userId, userData) {
          if (!profilePictureUrl) {
            console.log('⚠️ User Management: No profile picture URL provided');
            return;
          }

          // Get all possible userId formats from userData or use provided userId
          const possibleUserIds = [];
          if (userData) {
            // Priority: userId (like LGU-IU-0001) > id > employeeId > username > email
            possibleUserIds.push(
              userData.userId,        // Primary: LGU-IU-0001, EIU-0001, etc.
              userData.id,            // Database ID
              userData.employeeId,    // Employee ID
              userData.username,      // Username
              userData.email          // Email
            );
          }
          if (userId) {
            possibleUserIds.push(userId);
          }
          
          // Filter out null/undefined values and remove duplicates
          const validUserIds = [...new Set(possibleUserIds.filter(id => id != null && id !== ''))];
          
          console.log('🔄 User Management: Profile picture update received', {
            profilePictureUrl: profilePictureUrl.substring(0, 50) + '...',
            userId,
            possibleUserIds: validUserIds,
            userData: userData ? { userId: userData.userId, employeeId: userData.employeeId, username: userData.username, email: userData.email } : null
          });

