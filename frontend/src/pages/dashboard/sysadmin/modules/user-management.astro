            // Get full user data from backend if available
            const backendUser = window.deletedUsersHistory?.find(u => u.id === userIdOrUser || u.userId === userIdOrUser);
            if (backendUser) {
              user = {
                ...user,
                ...backendUser,
                deletedAt: backendUser.permanentDeletedAt || backendUser.deletedAt || user.deletedAt,
                deletedByUser: backendUser.deletedByUser || 'System Administrator'
              };
