                // More strict regex: requires proper domain structure
                const strictEmailRegex = /^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?@[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?\.[a-zA-Z]{2,}$/;
                
                if (!email) {
                  return; // Don't check if empty
                }
                
                // Quick format check
                if (email.length < 5 || email.length > 254 || email.includes('..') || email.startsWith('.') || email.endsWith('.')) {
                  if (usernameError) {
                    usernameError.textContent = 'Please enter a valid email address.';
                    usernameError.classList.remove('hidden');
