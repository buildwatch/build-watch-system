        // Real-time Socket.IO updates for deleted comments
        (async function initFeedbackSocket() {
          try {
            // Import socket.io-client dynamically
            const { io } = await import('socket.io-client');
            
            // Determine Socket.IO URL
            const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
            const socketUrl = isProd 
              ? `${window.location.protocol}//${window.location.hostname}:3000`
              : 'http://localhost:3000';
            
            console.log('🔌 Connecting to feedback Socket.IO for admin dashboard:', `${socketUrl}/feedback`);
            
            // Connect to feedback namespace (no auth required for admin dashboard)
            const adminSocket = io(`${socketUrl}/feedback`, {
              transports: ['websocket', 'polling'],
              reconnection: true,
              reconnectionDelay: 1000,
              reconnectionAttempts: 5
            });
            
            adminSocket.on('connect', () => {
              console.log('✅ Admin Socket.IO connected');
              // Join admin room
              adminSocket.emit('join_admin');
              console.log('✅ Joined admin_dashboard room');
            });
            
            adminSocket.on('disconnect', (reason) => {
              console.warn('⚠️ Admin Socket.IO disconnected:', reason);
