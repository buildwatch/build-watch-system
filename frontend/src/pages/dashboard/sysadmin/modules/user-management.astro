          const origFirstName = originalFormValues.firstName || '';
          const origMiddleName = originalFormValues.middleName || '';
          const origLastName = originalFormValues.lastName || '';
          const origUsername = originalFormValues.username || '';
          const origContactNumber = originalFormValues.contactNumber || '';
          
          if (firstName !== origFirstName) {
            console.log(`🔍 [BUTTON STATE DEBUG] Field firstName changed: "${origFirstName}" -> "${firstName}"`);
