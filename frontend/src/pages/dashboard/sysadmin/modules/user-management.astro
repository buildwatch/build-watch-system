              ? (window.location.protocol === 'https:' 
                  ? `${window.location.protocol}//${window.location.hostname}/api/project-comments`
                  : `http://${window.location.hostname}:3000/api/project-comments`)
              : 'http://localhost:3000/api/project-comments';

