        // Global password modal function
        // Function to get and manage attempt tracking for UUID reveal
        window.getUuidAttempts = function(userId) {
          const key = `uuid_attempts_${userId}`;
          const lockoutKey = `uuid_lockout_${userId}`;
          const attempts = JSON.parse(localStorage.getItem(key) || '{"count": 0, "lastAttempt": null}');
          const lockout = JSON.parse(localStorage.getItem(lockoutKey) || '{"locked": false, "until": null}');
          return { attempts, lockout };
        };

        window.recordUuidAttempt = function(userId, success) {
          const key = `uuid_attempts_${userId}`;
          const lockoutKey = `uuid_lockout_${userId}`;
          const data = JSON.parse(localStorage.getItem(key) || '{"count": 0, "lastAttempt": null}');
          
          if (success) {
            // Reset attempts on success
            localStorage.removeItem(key);
            localStorage.removeItem(lockoutKey);
            return { attempts: 0, isLocked: false };
          } else {
            // Increment failed attempts
            data.count = (data.count || 0) + 1;
            data.lastAttempt = new Date().toISOString();
            localStorage.setItem(key, JSON.stringify(data));
            
            // Check if should lock (5 attempts)
            if (data.count >= 5) {
              const lockUntil = new Date();
              lockUntil.setHours(lockUntil.getHours() + 24);
              localStorage.setItem(lockoutKey, JSON.stringify({
                locked: true,
                until: lockUntil.toISOString()
              }));
              return { attempts: data.count, isLocked: true, lockUntil: lockUntil.toISOString() };
            }
            
            return { attempts: data.count, isLocked: false };
          }
        };

        window.isUuidLocked = function(userId) {
          const lockoutKey = `uuid_lockout_${userId}`;
          const lockout = JSON.parse(localStorage.getItem(lockoutKey) || '{"locked": false, "until": null}');
          
          if (!lockout.locked || !lockout.until) {
            return false;
          }
          
          const lockUntil = new Date(lockout.until);
          const now = new Date();
          
          if (now >= lockUntil) {
            // Lockout expired, clear it
            localStorage.removeItem(lockoutKey);
            localStorage.removeItem(`uuid_attempts_${userId}`);
            return false;
          }
          
          return { locked: true, until: lockUntil };
        };

