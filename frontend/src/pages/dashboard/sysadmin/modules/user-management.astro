            // CRITICAL: Always load from server (server is source of truth)
            // Use full backend URL with userId (like sidebar/topbar)
            async function loadFromServer() {
              try {
                // CRITICAL: Use userId (like LGU-IU-0001) as primary identifier
                console.log(`🌐 [MAIN] Fetching profile picture from server for userId: ${userId}`);
