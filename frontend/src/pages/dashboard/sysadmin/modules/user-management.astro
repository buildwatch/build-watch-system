                    <tr key={user.id} class={`border-b border-gray-200 hover:bg-gradient-to-r hover:from-gray-50 hover:to-gray-100/50 transition-all duration-200 ${isProtected ? 'bg-gradient-to-r from-blue-50 to-blue-100/50' : ''}`}>
