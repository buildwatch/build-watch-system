      <script>
        // ==================== USER STATISTICS DASHBOARD ====================
        
        // Event listener for View Statistics button
        document.getElementById('viewUserStatisticsBtn')?.addEventListener('click', function() {
          showUserStatisticsModal();
        });
        
        // Show statistics modal
        window.showUserStatisticsModal = function() {
          const modal = document.getElementById('userStatisticsModal');
          if (modal) {
            modal.classList.remove('hidden');
            loadUserStatistics();
          }
        };
        
        // Close statistics modal
        window.closeUserStatisticsModal = function() {
          const modal = document.getElementById('userStatisticsModal');
          if (modal) {
            modal.classList.add('hidden');
            // Destroy all charts to prevent memory leaks
            Object.values(window.userStatisticsCharts).forEach(chart => {
              if (chart && typeof chart.destroy === 'function') {
                chart.destroy();
              }
            });
            window.userStatisticsCharts = {};
          }
        };
        
        // Load Chart.js dynamically
        function loadChartJS() {
          return new Promise((resolve, reject) => {
            if (window.Chart) {
              resolve(window.Chart);
              return;
            }
            
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
            script.onload = () => resolve(window.Chart);
            script.onerror = () => reject(new Error('Failed to load Chart.js'));
            document.head.appendChild(script);
          });
        }
        
        // Load user statistics
        async function loadUserStatistics() {
          const loading = document.getElementById('userStatisticsLoading');
          const content = document.getElementById('userStatisticsContent');
          const timeRange = document.getElementById('userStatisticsTimeRange')?.value || 'all';
          
          if (loading) loading.classList.remove('hidden');
          if (content) content.classList.add('hidden');
          
          try {
            const Chart = await loadChartJS();
            const users = window.mainUsersData || [];
            
            // Filter users by time range
            let filteredUsers = users;
            if (timeRange !== 'all') {
              const days = parseInt(timeRange);
              const cutoffDate = new Date();
              cutoffDate.setDate(cutoffDate.getDate() - days);
              filteredUsers = users.filter(user => {
                const createdAt = user.createdAt ? new Date(user.createdAt) : null;
                return createdAt && createdAt >= cutoffDate;
              });
            }
            
            // Process statistics data
            const stats = processUserStatisticsData(filteredUsers, timeRange);
            
            // Render all charts
            renderAllUserCharts(Chart, stats, timeRange);
            
            if (loading) loading.classList.add('hidden');
            if (content) content.classList.remove('hidden');
          } catch (error) {
            console.error('Error loading user statistics:', error);
            if (loading) loading.classList.add('hidden');
            if (content) {
              content.innerHTML = '<div class="text-center py-12 text-red-600">Failed to load statistics. Please try again.</div>';
              content.classList.remove('hidden');
            }
          }
        }
        
        // Process user statistics data
        function processUserStatisticsData(users, timeRange) {
          // User growth over time
          const growthData = {};
          users.forEach(user => {
            if (user.createdAt) {
              const date = new Date(user.createdAt);
              const key = date.toISOString().split('T')[0]; // YYYY-MM-DD
              growthData[key] = (growthData[key] || 0) + 1;
            }
          });
          
          // Sort by date
          const sortedDates = Object.keys(growthData).sort();
          let cumulative = 0;
          const growthTrends = {
            labels: sortedDates.map(date => {
              const d = new Date(date);
              return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            }),
            data: sortedDates.map(date => {
              cumulative += growthData[date];
              return cumulative;
            })
          };
          
          // User distribution by group
          const byGroup = {};
          users.forEach(user => {
            const group = user.group || 'Unknown';
            byGroup[group] = (byGroup[group] || 0) + 1;
          });
          
          // User status distribution
          const byStatus = {};
          users.forEach(user => {
            const status = user.status || 'unknown';
            byStatus[status] = (byStatus[status] || 0) + 1;
          });
          
          // User distribution by department
          const byDepartment = {};
          users.forEach(user => {
            const dept = user.department || user.officeDepartment || 'Unknown';
            byDepartment[dept] = (byDepartment[dept] || 0) + 1;
          });
          
          // Top 10 departments
          const topDepartments = Object.entries(byDepartment)
            .sort((a, b) => b[1] - a[1])
            .slice(0, 10);
          
          // Registration trends (monthly)
          const monthlyRegistrations = {};
          users.forEach(user => {
            if (user.createdAt) {
              const date = new Date(user.createdAt);
              const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
              monthlyRegistrations[key] = (monthlyRegistrations[key] || 0) + 1;
            }
          });
          
          const sortedMonths = Object.keys(monthlyRegistrations).sort();
          const registrationTrends = {
            labels: sortedMonths.map(month => {
              const [year, mon] = month.split('-');
              return new Date(year, parseInt(mon) - 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            }),
            data: sortedMonths.map(month => monthlyRegistrations[month])
          };
          
          // Active vs Inactive over time
          const activeInactiveByMonth = {};
          users.forEach(user => {
            if (user.createdAt) {
              const date = new Date(user.createdAt);
              const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
              if (!activeInactiveByMonth[key]) {
                activeInactiveByMonth[key] = { active: 0, inactive: 0 };
              }
              if (user.status === 'active') {
                activeInactiveByMonth[key].active++;
              } else {
                activeInactiveByMonth[key].inactive++;
              }
            }
          });
          
          const sortedActiveInactive = Object.keys(activeInactiveByMonth).sort();
          const activeInactiveTrends = {
            labels: sortedActiveInactive.map(month => {
              const [year, mon] = month.split('-');
              return new Date(year, parseInt(mon) - 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            }),
            active: sortedActiveInactive.map(month => activeInactiveByMonth[month].active),
            inactive: sortedActiveInactive.map(month => activeInactiveByMonth[month].inactive)
          };
          
          // User distribution by role
          const byRole = {};
          users.forEach(user => {
            const role = user.role || user.subRole || 'Unknown';
            byRole[role] = (byRole[role] || 0) + 1;
          });
          
          // Monthly activity heatmap
          const monthlyHeatmap = {};
          users.forEach(user => {
            if (user.createdAt) {
              const date = new Date(user.createdAt);
              const month = date.getMonth();
              monthlyHeatmap[month] = (monthlyHeatmap[month] || 0) + 1;
            }
          });
          
          const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
          const heatmapData = {
            labels: monthNames,
            data: monthNames.map((_, index) => monthlyHeatmap[index] || 0)
          };
          
          // Department activity
          const departmentActivity = Object.entries(byDepartment)
            .sort((a, b) => b[1] - a[1])
            .slice(0, 15);
          
          // User retention/status breakdown
          const statusBreakdown = {
            active: byStatus.active || 0,
            inactive: byStatus.inactive || 0,
            pending: byStatus.pending || 0,
            deleted: (window.deletedUsersHistory?.length || 0)
          };
          
          return {
            growthTrends,
            byGroup,
            byStatus,
            topDepartments,
            registrationTrends,
            activeInactiveTrends,
            byRole,
            heatmapData,
            departmentActivity,
            statusBreakdown
          };
        }
        
        // Render all charts
        function renderAllUserCharts(Chart, stats, timeRange) {
          // Destroy existing charts
          Object.values(window.userStatisticsCharts).forEach(chart => {
            if (chart && typeof chart.destroy === 'function') {
