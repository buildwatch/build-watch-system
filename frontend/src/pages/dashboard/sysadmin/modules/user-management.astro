        // Helper function to load jsPDF library
        async function loadJsPDFLibrary() {
          // Check if jsPDF is already available (try multiple possible names)
          if (window.jsPDF || window.jspdf || (window.jspdf && window.jspdf.jsPDF)) {
            console.log('jsPDF already loaded');
            return true;
          }
          
          console.log('Loading jsPDF library...');
          
          // Try multiple CDNs in sequence with better error handling
          const cdnUrls = [
            'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js',
            'https://unpkg.com/jspdf@2.5.1/dist/jspdf.umd.min.js',
            'https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js',
            'https://cdn.skypack.dev/jspdf@2.5.1'
          ];
          
          for (const url of cdnUrls) {
            try {
              console.log(`Trying to load jsPDF from: ${url}`);
              
              // Remove any existing script with same src to avoid duplicates
              const existingScript = document.querySelector(`script[src="${url}"]`);
              if (existingScript) {
                existingScript.remove();
              }
              
              const script = document.createElement('script');
              script.src = url;
              script.async = false;
              script.crossOrigin = 'anonymous';
              
              // Create promise for script loading
              const loadPromise = new Promise((resolve, reject) => {
                script.onload = () => {
                  console.log(`✅ jsPDF script loaded successfully from: ${url}`);
                  resolve();
                };
                script.onerror = (error) => {
                  console.error(`❌ Failed to load from ${url}:`, error);
                  if (document.head.contains(script)) {
                    document.head.removeChild(script);
                  }
                  reject(new Error(`Failed to load from ${url}`));
                };
                // Increase timeout to 10 seconds
                setTimeout(() => {
                  if (document.head.contains(script)) {
                    document.head.removeChild(script);
                  }
                  reject(new Error(`Timeout loading from ${url}`));
                }, 10000);
              });
              
              document.head.appendChild(script);
              
              // Wait for script to load
              await loadPromise;
              
              // Wait for library to initialize (UMD modules need time)
              await new Promise(resolve => setTimeout(resolve, 1000));
              
              // Check for jsPDF in multiple possible locations (UMD format)
              let jsPDF = null;
              
              // Try window.jsPDF (uppercase)
              if (window.jsPDF) {
                jsPDF = window.jsPDF.jsPDF || window.jsPDF;
                console.log('✅ Found jsPDF at window.jsPDF');
              }
              // Try window.jspdf (lowercase)
              else if (window.jspdf) {
                jsPDF = window.jspdf.jsPDF || window.jspdf;
                console.log('✅ Found jsPDF at window.jspdf');
              }
              // Try global jspdf
              else if (typeof jspdf !== 'undefined') {
                jsPDF = jspdf.jsPDF || jspdf;
                console.log('✅ Found jsPDF as global jspdf');
              }
              
              if (jsPDF && typeof jsPDF === 'function') {
                // Make it available on window for consistency
                if (!window.jsPDF) {
                  window.jsPDF = jsPDF;
                }
                console.log('✅ jsPDF is now available and ready to use');
                return true;
              } else {
                console.warn(`⚠️ jsPDF loaded but not accessible. Type: ${typeof jsPDF}`);
                // Continue to next CDN
                if (document.head.contains(script)) {
                  document.head.removeChild(script);
                }
              }
            } catch (error) {
              console.error(`❌ CDN ${url} failed:`, error.message);
              // Continue to next CDN
              continue;
            }
          }
          
          console.error('❌ Failed to load jsPDF from all CDNs');
          return false;
        }

