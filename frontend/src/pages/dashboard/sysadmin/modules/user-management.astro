                  <button id="confirmPermanentDelete" type="button" class="btn-action flex-1 px-6 py-3 rounded-lg bg-red-600 text-white hover:bg-red-700 hover:shadow-red-500/25">
                    Delete Permanently
                  </button>
                </div>
              </div>
            </div>
          `;
          
          // Add modal to page
          document.body.insertAdjacentHTML('beforeend', modalHTML);
          
          // Wait for DOM to update, then get elements
          setTimeout(() => {
            const modal = document.getElementById('permanentDeleteModal');
            const closeBtn = document.getElementById('closePermanentDeleteModal');
            const cancelBtn = document.getElementById('cancelPermanentDelete');
            const confirmBtn = document.getElementById('confirmPermanentDelete');
            
            if (!modal || !closeBtn || !cancelBtn || !confirmBtn) {
              console.error('❌ Failed to find permanent delete modal elements');
              return;
            }
            
            // Close modal function
            const closeModal = () => {
              console.log('🔒 Closing permanent delete modal');
              if (modal) {
                modal.remove();
              }
            };
            
            // Event listeners
            closeBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              closeModal();
            });
            
            cancelBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              closeModal();
            });
            
            // Close on background click
            modal.addEventListener('click', (e) => {
              if (e.target === modal) {
                closeModal();
              }
            });
            
            // Escape key to close
            const escapeHandler = (e) => {
              if (e.key === 'Escape' && modal && document.body.contains(modal)) {
                closeModal();
                document.removeEventListener('keydown', escapeHandler);
              }
            };
            document.addEventListener('keydown', escapeHandler);
            
            // Confirm permanent delete
            confirmBtn.addEventListener('click', async () => {
              try {
                const token = localStorage.getItem('token') || '';
                console.log('🔍 Frontend: Making request to:', `http://localhost:3000/api/users/${userId}/permanent-delete`);
                
                const res = await fetch(`http://localhost:3000/api/users/${userId}/permanent-delete`, {
                  method: 'DELETE',
                  headers: {
                    'Authorization': `Bearer ${token}`
                  }
                });
                
                console.log('🔍 Frontend: Response status:', res.status);
                const data = await res.json();
                console.log('🔍 Frontend: Response data:', data);
                
                if (res.ok && data.success) {
                  console.log('✅ Frontend: User deleted successfully');
                  // Close confirmation modal
                  closeModal();
                  // Show success modal
                  window.showPermanentDeleteSuccessModal(userName);
                } else {
                  console.error('❌ Frontend: Delete failed:', data.error);
                  alert(data.error || 'Failed to permanently delete user');
                }
              } catch (err) {
                console.error('❌ Frontend: Delete error:', err);
                alert('Failed to permanently delete user: ' + err.message);
              }
