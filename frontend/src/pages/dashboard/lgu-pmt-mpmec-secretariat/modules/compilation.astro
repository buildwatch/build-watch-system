                </div>
                <span class="text-sm font-medium text-gray-700">${progress.toFixed(2)}%</span>
              </div>
            </div>
          </div>
        </div>
        
        ${approvedSubmission ? renderSubmissionDetails(approvedSubmission, milestone, isDelayed, delayReason) : ''}
      </div>
    `;
  }

