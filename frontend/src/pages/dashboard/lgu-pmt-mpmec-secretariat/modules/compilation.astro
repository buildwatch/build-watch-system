              <p class="text-sm text-green-600">This milestone has been approved by LGU-IU IOO</p>
            </div>
          </div>
        </div>
        
        <!-- Milestone Details -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-4">
