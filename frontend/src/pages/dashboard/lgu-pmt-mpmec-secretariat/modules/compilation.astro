  // Function to open MilestoneSubmissionModal
  async function openMilestoneSubmissionModal(milestone) {
    console.log('🔍 Opening MilestoneSubmissionModal for milestone:', milestone);
    
    // Fetch the approved submission if available
    let approvedSubmission = null;
    if (milestone.submissions && Array.isArray(milestone.submissions)) {
      approvedSubmission = milestone.submissions.find(s => 
        s.status === 'approved' || s.status === 'iu_approved'
      );
    }
    
    // If no submission in milestone data, try to fetch it
    if (!approvedSubmission && milestone.id) {
      try {
            const API_URL = window.getApiUrl ? window.getApiUrl() : (() => {
              const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
              return isProd 
                ? `${window.location.protocol}//${window.location.hostname}/api`
                : 'http://localhost:3000/api';
            })();
        
        const token = localStorage.getItem('token');
        if (token && currentProject?.id) {
          const submissionsResponse = await fetch(`${API_URL}/milestones/milestone-submissions?projectId=${currentProject.id}`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          
          if (submissionsResponse.ok) {
            const submissionsData = await submissionsResponse.json();
            if (submissionsData.success && submissionsData.submissions) {
              approvedSubmission = submissionsData.submissions.find(s => 
                s.milestoneId === milestone.id && (s.status === 'approved' || s.status === 'iu_approved')
              );
            }
          }
        }
      } catch (error) {
        console.warn('⚠️ Could not fetch submission:', error);
      }
    }
    
    // Check if milestone has approved submissions
    const hasApprovedSubmission = !!approvedSubmission;
    
    const hasApprovedDivisions = milestone.timelineStatus === 'approved' || 
                                 milestone.budgetStatus === 'approved' || 
                                 milestone.physicalStatus === 'approved';
    
    const hasApprovedSubmissions = milestone.status === 'completed' || 
                                  milestone.status === 'approved' || 
                                  milestone.status === 'compiled_for_secretariat' ||
                                  hasApprovedSubmission ||
                                  hasApprovedDivisions;
    
    console.log('🔍 Milestone approval status:', {
      status: milestone.status,
      hasApprovedSubmission,
      hasApprovedDivisions,
      hasApprovedSubmissions,
      approvedSubmission: approvedSubmission ? approvedSubmission.id : null
    });
    
    // Check if milestone is delayed
    const isDelayed = milestone.timelineEndDate && new Date(milestone.timelineEndDate) < new Date();
    console.log('🔍 Milestone delayed status:', isDelayed, 'End date:', milestone.timelineEndDate);
    
    const modalHtml = `
      <div id="milestoneSubmissionModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden">
          <!-- Modal Header -->
          <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4 text-white">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-xl font-bold">Milestone Submission Details</h2>
                <p class="text-blue-100 text-sm mt-1">${milestone.title || 'Untitled Milestone'}</p>
              </div>
              <button onclick="closeMilestoneSubmissionModal()" class="text-white hover:text-blue-200 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          </div>
          
          <!-- Modal Content -->
          <div class="p-6 overflow-y-auto max-h-[calc(90vh-120px)]">
            ${hasApprovedSubmissions ? renderApprovedSubmissionContent(milestone, approvedSubmission, currentProject) : 
              isDelayed ? renderDelayedSubmissionContent(milestone) : renderNoSubmissionContent(milestone)}
          </div>
        </div>
      </div>
    `;
    
    // Add modal to body
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    
    // Add click outside to close
    const modal = document.getElementById('milestoneSubmissionModal');
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        closeMilestoneSubmissionModal();
      }
    });
  }

  // Helper functions for formatting
  function formatDate(dateString) {
    if (!dateString) return 'N/A';
    try {
      const date = new Date(dateString);
      return date.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
    } catch (e) {
      return dateString;
    }
  }
  
  function formatDateTime(dateString) {
    if (!dateString) return 'N/A';
    try {
      const date = new Date(dateString);
      return date.toLocaleString('en-US', { 
        year: 'numeric', 
        month: '2-digit', 
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit'
      });
    } catch (e) {
      return dateString;
    }
  }
  
  function formatCurrency(amount) {
    if (!amount && amount !== 0) return '0.00';
    const num = typeof amount === 'string' ? parseFloat(amount.replace(/[^\d.-]/g, '')) : parseFloat(amount);
    return isNaN(num) ? '0.00' : num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // Function to render approved submission content
  function renderApprovedSubmissionContent(milestone, submission = null, project = null) {
    // Get approved submission data
    const approvedSubmission = submission || (milestone.submissions?.find(s => 
      s.status === 'approved' || s.status === 'iu_approved'
    ));
    
    // Get project data for Actual Completion Date and Expected Days
    const projectData = project || currentProject;
    
    // Calculate Actual Completion Date from project or milestone
    const actualCompletionDate = projectData?.completionDate || 
                                 projectData?.actualCompletionDate || 
                                 milestone.completionDate || 
                                 milestone.actualCompletionDate || 
                                 (approvedSubmission?.submittedAt ? formatDate(approvedSubmission.submittedAt) : null);
    
    // Calculate Expected Days from project
    const expectedDays = projectData?.expectedDaysOfCompletion || 
                        milestone.expectedDaysOfCompletion || 
                        (projectData?.startDate && projectData?.targetCompletionDate ? 
                          Math.ceil((new Date(projectData.targetCompletionDate) - new Date(projectData.startDate)) / (1000 * 60 * 60 * 24)) : 
                          null);
    
    // Calculate milestone's actual progress percentage using division-based calculation
    let progress = calculateMilestoneProgress(milestone);
    
    // Ensure progress is a valid number
    progress = isNaN(progress) ? 0 : Math.max(0, Math.min(100, progress));
    
    // Check for delay information
    const delayInfo = approvedSubmission?.submitterInfo?.delayInfo || null;
    const isDelayed = delayInfo?.isDelayed || approvedSubmission?.isDelayed || false;
    const delayReason = delayInfo?.delayReason || approvedSubmission?.delayReason || null;
    
    console.log(`📊 [${milestone.title}] Modal progress calculation:`, {
      milestoneWeight: milestone.weight,
      timelineWeight: milestone.timelineWeight,
      budgetWeight: milestone.budgetWeight,
      physicalWeight: milestone.physicalWeight,
      calculatedProgress: progress,
      progressType: typeof progress,
      hasSubmission: !!approvedSubmission,
      isDelayed: isDelayed,
      hasDelayReason: !!delayReason
    });
    
    return `
