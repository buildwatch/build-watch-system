<script data-cache-bust="v27-6-cards-2x3-grid">
  // Global API URL helper function - works for both localhost and production
  window.getApiUrl = function() {
    const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
    return isProd 
      ? `${window.location.protocol}//${window.location.hostname}/api`
      : 'http://localhost:3000/api';
  };

  // Define switchTab function immediately for global access
  function switchTab(tabName) {
    console.log('🔄 switchTab called with:', tabName);
    
    // Hide all tab contents
    const summaryContent = document.getElementById('tab-content-summary');
    const summaryTab = document.getElementById('tab-summary');
    
    if (summaryContent) summaryContent.classList.add('hidden');
    
    // Remove active classes from all tabs
    if (summaryTab) {
      summaryTab.classList.remove('bg-white', 'text-sky-600', 'shadow-lg');
      summaryTab.classList.add('bg-transparent', 'text-gray-600');
    }
    
    // Show selected tab content and activate tab
    if (tabName === 'summary') {
      if (summaryContent) summaryContent.classList.remove('hidden');
      if (summaryTab) {
        summaryTab.classList.add('bg-white', 'text-sky-600', 'shadow-lg');
        summaryTab.classList.remove('bg-transparent', 'text-gray-600');
      }
      if (typeof loadCompilationData === 'function') {
        loadCompilationData();
      }
    }
  }
  
  // Make switchTab globally available immediately
  window.switchTab = switchTab;
  console.log('✅ switchTab function is now globally available');

  let currentProjectId = null;
  let currentProjectData = null;
  let currentMilestoneData = null;

  // Fetch and update budget utilized from /api/home/stats endpoint
  async function updateCompilationBudgetUtilized() {
    try {
      const token = localStorage.getItem('token') || sessionStorage.getItem('token');
      if (!token) return;
      
      // Use dynamic API URL
      const API_URL = window.getApiUrl();
      const response = await fetch(`${API_URL}/home/stats`, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });
      
      if (response.ok) {
        const data = await response.json();
        if (data.success) {
          const totalBudget = parseFloat(data.totalBudget) || 0;
          const utilizedBudget = parseFloat(data.utilizedBudget) || 0;
          const budgetUtilization = totalBudget > 0 ? (utilizedBudget / totalBudget) * 100 : 0;
          
          // Update amount
          const amountEl = document.getElementById('compilationBudgetUtilizedAmount');
          if (amountEl) {
            amountEl.textContent = `₱${utilizedBudget.toLocaleString('en-PH', { 
              minimumFractionDigits: 2, 
              maximumFractionDigits: 2 
            })}`;
          }
          
          // Update percentage
          const percentEl = document.getElementById('compilationBudgetUtilizedPercent');
          if (percentEl) {
            percentEl.textContent = `${budgetUtilization.toFixed(1)}% utilized`;
          }
          
          // Also update via stats object if it exists (for compatibility)
          if (window.updateStatsCards && typeof window.updateStatsCards === 'function') {
            const stats = {
              budgetUtilized: utilizedBudget,
              budgetUtilizedPercent: budgetUtilization.toFixed(1)
            };
            window.updateStatsCards(stats);
          }
          
          console.log('💰 Compilation Budget Utilized updated:', {
            utilizedBudget,
            utilizationPercent: budgetUtilization.toFixed(1) + '%'
          });
        }
      }
    } catch (error) {
      console.error('Error fetching compilation budget utilized:', error);
    }
  }
  
  document.addEventListener('DOMContentLoaded', function() {
    // Update budget utilized on page load
    updateCompilationBudgetUtilized();
    
    // Make function available globally
    window.updateCompilationBudgetUtilized = updateCompilationBudgetUtilized;
    const token = localStorage.getItem('token');
    const userData = localStorage.getItem('user');
    
    if (!token || !userData) {
      window.location.href = '/login/lgu-pmt';
      return;
    }
    
    try {
      const user = JSON.parse(userData);
      if (user.role !== 'LGU-PMT' || !user.subRole || !user.subRole.toLowerCase().includes('secretariat')) {
        window.location.href = '/login/lgu-pmt';
        return;
      }
    } catch (error) {
      console.error('Error parsing user data:', error);
      window.location.href = '/login/lgu-pmt';
    }

    loadCompilationData();
  });

  async function loadCompilationData() {
    console.log('🔄 loadCompilationData called');
    try {
      const token = localStorage.getItem('token');
      console.log('🔑 Token available:', !!token);
      
      // Add timeout to prevent hanging requests
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 10000); // 10 second timeout
      
      console.log('🌐 Making API request to compilation summary...');
      const API_URL = window.getApiUrl();
      const response = await fetch(`${API_URL}/projects/compilation/summary`, {
        method: 'GET',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        signal: controller.signal
      });

      clearTimeout(timeoutId);
      console.log('📡 API response status:', response.status);

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const data = await response.json();
      console.log('📊 API response data:', data);
      
      if (data.success) {
        console.log('✅ API call successful, updating stats and loading departments');
        console.log('📊 API Response data:', data);
        
        // Calculate stats from officeSummary if overallStats is missing or incomplete
        let overallStats = data.overallStats || {};
        
        if (data.officeSummary && Array.isArray(data.officeSummary) && data.officeSummary.length > 0) {
          // Calculate total departments from officeSummary
          if (!overallStats.totalDepartments || overallStats.totalDepartments === 0) {
            overallStats.totalDepartments = data.officeSummary.length;
          }
          
          // Calculate total budget from officeSummary (sum of all project budgets)
          // The backend doesn't provide totalBudget in overallStats, so we always calculate it
          overallStats.totalBudget = data.officeSummary.reduce((sum, office) => {
            // Sum budgets from all projects in this office
            const officeBudget = office.projects?.reduce((officeSum, project) => {
              const projectBudget = parseFloat(project.totalBudget || 0);
              console.log(`  - Project ${project.name || project.projectCode}: ₱${projectBudget.toLocaleString()}`);
              return officeSum + projectBudget;
            }, 0) || 0;
            console.log(`  - Office ${office.office || office.name}: ₱${officeBudget.toLocaleString()}`);
            return sum + officeBudget;
          }, 0);
          
          console.log('💰 Calculated total budget from officeSummary:', overallStats.totalBudget);
          
          // Calculate compiled reports from officeSummary
          if (overallStats.compiledReports === undefined || overallStats.compiledReports === null) {
            overallStats.compiledReports = data.officeSummary.reduce((sum, office) => {
              return sum + (office.projects?.filter(p => p.hasCompiledReport || p.status === 'compiled_for_secretariat').length || 0);
            }, 0);
          }
          
          // Calculate delayed projects from officeSummary
          if (overallStats.delayedProjects === undefined || overallStats.delayedProjects === null) {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            let delayedCount = 0;
            let delayedMilestonesCount = 0;
            
            data.officeSummary.forEach(office => {
              if (office.projects && Array.isArray(office.projects)) {
                office.projects.forEach(project => {
                  let projectHasDelayedMilestones = false;
                  
                  // Check project-level delays
                  if (project.endDate && new Date(project.endDate) < today) {
                    projectHasDelayedMilestones = true;
                  }
                  
                  // Check milestone-level delays
                  if (project.milestones && Array.isArray(project.milestones)) {
                    project.milestones.forEach(milestone => {
                      const dueDate = milestone.dueDate || milestone.deadline || milestone.targetDate || milestone.completionDate;
                      const status = milestone.status || 'pending';
                      
                      if (dueDate && status !== 'completed' && status !== 'under_approval' && status !== 'revision_request') {
                        const milestoneDate = new Date(dueDate);
                        milestoneDate.setHours(0, 0, 0, 0);
                        if (milestoneDate < today && status === 'pending') {
                          delayedMilestonesCount++;
                          projectHasDelayedMilestones = true;
                        }
                      }
                    });
                  }
                  
                  if (projectHasDelayedMilestones) {
                    delayedCount++;
                  }
                });
              }
            });
            
            overallStats.delayedProjects = delayedCount;
            overallStats.delayedMilestones = (overallStats.delayedMilestones || 0) + delayedMilestonesCount;
          }
          
          console.log('📊 Calculated stats from officeSummary:', {
            totalDepartments: overallStats.totalDepartments,
            totalBudget: overallStats.totalBudget,
            compiledReports: overallStats.compiledReports,
            delayedProjects: overallStats.delayedProjects,
            delayedMilestones: overallStats.delayedMilestones,
            officeSummaryLength: data.officeSummary.length,
            totalProjectsInOffices: data.officeSummary.reduce((sum, office) => sum + (office.projects?.length || 0), 0)
          });
        }
        
        // Always calculate totalBudget from officeSummary if not already calculated
        // The backend doesn't provide totalBudget in overallStats, so we calculate it from officeSummary
        if ((!overallStats.totalBudget || overallStats.totalBudget === 0) && data.officeSummary && Array.isArray(data.officeSummary) && data.officeSummary.length > 0) {
          overallStats.totalBudget = data.officeSummary.reduce((sum, office) => {
            const officeBudget = office.projects?.reduce((officeSum, project) => {
              return officeSum + (parseFloat(project.totalBudget || 0));
            }, 0) || 0;
            return sum + officeBudget;
          }, 0);
          console.log('💰 Calculated total budget (fallback):', overallStats.totalBudget);
        }
        
        updateOverallStats(overallStats);
        
        // Check if officeSummary has data, if not use fallback
        if (data.officeSummary && data.officeSummary.length > 0) {
          console.log('📊 Using API data for departments:', data.officeSummary.length, 'departments');
          loadDepartmentCards(data.officeSummary);
        } else {
          console.log('⚠️ API returned empty officeSummary, using fallback data');
          loadDepartmentCards(); // This will use fallback data
        }
      } else {
        console.log('❌ API returned success: false, error:', data.error);
        throw new Error(data.error || 'Failed to fetch compilation data');
      }
    } catch (error) {
      if (error.name === 'AbortError') {
        console.error('❌ API request timed out. Using fallback data.');
      } else {
        console.error('❌ Error loading compilation data:', error);
      }
      // Load fallback data
      console.log('🔄 Loading fallback department data...');
      loadDepartmentCards();
    }
  }

  function updateOverallStats(stats) {
    console.log('📊 updateOverallStats called with:', stats);
    
    // Update individual card values using IDs (more reliable)
    const totalProjectsEl = document.getElementById('totalProjects');
    if (totalProjectsEl) {
      totalProjectsEl.textContent = stats.totalProjects || 0;
    }
    
    const totalDepartmentsEl = document.getElementById('totalDepartments');
    if (totalDepartmentsEl) {
      totalDepartmentsEl.textContent = stats.totalDepartments || 0;
    }
    
    const compiledCountEl = document.getElementById('compiledCount');
    if (compiledCountEl) {
      compiledCountEl.textContent = stats.compiledReports || stats.compiled || 0;
    }
    
    const delayedCountEl = document.getElementById('delayedCount');
    if (delayedCountEl) {
      delayedCountEl.textContent = stats.delayedProjects || stats.delayed || 0;
    }
    
    const delayedMilestonesCountEl = document.getElementById('delayedMilestonesCount');
    if (delayedMilestonesCountEl) {
      delayedMilestonesCountEl.textContent = stats.delayedMilestones || 0;
    }
    
    const totalBudgetEl = document.getElementById('totalBudget');
    if (totalBudgetEl) {
      const budget = parseFloat(stats.totalBudget || 0);
      if (budget > 0) {
        totalBudgetEl.textContent = `₱${budget.toLocaleString('en-PH', { 
          minimumFractionDigits: 2, 
          maximumFractionDigits: 2 
        })}`;
        console.log('💰 Total Budget updated:', budget);
      } else {
        totalBudgetEl.textContent = '₱0.00';
        console.warn('⚠️ Total Budget is 0, checking if calculation is needed');
      }
    } else {
      console.error('❌ totalBudget element not found');
    }
    
    // Update header compilation count
    const headerCountEl = document.getElementById('headerCompilationCount');
    if (headerCountEl) {
      headerCountEl.textContent = `${stats.totalProjects || 0} Active Compilations`;
    }
    
    // Update other stats by finding elements with specific text content (fallback)
    const cards = document.querySelectorAll('.profile-card');
    cards.forEach(card => {
      const titleEl = card.querySelector('p.text-sm.text-gray-600');
      if (titleEl) {
        const title = titleEl.textContent.trim();
        
        switch (title) {
          case 'Budget Utilized':
            const budgetUtilizedEl = card.querySelector('p.text-2xl.font-bold');
            if (budgetUtilizedEl && !budgetUtilizedEl.id) {
              budgetUtilizedEl.textContent = `₱${(stats.budgetUtilized || 0).toLocaleString()}`;
            }
            const budgetPercentEl = card.querySelector('p.text-xs.text-green-600');
            if (budgetPercentEl) {
              budgetPercentEl.textContent = `${stats.budgetUtilizedPercent || 0}% utilized`;
            }
            break;
          case 'Avg Progress':
            const progressEl = card.querySelector('p.text-2xl.font-bold');
            if (progressEl && !progressEl.id) {
              progressEl.textContent = `${stats.averageCompletion || 0}%`;
            }
            break;
          case 'P.Review':
            const pendingEl = card.querySelector('p.text-2xl.font-bold');
            if (pendingEl && !pendingEl.id) {
              pendingEl.textContent = stats.pendingReview || 0;
            }
            break;
        }
      }
    });
    
    console.log('✅ Summary cards updated:', {
      totalProjects: stats.totalProjects || 0,
      totalDepartments: stats.totalDepartments || 0,
      compiled: stats.compiledReports || stats.compiled || 0,
      delayed: stats.delayedProjects || stats.delayed || 0,
      totalBudget: stats.totalBudget || 0
    });
  }

  // Function to get department logo
  function getDepartmentLogo(departmentName) {
    console.log('🔍 Getting logo for department:', departmentName);
    const logoMap = {
      'Municipal Disaster And Risk Reduction Management Office': '/mdrrmo-logo.jfif',
      'Municipal Engineer\'s Office': '/meo-logo.jfif',
      'Municipal Agriculture Office': '/mao-logo.jfif',
      'Municipal Social Welfare and Development Office': '/mswdo-logo.jfif',
      'Municipal Environment and Natural Resources Office': '/menro-logo.jfif',
      'Municipal Environment And Natural Resources Office': '/menro-logo.jfif' // Alternative capitalization
    };
    
    // Try exact match first
    let logoPath = logoMap[departmentName];
    
    // If no exact match, try case-insensitive match
    if (!logoPath) {
      const lowerDepartmentName = departmentName.toLowerCase();
      for (const [key, value] of Object.entries(logoMap)) {
        if (key.toLowerCase() === lowerDepartmentName) {
          logoPath = value;
          break;
        }
      }
    }
    
    // If still no match, use default
    if (!logoPath) {
      logoPath = '/default-department-logo.png';
    }
    
    console.log('🔍 Logo path for', departmentName, ':', logoPath);
    return logoPath;
  }

  // Function to get department description
  function getDepartmentDescription(departmentName) {
    const descriptions = {
      'Municipal Disaster And Risk Reduction Management Office': 'Responsible for disaster risk reduction and emergency response management',
      'Municipal Engineer\'s Office': 'Handles infrastructure development and engineering projects',
      'Municipal Agriculture Office': 'Manages agricultural programs and rural development initiatives',
      'Municipal Social Welfare and Development Office': 'Oversees social welfare programs and community development',
      'Municipal Environment and Natural Resources Office': 'Manages environmental protection and natural resource conservation'
    };
    return descriptions[departmentName] || 'Department responsible for various municipal projects and programs';
  }

  // Function to get real last submission date from project data
  function getLastSubmissionDate(projects) {
    if (!projects || projects.length === 0) {
      return 'No Data';
    }
    
    // Find the most recent submission date from all projects
    let lastSubmission = null;
    
    projects.forEach(project => {
      // Check various date fields that might exist
      const dates = [
        project.lastSubmission,
        project.updatedAt,
        project.createdAt,
        project.submissionDate,
        project.lastUpdate
      ].filter(date => date);
      
      dates.forEach(date => {
        const dateObj = new Date(date);
        if (!isNaN(dateObj.getTime())) {
          if (!lastSubmission || dateObj > lastSubmission) {
            lastSubmission = dateObj;
          }
        }
      });
    });
    
    if (lastSubmission) {
      return lastSubmission.toLocaleDateString();
    }
    
    return 'No Data';
  }


