              <p class="text-gray-900">${milestone.timelineStartDate ? new Date(milestone.timelineStartDate).toLocaleDateString() : 'N/A'}</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Target Completion Date</label>
