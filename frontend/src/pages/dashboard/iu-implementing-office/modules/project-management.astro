  function renderStatusDistributionChart(projects) {
    const ctx = document.getElementById('statusDistributionChart');
    if (!ctx) return;
    
    if (window.projectAnalyticsCharts.statusDistribution) {
      window.projectAnalyticsCharts.statusDistribution.destroy();
    }
    
    // Group projects by status for tooltip display (removed "Not Started" - doesn't exist in system)
    // Note: Delayed projects are also ongoing projects, so Ongoing includes both ongoing and delayed
    const ongoingOnlyProjects = projects.filter(p => p.status === 'ongoing');
    const delayedProjects = projects.filter(p => p.status === 'delayed');
    const allOngoingProjects = [...ongoingOnlyProjects, ...delayedProjects]; // All ongoing (including delayed)
    const completedProjects = projects.filter(p => 
      p.status === 'complete' || 
      p.status === 'completed' || 
      p.status === 'COMPLETED' ||
      p.status?.toLowerCase() === 'complete' ||
      p.status?.toLowerCase() === 'completed'
    );
    
    // For the chart: Show Ongoing (which includes delayed) and Delayed separately
    // Since delayed are also ongoing, we show them in both segments but adjust counts to avoid double counting
    const statusGroups = {
      'Ongoing': allOngoingProjects, // All ongoing projects (including delayed) for tooltip
      'Delayed': delayedProjects, // Delayed projects for separate display
      'Completed': completedProjects
    };
    
    // Chart counts: Show Ongoing (includes delayed), Delayed (for visibility in red), and Completed
    // Note: Delayed projects are included in Ongoing since they're also ongoing projects
    // We show Delayed separately in red for visibility, even though they're conceptually part of Ongoing
    const statusCounts = {
      'Ongoing': allOngoingProjects.length, // All ongoing (including delayed, since delayed are also ongoing)
      'Delayed': delayedProjects.length, // Delayed shown separately in red for visibility
      'Completed': completedProjects.length
    };
    
    // Filter out zero counts to avoid showing empty segments
    const filteredStatusCounts = {};
    Object.keys(statusCounts).forEach(key => {
      if (statusCounts[key] > 0) {
        filteredStatusCounts[key] = statusCounts[key];
      }
    });
    
    // Define colors: Ongoing - Blue, Delayed - Red, Completed - Green
    // Note: Delayed projects are included in Ongoing (since they're also ongoing)
    // but shown separately in red for visibility
    const statusColors = {
      'Ongoing': {
        background: 'rgba(59, 130, 246, 0.8)', // Blue
        border: 'rgb(59, 130, 246)'
      },
      'Delayed': {
        background: 'rgba(239, 68, 68, 0.8)', // Red
        border: 'rgb(239, 68, 68)'
      },
      'Completed': {
        background: 'rgba(16, 185, 129, 0.8)', // Green
        border: 'rgb(16, 185, 129)'
      }
    };
    
    // Create arrays in the correct order (only include non-zero counts)
    const labels = Object.keys(filteredStatusCounts);
    const data = Object.values(filteredStatusCounts);
    const backgroundColor = labels.map(label => statusColors[label].background);
    const borderColor = labels.map(label => statusColors[label].border);
    
    window.projectAnalyticsCharts.statusDistribution = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: data,
          backgroundColor: backgroundColor,
          borderColor: borderColor,
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: true, position: 'right' },
          tooltip: {
            callbacks: {
              title: function(context) {
                const label = context[0].label || '';
                const value = context[0].parsed || 0;
                return `${label}: ${value} project${value !== 1 ? 's' : ''}`;
              },
              label: function(context) {
                const label = context.label || '';
                const statusProjects = statusGroups[label] || [];
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percentage = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                
                if (statusProjects.length === 0) {
                  return `${percentage}%`;
                }
                
                // Show first few projects in tooltip
                const maxProjects = 5;
                const displayProjects = statusProjects.slice(0, maxProjects);
                const projectList = displayProjects.map(p => {
                  const name = p.name || p.projectName || p.title || 'Unnamed Project';
                  const code = p.projectCode || '';
                  return code ? `${name} (${code})` : name;
                }).join(', ');
                
                const moreText = statusProjects.length > maxProjects 
                  ? ` and ${statusProjects.length - maxProjects} more...` 
                  : '';
                
                return [
                  `${percentage}%`,
                  ...displayProjects.map(p => {
                    const name = p.name || p.projectName || p.title || 'Unnamed Project';
                    const code = p.projectCode || '';
                    return code ? `• ${name} (${code})` : `• ${name}`;
                  }),
                  moreText ? moreText : ''
                ].filter(Boolean);
              }
            }
          }
        }
      }
    });
  }

