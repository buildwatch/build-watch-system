  // Save all project information to localStorage (user-specific)
  window.saveProjectInformation = async function() {
    try {
      // Get current user information to scope the saved data
      const token = localStorage.getItem('token');
      if (!token) {
        window.showErrorMessage('Authentication required', 'Please log in to save project information.');
        return;
      }

      let currentUserId = null;
      try {
        const apiUrl = window.getApiUrl ? window.getApiUrl() : (() => {
          const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
          return isProd 
            ? `${window.location.protocol}//${window.location.hostname}/api`
            : 'http://localhost:3000/api';
        })();
        const userResponse = await fetch(`${apiUrl}/auth/profile`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (userResponse.ok) {
          const userData = await userResponse.json();
          if (userData.success && userData.user) {
            // Use email as unique identifier (or ID if available)
            currentUserId = userData.user.id || userData.user.email;
          }
        }
      } catch (userError) {
        console.error('Error fetching user data:', userError);
        window.showErrorMessage('Authentication error', 'Could not verify your identity. Please try again.');
        return;
      }

      if (!currentUserId) {
        window.showErrorMessage('User identification failed', 'Could not identify the current user. Please try again.');
        return;
      }

      const projectData = {
        // Basic Project Information
        projectCode: document.querySelector('input[name="projectCode"]')?.value || '',
        name: document.querySelector('input[name="name"]')?.value || '',
        implementingOfficeName: document.querySelector('input[name="implementingOfficeName"]')?.value || '',
        category: document.querySelector('select[name="category"]')?.value || '',
        location: [], // Will be populated below
        priority: document.querySelector('select[name="priority"]')?.value || '',
        fundingSource: document.querySelector('input[name="fundingSource"]')?.value || 'Municipal Development Fund', // Hidden input always has value "Municipal Development Fund"
        createdDate: document.querySelector('input[name="createdDate"]')?.value || '',
        description: document.querySelector('textarea[name="description"]')?.value || '',
        expectedOutputs: document.querySelector('textarea[name="expectedOutputs"]')?.value || '',
        targetBeneficiaries: document.querySelector('textarea[name="targetBeneficiaries"]')?.value || '',
        
        // EIU Partner Information
        hasExternalPartner: document.querySelector('input[name="hasExternalPartner"]')?.checked || false,
        eiuPersonnelId: document.querySelector('select[name="eiuPersonnelId"]')?.value || document.querySelector('#eiuPersonnelId')?.value || '',
        
        // Timeline Information
        startDate: document.querySelector('input[name="startDate"]')?.value || '',
        endDate: document.querySelector('input[name="endDate"]')?.value || '',
        
        // Budget Information
        totalBudget: document.querySelector('input[name="totalBudget"]')?.value || '',
        budgetBreakdown: document.querySelector('textarea[name="budgetBreakdown"]')?.value || '',
        
        // Physical Accomplishment Information
        generalDescription: document.querySelector('textarea[name="generalDescription"]')?.value || '',
        physicalProgressRequirements: document.querySelector('textarea[name="physicalProgressRequirements"]')?.value || '',
        initialPhoto: null, // File uploads can't be easily saved to localStorage
        
        // Milestones
        milestones: [],
        
        // Metadata
        savedAt: new Date().toISOString(),
        userId: currentUserId // Store user ID to verify ownership
      };
      
      // Get location/barangay data - collect all selected barangays
      const locationSelects = document.querySelectorAll('select[name="location[]"]');
      locationSelects.forEach(select => {
        if (select.value && select.value !== '') {
          projectData.location.push(select.value);
        }
      });
      
      // Get milestones data
      const milestoneElements = document.querySelectorAll('#createMilestonesContainer .milestone-item');
      milestoneElements.forEach(element => {
        const id = element.id.replace('milestone-', '');
        
        const milestone = {
          id: id,
          title: element.querySelector(`input[name="milestones[${id}][title]"]`)?.value || '',
          weight: element.querySelector(`input[name="milestones[${id}][weight]"]`)?.value || '',
          plannedBudget: element.querySelector(`input[name="milestones[${id}][plannedBudget]"]`)?.value || '',
          dueDate: element.querySelector(`input[name="milestones[${id}][dueDate]"]`)?.value || '',
          description: element.querySelector(`textarea[name="milestones[${id}][description]"]`)?.value || '',
          
          // Timeline Division
          timelineWeight: element.querySelector(`input[name="milestones[${id}][timelineWeight]"]`)?.value || '',
          timelineStartDate: element.querySelector(`input[name="milestones[${id}][timelineStartDate]"]`)?.value || '',
          timelineEndDate: element.querySelector(`input[name="milestones[${id}][timelineEndDate]"]`)?.value || '',
          timelineDescription: element.querySelector(`textarea[name="milestones[${id}][timelineDescription]"]`)?.value || '',
          
          // Budget Division
          budgetWeight: element.querySelector(`input[name="milestones[${id}][budgetWeight]"]`)?.value || '',
          budgetPlanned: element.querySelector(`input[name="milestones[${id}][budgetPlanned]"]`)?.value || '',
          budgetBreakdown: element.querySelector(`textarea[name="milestones[${id}][budgetBreakdown]"]`)?.value || '',
          
          // Physical Division
          physicalWeight: element.querySelector(`input[name="milestones[${id}][physicalWeight]"]`)?.value || '',
          physicalProofTypes: [], // Will be populated below
          physicalDescription: element.querySelector(`textarea[name="milestones[${id}][physicalDescription]"]`)?.value || ''
        };
        
        // Get proof types
        const proofTypeSelects = element.querySelectorAll(`select[name^="milestones[${id}][physicalProofTypes]"]`);
        proofTypeSelects.forEach(select => {
          if (select.value) {
            milestone.physicalProofTypes.push(select.value);
          }
        });
        
        projectData.milestones.push(milestone);
      });
      
      // Save to localStorage with user-specific key
      const storageKey = `savedProjectData_${currentUserId}`;
      localStorage.setItem(storageKey, JSON.stringify(projectData));
      
      // Also maintain backward compatibility by removing old generic key if it exists
      // (This helps clean up old data that wasn't user-specific)
      const oldData = localStorage.getItem('savedProjectData');
      if (oldData) {
        try {
          const oldProjectData = JSON.parse(oldData);
          // Only remove if it doesn't have a userId (old format)
          if (!oldProjectData.userId) {
            localStorage.removeItem('savedProjectData');
          }
        } catch (e) {
          // If parsing fails, remove it anyway
          localStorage.removeItem('savedProjectData');
        }
      }
      
      // Show success message
      window.showSuccessMessage('Project information saved successfully!', 'Your data has been saved and can be loaded later using the "Load Saved Data" button.');
      
      console.log('Project data saved for user:', currentUserId, projectData);
      
    } catch (error) {
      console.error('Error saving project data:', error);
      window.showErrorMessage('Failed to save project information', 'An error occurred while saving your data. Please try again.');
    }
  };

  // Store project data for loading (used by confirmation modal)
  window.pendingProjectData = null;

  // Show load data confirmation modal
  window.showLoadDataConfirmModal = function(projectData) {
    window.pendingProjectData = projectData;
    const modal = document.getElementById('loadDataConfirmModal');
    const dateElement = document.getElementById('loadDataConfirmDate');
    
    if (dateElement && projectData.savedAt) {
      const savedDate = new Date(projectData.savedAt).toLocaleString();
      dateElement.textContent = `Load saved project data from ${savedDate}? This will replace all current form data.`;
    }
    
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      
      // Add click outside to close
      const handleClickOutside = (e) => {
        if (e.target === modal) {
          window.cancelLoadData();
          modal.removeEventListener('click', handleClickOutside);
        }
      };
      modal.addEventListener('click', handleClickOutside);
      
      // Add escape key to close
      const handleEscape = (e) => {
        if (e.key === 'Escape') {
          window.cancelLoadData();
          document.removeEventListener('keydown', handleEscape);
        }
      };
      document.addEventListener('keydown', handleEscape);
    }
  };

  // Hide load data confirmation modal
  window.hideLoadDataConfirmModal = function() {
    const modal = document.getElementById('loadDataConfirmModal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
    window.pendingProjectData = null;
  };

  // Cancel loading data
  window.cancelLoadData = function() {
    window.hideLoadDataConfirmModal();
  };

  // Confirm and load data
  window.confirmLoadData = function() {
    if (!window.pendingProjectData) {
      window.hideLoadDataConfirmModal();
      return;
    }
    
    const projectData = window.pendingProjectData;
    window.hideLoadDataConfirmModal();
    
    // Proceed with loading the data
    window.loadProjectDataFromStorage(projectData);
  };

  // Load saved project information from localStorage (user-specific)
  window.loadSavedProjectInformation = async function() {
    try {
      // Get current user information to load only their saved data
      const token = localStorage.getItem('token');
      if (!token) {
        window.showErrorMessage('Authentication required', 'Please log in to load saved project information.');
        return;
      }

      let currentUserId = null;
      try {
        const apiUrl = window.getApiUrl ? window.getApiUrl() : (() => {
          const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
          return isProd 
            ? `${window.location.protocol}//${window.location.hostname}/api`
            : 'http://localhost:3000/api';
        })();
        const userResponse = await fetch(`${apiUrl}/auth/profile`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (userResponse.ok) {
          const userData = await userResponse.json();
          if (userData.success && userData.user) {
            // Use email as unique identifier (or ID if available)
            currentUserId = userData.user.id || userData.user.email;
          }
        }
      } catch (userError) {
        console.error('Error fetching user data:', userError);
        window.showErrorMessage('Authentication error', 'Could not verify your identity. Please try again.');
        return;
      }

      if (!currentUserId) {
        window.showErrorMessage('User identification failed', 'Could not identify the current user. Please try again.');
        return;
      }

      // Try to load user-specific saved data first
      const storageKey = `savedProjectData_${currentUserId}`;
      let savedData = localStorage.getItem(storageKey);
      
      // Fallback to old generic key for backward compatibility (but verify ownership)
      if (!savedData) {
        savedData = localStorage.getItem('savedProjectData');
        if (savedData) {
          try {
            const oldProjectData = JSON.parse(savedData);
            // If old data has a userId, check if it matches current user
            if (oldProjectData.userId && oldProjectData.userId !== currentUserId) {
              // Data belongs to a different user, don't load it
              savedData = null;
            } else if (oldProjectData.userId === currentUserId) {
              // Old data belongs to current user, migrate it to new key
              const storageKey = `savedProjectData_${currentUserId}`;
              localStorage.setItem(storageKey, savedData);
              localStorage.removeItem('savedProjectData');
            }
          } catch (e) {
            // If parsing fails, treat as no data
            savedData = null;
          }
        }
      }
      
      if (!savedData) {
        window.showInfoMessage('No saved data found', 'There is no previously saved project information to load for your account.');
        return;
      }
      
      const projectData = JSON.parse(savedData);
      
      // Verify ownership - double check that the data belongs to the current user
      if (projectData.userId && projectData.userId !== currentUserId) {
        window.showErrorMessage('Access denied', 'This saved data belongs to a different user account and cannot be loaded.');
        return;
      }
      
      // Show modern confirmation modal instead of browser alert
      window.showLoadDataConfirmModal(projectData);
      
      return; // Exit here, actual loading happens in confirmLoadData()
    } catch (error) {
      console.error('Error loading saved project data:', error);
      window.showErrorMessage('Failed to load saved data', 'An error occurred while loading your saved data. Please try again.');
    }
  };

  // Actually load the project data (called after confirmation)
  window.loadProjectDataFromStorage = function(projectData) {
    try {
      
      // Clear existing milestones first
      const milestonesContainer = document.getElementById('createMilestonesContainer');
      if (milestonesContainer) {
        milestonesContainer.innerHTML = '';
      }
      window.milestoneCounter = 0;
      
      // Load basic project information
      const setFieldValue = (selector, value) => {
        const element = document.querySelector(selector);
        if (element && value !== undefined && value !== null) {
          element.value = value;
          // Trigger change event for formatted inputs
          if (element.onchange) element.onchange();
          if (element.oninput) element.oninput();
        }
      };
      
      const setCheckboxValue = (selector, value) => {
        const element = document.querySelector(selector);
        if (element) {
          element.checked = value || false;
          // Trigger change event
          if (element.onchange) element.onchange();
        }
      };
      
      // Basic Information
      setFieldValue('input[name="projectCode"]', projectData.projectCode);
      setFieldValue('input[name="name"]', projectData.name);
      setFieldValue('input[name="implementingOfficeName"]', projectData.implementingOfficeName);
      setFieldValue('select[name="category"]', projectData.category);
      setFieldValue('select[name="priority"]', projectData.priority);
      // Funding Source is now readonly and auto-set, but update display if needed
      const fundingSourceDisplay = document.getElementById('editFundingSourceSelect');
      if (fundingSourceDisplay) {
        fundingSourceDisplay.value = '20% Municipal Development Fund';
      }
      // Hidden input for form submission
      const fundingSourceHidden = document.querySelector('input[name="fundingSource"]');
      if (fundingSourceHidden) {
        fundingSourceHidden.value = 'Municipal Development Fund';
      }
      setFieldValue('input[name="createdDate"]', projectData.createdDate);
      setFieldValue('textarea[name="description"]', projectData.description);
      setFieldValue('textarea[name="expectedOutputs"]', projectData.expectedOutputs);
      setFieldValue('textarea[name="targetBeneficiaries"]', projectData.targetBeneficiaries);
      
      // EIU Partner Information
      setCheckboxValue('input[name="hasExternalPartner"]', projectData.hasExternalPartner);
      
      // Restore EIU account selection and verification status
      if (projectData.eiuPersonnelId) {
        // Set a flag to restore EIU after accounts are loaded
        window.pendingEIUrestore = {
          eiuPersonnelId: projectData.eiuPersonnelId,
          restoreAfterLoad: true
        };
        
        // Try to restore immediately if EIU accounts are already loaded
        const restoreEIU = () => {
          const eiuSelect = document.getElementById('eiuPersonnelId');
          if (eiuSelect && eiuSelect.options.length > 1) { // More than just placeholder
            const selectedOption = eiuSelect.querySelector(`option[value="${projectData.eiuPersonnelId}"]`);
            if (selectedOption) {
              eiuSelect.value = projectData.eiuPersonnelId;
              
              const eiuUserId = selectedOption.getAttribute('data-eiu-userid');
              const eiuName = selectedOption.getAttribute('data-eiu-name') || selectedOption.textContent;
              const profilePicUrl = selectedOption.getAttribute('data-eiu-profilepic') || '';
              
              // Update custom dropdown button display
              const dropdownSelected = document.getElementById('eiuDropdownSelected');
              if (dropdownSelected) {
                let normalizedPicUrl = profilePicUrl || '';
                if (!normalizedPicUrl || normalizedPicUrl === '' || normalizedPicUrl === 'null' || normalizedPicUrl === 'undefined') {
                  normalizedPicUrl = `https://ui-avatars.com/api/?name=${encodeURIComponent(eiuName)}&background=92751F&color=fff&size=40`;
                }
                
                const fallbackUrl = `https://ui-avatars.com/api/?name=${encodeURIComponent(eiuName)}&background=92751F&color=fff&size=40`;
                
                dropdownSelected.innerHTML = `
                  <img 
                    src="${normalizedPicUrl}" 
                    alt="${eiuName.replace(/"/g, '&quot;')}"
                    class="w-8 h-8 rounded-full object-cover border-2 border-gray-200 flex-shrink-0"
                    onerror="this.onerror=null; this.src='${fallbackUrl}';"
                  />
                  <span class="text-gray-900 font-medium">${eiuName}</span>
                `;
              }
              
              // Restore verification status - mark as verified since it was saved
              const validationMessage = document.getElementById('eiuValidationMessage');
              if (validationMessage) {
                validationMessage.setAttribute('data-verified', 'true');
                validationMessage.innerHTML = `
                  <div class="bg-green-50 border border-green-200 rounded-lg p-3 mt-2">
                    <div class="flex items-center gap-2">
                      <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <p class="text-sm text-green-800 font-medium">Valid EIU Account Verified</p>
                    </div>
                  </div>
                `;
                validationMessage.classList.remove('hidden');
              }
              
              // If we have EIU user ID, restore the full profile
              if (eiuUserId && typeof window.handleEIUAccountSelection === 'function') {
                // Trigger the selection handler to restore full profile
                window.handleEIUAccountSelection(projectData.eiuPersonnelId);
              }
              
              // Clear the pending restore flag
              window.pendingEIUrestore = null;
              return true;
            }
          }
          return false;
        };
        
        // Try immediately
        if (!restoreEIU()) {
          // If not ready, try after a delay
          setTimeout(() => {
            if (!restoreEIU()) {
              // If still not ready, the loadEIUAccounts function will handle it
              console.log('EIU accounts not loaded yet, will restore after load');
            }
          }, 500);
        }
      }
      
      // Timeline Information
      setFieldValue('input[name="startDate"]', projectData.startDate);
      setFieldValue('input[name="endDate"]', projectData.endDate);
      
      // Budget Information
      setFieldValue('input[name="totalBudget"]', projectData.totalBudget);
      setFieldValue('textarea[name="budgetBreakdown"]', projectData.budgetBreakdown);
      
      // Physical Information
      setFieldValue('textarea[name="generalDescription"]', projectData.generalDescription);
      setFieldValue('textarea[name="physicalProgressRequirements"]', projectData.physicalProgressRequirements);
      
      // Load locations - restore all selected barangays
      if (projectData.location && projectData.location.length > 0) {
        const barangayContainer = document.getElementById('createBarangayContainer');
        if (barangayContainer) {
          // Clear existing dropdowns
          barangayContainer.innerHTML = '';
          
          // Add dropdown for each saved location
          projectData.location.forEach((location, index) => {
            if (index === 0) {
              // For the first location, create the base dropdown
              window.addCreateBarangayDropdown();
            } else {
              // For additional locations, add more dropdowns
              window.addCreateBarangayDropdown();
            }
            
            // Set the value after a brief delay to ensure DOM is updated
            setTimeout(() => {
              const locationSelects = document.querySelectorAll('#createBarangayContainer select[name="location[]"]');
              if (locationSelects[index]) {
                locationSelects[index].value = location;
              }
            }, 50);
          });
        }
      }
      
      // Load milestones
      if (projectData.milestones && projectData.milestones.length > 0) {
        projectData.milestones.forEach(milestoneData => {
          // Add a new milestone
          window.addMilestone();
          
          // Get the last added milestone element
          const milestoneElements = document.querySelectorAll('#createMilestonesContainer .milestone-item');
          const milestoneElement = milestoneElements[milestoneElements.length - 1];
          
          if (milestoneElement) {
            const id = milestoneElement.id.replace('milestone-', '');
            
            // Basic milestone data
            setFieldValue(`input[name="milestones[${id}][title]"]`, milestoneData.title);
            setFieldValue(`input[name="milestones[${id}][plannedBudget]"]`, milestoneData.plannedBudget);
            setFieldValue(`input[name="milestones[${id}][dueDate]"]`, milestoneData.dueDate);
            setFieldValue(`textarea[name="milestones[${id}][description]"]`, milestoneData.description);
            
            // Timeline Division
            setFieldValue(`input[name="milestones[${id}][timelineStartDate]"]`, milestoneData.timelineStartDate);
            setFieldValue(`input[name="milestones[${id}][timelineEndDate]"]`, milestoneData.timelineEndDate);
            setFieldValue(`textarea[name="milestones[${id}][timelineDescription]"]`, milestoneData.timelineDescription);
            
            // Budget Division
            setFieldValue(`input[name="milestones[${id}][budgetPlanned]"]`, milestoneData.budgetPlanned);
            setFieldValue(`textarea[name="milestones[${id}][budgetBreakdown]"]`, milestoneData.budgetBreakdown);
            
            // Physical Division
            setFieldValue(`textarea[name="milestones[${id}][physicalDescription]"]`, milestoneData.physicalDescription);
            
            // Load proof types (this might need adjustment based on actual implementation)
            if (milestoneData.physicalProofTypes && milestoneData.physicalProofTypes.length > 0) {
              milestoneData.physicalProofTypes.forEach((proofType, index) => {
                const proofTypeSelect = milestoneElement.querySelector(`select[name="milestones[${id}][physicalProofTypes][${index}]"]`);
                if (proofTypeSelect) {
                  proofTypeSelect.value = proofType;
                }
              });
            }
            
            // Trigger milestone calculations
            window.updateMilestoneCalculations(id);
          }
        });
        
        // Update budget hints after all milestones are loaded
        setTimeout(() => {
          window.updateBudgetHints();
        }, 100);
      }
      
      // Recalculate totals
      setTimeout(() => {
        window.calculateTotals();
        window.updateAllMilestoneWeights();
      }, 100);
      
      window.showSuccessMessage('Project data loaded successfully!', `Data from ${new Date(projectData.savedAt).toLocaleString()} has been loaded into the form.`);
      
    } catch (error) {
      console.error('Error loading saved project data:', error);
      window.showErrorMessage('Failed to load saved data', 'An error occurred while loading your saved data. The data might be corrupted.');
    }
  };

  // Clear all project information - entry point (shows confirmation modal)
  window.clearAllProjectInformation = function() {
    window.showClearAllConfirmModal(1);
  };

  // Store confirmation step state
  window.clearAllConfirmationStep = 0; // 0 = not started, 1 = first confirmation, 2 = second confirmation

  // Show clear all confirmation modal (first step)
  window.showClearAllConfirmModal = function(step = 1) {
    window.clearAllConfirmationStep = step;
    const modal = document.getElementById('clearAllConfirmModal');
    const title = document.getElementById('clearModalTitle');
    const subtitle = document.getElementById('clearModalSubtitle');
    const message = document.getElementById('clearModalMessage');
    const description = document.getElementById('clearModalDescription');
    const details = document.getElementById('clearModalDetails');
    
    if (!modal) return;
    
    if (step === 1) {
    // First confirmation
      if (title) title.textContent = 'Clear All Information';
      if (subtitle) subtitle.textContent = 'Confirm to proceed with clearing all data';
      if (message) message.textContent = 'Are you sure you want to clear all information?';
      if (description) description.textContent = 'This will remove all entered data from the form and cannot be undone.';
      if (details) {
        details.innerHTML = `
          <p class="text-xs text-red-800">
            <strong>Warning:</strong> This action cannot be undone.
          </p>
        `;
      }
    } else if (step === 2) {
      // Second confirmation (final)
      if (title) title.textContent = '⚠️ FINAL CONFIRMATION ⚠️';
      if (subtitle) subtitle.textContent = 'This is your last chance to cancel';
      if (message) message.textContent = 'Proceed with clearing all data?';
      if (description) description.textContent = 'This action will permanently clear ALL project information.';
      if (details) {
        details.innerHTML = `
          <p class="text-xs text-red-800 font-semibold mb-2">This action will permanently clear:</p>
          <ul class="text-xs text-red-800 space-y-1 list-disc list-inside">
            <li>Basic project details</li>
            <li>All milestones and their configurations</li>
            <li>Budget and timeline information</li>
            <li>EIU partner details</li>
          </ul>
          <p class="text-xs text-red-800 font-semibold mt-2">This action CANNOT be undone.</p>
        `;
      }
    }
    
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Add click outside to close
    const handleClickOutside = (e) => {
      if (e.target === modal) {
        window.cancelClearAll();
        modal.removeEventListener('click', handleClickOutside);
      }
    };
    modal.addEventListener('click', handleClickOutside);
    
    // Add escape key to close
    const handleEscape = (e) => {
      if (e.key === 'Escape') {
        window.cancelClearAll();
        document.removeEventListener('keydown', handleEscape);
      }
    };
    document.addEventListener('keydown', handleEscape);
  };

  // Hide clear all confirmation modal
  window.hideClearAllConfirmModal = function() {
    const modal = document.getElementById('clearAllConfirmModal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
    window.clearAllConfirmationStep = 0;
  };

  // Cancel clearing
  window.cancelClearAll = function() {
    window.hideClearAllConfirmModal();
  };

  // Confirm clearing (handles two-step confirmation)
  window.confirmClearAll = function() {
    if (window.clearAllConfirmationStep === 1) {
      // First confirmation passed, show second confirmation
      window.hideClearAllConfirmModal();
      setTimeout(() => {
        window.showClearAllConfirmModal(2);
      }, 200);
    } else if (window.clearAllConfirmationStep === 2) {
      // Second confirmation passed, proceed with clearing
      window.hideClearAllConfirmModal();
      window.executeClearAll();
    }
  };

  // Actually execute the clear operation
  window.executeClearAll = function() {
    
    try {
      // Save auto-populated fields before clearing
      const projectCodeField = document.querySelector('input[name="projectCode"]');
      const implementingOfficeField = document.querySelector('input[name="implementingOfficeName"]');
      const savedProjectCode = projectCodeField ? projectCodeField.value : '';
      const savedImplementingOffice = implementingOfficeField ? implementingOfficeField.value : '';
      
      // Clear milestones first
      const milestonesContainer = document.getElementById('createMilestonesContainer');
      if (milestonesContainer) {
        milestonesContainer.innerHTML = '';
      }
      window.milestoneCounter = 0;
      
      // Remove all dynamically added barangay dropdowns (keep only the first one)
      const barangayContainer = document.getElementById('createBarangayContainer');
      if (barangayContainer) {
        const allDropdowns = barangayContainer.querySelectorAll('div');
        // Remove all dropdowns except the first one
        for (let i = allDropdowns.length - 1; i > 0; i--) {
          allDropdowns[i].remove();
        }
      }
      
      // Clear all form fields
      const form = document.getElementById('createProjectForm');
      if (form) {
        form.reset();
      }
      
      // Restore auto-populated fields (Project Code and Implementing Office)
      if (projectCodeField && savedProjectCode) {
        projectCodeField.value = savedProjectCode;
      }
      if (implementingOfficeField && savedImplementingOffice) {
        implementingOfficeField.value = savedImplementingOffice;
      }
      
      // Reset created date to today
      const createdDateField = document.querySelector('input[name="createdDate"]');
      if (createdDateField) {
        const today = new Date().toISOString().split('T')[0];
        createdDateField.value = today;
      }
      
      // Re-populate Implementing Office and Project Code if they were auto-generated
      // This ensures they're restored even if they were empty
      if (implementingOfficeField && !savedImplementingOffice) {
        const token = localStorage.getItem('token');
        if (token) {
          const apiUrl = window.getApiUrl();
          fetch(`${apiUrl}/auth/profile`, {
            headers: { 'Authorization': `Bearer ${token}` }
          })
          .then(response => response.json())
          .then(data => {
            if (data.success && data.user && data.user.department) {
              implementingOfficeField.value = data.user.department;
              // Also regenerate project code
              if (projectCodeField && typeof window.generateProjectCode === 'function') {
                window.generateProjectCode(data.user.department);
              }
            }
          })
          .catch(error => {
            console.error('Error restoring implementing office:', error);
          });
        }
      }
      
      // Add initial milestone
      setTimeout(() => {
        window.addMilestone();
        window.calculateTotals();
      }, 100);
      
      // Clear saved data from localStorage (user-specific)
      // Get current user to clear only their saved data
      const token = localStorage.getItem('token');
      if (token) {
        const apiUrl = window.getApiUrl();
        fetch(`${apiUrl}/auth/profile`, {
          headers: { 'Authorization': `Bearer ${token}` }
        })
        .then(response => response.json())
        .then(userData => {
          if (userData.success && userData.user) {
            const currentUserId = userData.user.id || userData.user.email;
            if (currentUserId) {
              // Clear user-specific saved data
              const storageKey = `savedProjectData_${currentUserId}`;
              localStorage.removeItem(storageKey);
            }
          }
          // Also clear old generic key if it exists
      localStorage.removeItem('savedProjectData');
        })
        .catch(error => {
          console.error('Error fetching user data for clear:', error);
          // Fallback: clear old generic key
          localStorage.removeItem('savedProjectData');
        });
      } else {
        // No token, just clear old generic key
        localStorage.removeItem('savedProjectData');
      }
      
      // Reset unsaved changes flag since everything is cleared
      window.hasUnsavedChanges = false;
      
      window.showSuccessMessage('All information cleared!', 'The form has been reset and saved data has been permanently removed.');
      
    } catch (error) {
      console.error('Error clearing form data:', error);
      window.showErrorMessage('Error clearing form', 'An error occurred while clearing the form. Please refresh the page.');
        }
  };

