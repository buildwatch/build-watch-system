      <!-- Centralized Filter Component -->
      <!-- Initialize data and functions BEFORE React component loads -->
      <script define:vars={{ projects }}>
        // Global API URL helper function - works for both localhost and production
        // Helper function to format image/file URLs dynamically
        window.formatImageUrl = function(url) {
          if (!url) return null;
          // If already absolute URL, return as is
          if (url.startsWith('http://') || url.startsWith('https://')) {
            return url;
          }
          // Get API base URL and remove /api suffix for file URLs
          const apiUrl = window.getApiUrl();
          const baseUrl = apiUrl.replace('/api', '');
          // Ensure URL starts with /
          const path = url.startsWith('/') ? url : '/' + url;
          return `${baseUrl}${path}`;
        };
        
        window.getApiUrl = function() {
          const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
          return isProd 
            ? `${window.location.protocol}//${window.location.hostname}/api`
            : 'http://localhost:3000/api';
        };

        // Initialize data immediately when page loads
        if (typeof window !== 'undefined') {
          window.allProjects = projects || [];
          console.log('✅ [LGU-IU] window.allProjects initialized with', window.allProjects.length, 'projects');
          
          // Fetch and update utilized budget from /api/home/stats endpoint
          async function updateUtilizedBudget() {
            try {
              const token = localStorage.getItem('token') || sessionStorage.getItem('token');
              if (!token) return;
              
              const API_URL = window.getApiUrl();
              const response = await fetch(`${API_URL}/home/stats`, {
                headers: {
                  'Authorization': `Bearer ${token}`,
                  'Content-Type': 'application/json'
                }
              });
              
              if (response.ok) {
                const data = await response.json();
                if (data.success && data.utilizedBudget !== undefined) {
                  const utilizedBudget = parseFloat(data.utilizedBudget) || 0;
                  const formattedBudget = utilizedBudget.toLocaleString('en-PH', { 
                    minimumFractionDigits: 2, 
                    maximumFractionDigits: 2 
                  });
                  
                  // Update the element
                  const element = document.getElementById('totalBudgetUtilizedCount');
                  if (element) {
                    element.textContent = formattedBudget;
                    console.log('💰 Total Budget Utilized updated:', formattedBudget);
                  }
                }
              }
            } catch (error) {
              console.error('Error fetching utilized budget:', error);
            }
          }
          
          // Update when DOM is ready
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', updateUtilizedBudget);
          } else {
            updateUtilizedBudget();
          }
          
          // Make function available globally for manual refresh
          window.updateUtilizedBudget = updateUtilizedBudget;
          
          // Function to hide archived projects
          window.hideArchivedProject = function(projectId) {
            // Hide from card view
            const cardWrapper = document.querySelector(`#projectsGrid .project-card-wrapper[data-project-id="${projectId}"]`);
            if (cardWrapper) {
              cardWrapper.style.display = 'none';
              cardWrapper.classList.add('hidden');
            }
            
            // Hide from table view
            const tableRow = document.querySelector(`#projectsTableBody tr[data-project-id="${projectId}"]`);
            if (tableRow) {
              tableRow.style.display = 'none';
              tableRow.classList.add('hidden');
            }
            
            // Remove from allProjects array
            window.allProjects = window.allProjects.filter(p => p.id !== projectId);
            
            // Update counts
            const headerCount = document.getElementById('headerProjectCount');
            if (headerCount) {
              headerCount.textContent = `${window.allProjects.length} Projects Available`;
            }
            
            const tableCount = document.getElementById('tableProjectCount');
            if (tableCount) {
              tableCount.textContent = window.allProjects.length;
            }
          };

          // Function to show restored projects
          window.showRestoredProject = function(project) {
            // Add back to allProjects
            if (!window.allProjects.find(p => p.id === project.id)) {
              window.allProjects.push(project);
            }
            
            // Show in card view
            const cardWrapper = document.querySelector(`#projectsGrid .project-card-wrapper[data-project-id="${project.id}"]`);
            if (cardWrapper) {
              cardWrapper.style.display = '';
              cardWrapper.classList.remove('hidden');
            }
            
            // Show in table view
            const tableRow = document.querySelector(`#projectsTableBody tr[data-project-id="${project.id}"]`);
            if (tableRow) {
              tableRow.style.display = '';
              tableRow.classList.remove('hidden');
            }
            
            // Update counts
            const headerCount = document.getElementById('headerProjectCount');
            if (headerCount) {
              headerCount.textContent = `${window.allProjects.length} Projects Available`;
            }
            
            const tableCount = document.getElementById('tableProjectCount');
            if (tableCount) {
              tableCount.textContent = window.allProjects.length;
            }
          };

          // Filter out archived projects on page load
          window.filterArchivedProjects = function() {
            try {
              const archivedProjects = JSON.parse(localStorage.getItem('archivedProjects') || '[]');
              const archivedIds = new Set(archivedProjects.map(p => p.id));
              
              // Filter allProjects
              window.allProjects = window.allProjects.filter(p => !archivedIds.has(p.id));
              
              // Hide archived projects from UI
              archivedIds.forEach(id => {
                window.hideArchivedProject(id);
              });
            } catch (e) {
              console.error('Error filtering archived projects:', e);
            }
          };

          // Initialize display function immediately - uses show/hide instead of replacing HTML
          window.updateProjectDisplay = function(projectsToShow) {
            console.log('📊 [LGU-IU] Updating project display with', projectsToShow.length, 'projects');
            
            // Filter out archived projects
            try {
              const archivedProjects = JSON.parse(localStorage.getItem('archivedProjects') || '[]');
              const archivedIds = new Set(archivedProjects.map(p => p.id));
              projectsToShow = projectsToShow.filter(p => !archivedIds.has(p.id));
            } catch (e) {
              console.error('Error filtering archived projects:', e);
            }
            
            // Update project count in header
            const headerCount = document.getElementById('headerProjectCount');
            if (headerCount) {
              headerCount.textContent = `${projectsToShow.length} Projects Available`;
            }
            
            // Update table project count
            const tableCount = document.getElementById('tableProjectCount');
            if (tableCount) {
              tableCount.textContent = projectsToShow.length;
            }
            
            // Get all project IDs to show
            const projectIdsToShow = new Set(projectsToShow.map(p => p.id));
            
            // Update card view - show/hide existing ProjectCard components
            const cardWrappers = document.querySelectorAll('#projectsGrid .project-card-wrapper');
            cardWrappers.forEach(wrapper => {
              const projectId = wrapper.getAttribute('data-project-id');
              if (projectIdsToShow.has(projectId)) {
                wrapper.style.display = '';
                wrapper.classList.remove('hidden');
              } else {
                wrapper.style.display = 'none';
                wrapper.classList.add('hidden');
              }
            });
            
            // Update table view - show/hide existing table rows
            const tableRows = document.querySelectorAll('#projectsTableBody tr[data-project-id]');
            tableRows.forEach(row => {
              const projectId = row.getAttribute('data-project-id');
              if (projectIdsToShow.has(projectId)) {
                row.style.display = '';
                row.classList.remove('hidden');
              } else {
                row.style.display = 'none';
                row.classList.add('hidden');
              }
            });
            
            // Show empty state if no projects match
            const cardView = document.getElementById('cardView');
            const tableView = document.getElementById('tableView');
            const hasVisibleProjects = projectsToShow.length > 0;
            
            // Check if we need to show empty state
            let emptyStateCard = document.getElementById('filteredEmptyStateCard');
            let emptyStateTable = document.getElementById('filteredEmptyStateTable');
            
            if (!hasVisibleProjects) {
              // Show enhanced empty state in card view
              if (cardView && !emptyStateCard) {
                emptyStateCard = document.createElement('div');
                emptyStateCard.id = 'filteredEmptyStateCard';
                emptyStateCard.className = 'col-span-full text-center py-16';
                emptyStateCard.innerHTML = `
                  <div class="flex flex-col items-center justify-center">
                    <div class="relative mb-6">
                      <div class="absolute inset-0 bg-blue-100 rounded-full blur-2xl opacity-50 animate-pulse"></div>
                      <div class="relative w-32 h-32 bg-gradient-to-br from-blue-100 to-blue-100 rounded-full flex items-center justify-center shadow-lg">
                        <svg class="w-20 h-20 text-[#0D7DB5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                      </div>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3">No Projects Found</h3>
                    <p class="text-gray-600 text-lg mb-2 max-w-md">We couldn't find any projects matching your current filter criteria.</p>
                    <p class="text-gray-500 text-sm mb-6">Try adjusting your search terms, status, priority, or sort options to see more results.</p>
                    <button onclick="if(window.projectFilterCenter) window.projectFilterCenter.clearFilters()" class="px-6 py-3 bg-gradient-to-r from-[#0D7DB5] to-[#0A6A9A] hover:from-[#0A6A9A] hover:to-[#075A85] text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center gap-2">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                      Clear All Filters
                    </button>
                  </div>
                `;
                const cardGrid = document.getElementById('projectsGrid');
                if (cardGrid) {
                  cardGrid.appendChild(emptyStateCard);
                }
              }
              
              // Show enhanced empty state in table view
              if (tableView && !emptyStateTable) {
                emptyStateTable = document.createElement('tr');
                emptyStateTable.id = 'filteredEmptyStateTable';
                emptyStateTable.innerHTML = `
                  <td colspan="8" class="px-6 py-16 text-center">
                    <div class="flex flex-col items-center justify-center">
                      <div class="relative mb-6">
                        <div class="absolute inset-0 bg-blue-100 rounded-full blur-2xl opacity-50 animate-pulse"></div>
                        <div class="relative w-32 h-32 bg-gradient-to-br from-blue-100 to-blue-100 rounded-full flex items-center justify-center shadow-lg">
                          <svg class="w-20 h-20 text-[#0D7DB5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                          </svg>
                        </div>
                      </div>
                      <h3 class="text-2xl font-bold text-gray-900 mb-3">No Projects Found</h3>
                      <p class="text-gray-600 text-lg mb-2 max-w-md">We couldn't find any projects matching your current filter criteria.</p>
                      <p class="text-gray-500 text-sm mb-6">Try adjusting your search terms, status, priority, or sort options to see more results.</p>
                      <button onclick="if(window.projectFilterCenter) window.projectFilterCenter.clearFilters()" class="px-6 py-3 bg-gradient-to-r from-[#0D7DB5] to-[#0A6A9A] hover:from-[#0A6A9A] hover:to-[#075A85] text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Clear All Filters
                      </button>
                    </div>
                  </td>
                `;
                const tableBody = document.getElementById('projectsTableBody');
                if (tableBody) {
                  tableBody.appendChild(emptyStateTable);
                }
              }
            } else {
              // Hide empty states if projects are visible
              if (emptyStateCard) {
                emptyStateCard.remove();
              }
              if (emptyStateTable) {
                emptyStateTable.remove();
              }
            }
          };
          
          // Initialize filter function
          window.applyProjectFiltersFromCenter = function(filters) {
            console.log('🔍 [LGU-IU] Applying filters from center:', filters);
            console.log('🔍 [LGU-IU] Available projects:', window.allProjects?.length || 0);
            
            let filteredProjects = window.allProjects || [];
            
            if (!filteredProjects || filteredProjects.length === 0) {
              console.warn('⚠️ [LGU-IU] No projects available to filter! window.allProjects is empty or undefined.');
              return;
            }
            
            // Apply search filter
            if (filters.search) {
              const searchTerm = filters.search.toLowerCase();
              filteredProjects = filteredProjects.filter(project => 
                project.name?.toLowerCase().includes(searchTerm) ||
                project.description?.toLowerCase().includes(searchTerm) ||
                project.projectCode?.toLowerCase().includes(searchTerm)
              );
            }
            
            // Apply status filter
            if (filters.status) {
              filteredProjects = filteredProjects.filter(project => project.status === filters.status);
            }
            
            // Apply priority filter
            if (filters.priority) {
              filteredProjects = filteredProjects.filter(project => project.priority === filters.priority);
            }
            
            // Apply sorting
            switch(filters.sortBy) {
              case 'name':
                filteredProjects.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
                break;
              case 'status':
                filteredProjects.sort((a, b) => (a.status || '').localeCompare(b.status || ''));
                break;
              case 'progress':
                filteredProjects.sort((a, b) => {
                  const progressA = parseFloat(a.progress?.overallProgress || a.overallProgress || 0);
                  const progressB = parseFloat(b.progress?.overallProgress || b.overallProgress || 0);
                  return progressB - progressA;
                });
                break;
              case 'budget':
                filteredProjects.sort((a, b) => {
                  const budgetA = parseFloat(a.totalBudget || 0);
                  const budgetB = parseFloat(b.totalBudget || 0);
                  return budgetB - budgetA;
                });
                break;
              case 'date':
                filteredProjects.sort((a, b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0));
                break;
            }
            
            // Update project display
            window.updateProjectDisplay(filteredProjects);
          };
          
          // Store the callback function on window so React component can access it
          window.projectFilterCallback = function(filters) {
            console.log('🔍 [LGU-IU] onFilterChange callback triggered with filters:', filters);
            if (typeof window !== 'undefined' && window.applyProjectFiltersFromCenter) {
              window.applyProjectFiltersFromCenter(filters);
            } else {
              console.warn('⚠️ [LGU-IU] applyProjectFiltersFromCenter not available yet');
            }
          };
          
          console.log('✅ [LGU-IU] All filter functions initialized');
          
        }
      </script>

      <ProjectFilterCenter 
        client:load
        theme="blue"
        moduleType="lgu-iu"
      />

      <!-- Centralized Export Component -->
      <ProjectExportCenter 
        client:load
        theme="blue"
        data={projects}
        exportType="projects"
        fileNamePrefix="lgu-iu-projects"
      />

      {loading ? (
        <div class="flex items-center justify-center py-12">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[#92751F]"></div>
          <span class="ml-3 text-gray-600">Loading projects...</span>
        </div>
      ) : error ? (
        <div class="text-center py-12">
          <p class="text-red-600 mb-4">{error}</p>
                      <button onclick="window.location.reload()" class="px-4 py-2 bg-[#92751F] text-white rounded-lg hover:bg-[#7A6219] transition-all">
            Try Again
          </button>
        </div>
      ) : projects.length === 0 ? (
        <div class="text-center py-12">
          <svg class="w-24 h-24 text-gray-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          <h3 class="text-xl font-semibold text-gray-800 mb-2">No Projects Found</h3>
          <p class="text-gray-600 mb-6">Get started by creating your first project with comprehensive monitoring across timeline, budget, and physical divisions</p>
          <button onclick="window.openCreateProjectModal()" class="px-6 py-3 bg-[#92751F] text-white rounded-lg hover:bg-[#7A6219] transition-colors flex items-center gap-2 mx-auto">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Create New Project
          </button>
        </div>
      ) : (
        <!-- Enhanced Projects View Tabs -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden hover:shadow-2xl transition-all duration-300">
          <!-- Enhanced Tab Navigation -->
          <div class="px-8 py-6 border-b border-gray-200 bg-gradient-to-r from-gray-50 to-white">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="icon-container bg-gradient-to-br from-[#0D7DB5] to-[#0A6A9A] shadow-xl">
