  window.validateMilestoneComplete = function(milestoneId) {
    const milestoneElement = document.getElementById(`milestone-${milestoneId}`);
    if (!milestoneElement) return false;
    
    // Check all required fields
    const title = milestoneElement.querySelector(`input[name="milestones[${milestoneId}][title]"]`)?.value?.trim();
    const plannedBudget = milestoneElement.querySelector(`input[name="milestones[${milestoneId}][plannedBudget]"]`)?.value?.trim();
    const dueDate = milestoneElement.querySelector(`input[name="milestones[${milestoneId}][dueDate]"]`)?.value?.trim();
    const description = milestoneElement.querySelector(`textarea[name="milestones[${milestoneId}][description]"]`)?.value?.trim();
    const timelineStartDate = milestoneElement.querySelector(`input[name="milestones[${milestoneId}][timelineStartDate]"]`)?.value?.trim();
    const timelineDescription = milestoneElement.querySelector(`textarea[name="milestones[${milestoneId}][timelineDescription]"]`)?.value?.trim();
    const budgetBreakdown = milestoneElement.querySelector(`textarea[name="milestones[${milestoneId}][budgetBreakdown]"]`)?.value?.trim();
    const physicalDescription = milestoneElement.querySelector(`textarea[name="milestones[${milestoneId}][physicalDescription]"]`)?.value?.trim();
    
    // Validate budget is greater than 0
    const budgetValue = window.parseBudgetValue(plannedBudget) || 0;
    
    return !!(title && plannedBudget && budgetValue > 0 && dueDate && description && 
              timelineStartDate && timelineDescription && budgetBreakdown && physicalDescription);
  };

