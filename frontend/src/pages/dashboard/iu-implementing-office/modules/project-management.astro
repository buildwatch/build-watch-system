  // Handle EIU account selection
  window.handleEIUAccountSelection = async function(eiuId) {
    if (!eiuId) {
      const validationMessage = document.getElementById('eiuValidationMessage');
      if (validationMessage) {
        validationMessage.innerHTML = '';
        validationMessage.setAttribute('data-verified', 'false');
      }
      return;
    }
    
    // Show loading modal
    window.showEIULoadingModal();
    
    try {
      const token = localStorage.getItem('token');
      if (!token) {
        window.hideEIULoadingModal();
        window.showErrorMessage('Authentication required', 'Please log in to verify EIU accounts.');
        return;
      }
      
      // Get the userId from the selected option's data attribute
      const eiuSelect = document.getElementById('eiuPersonnelId');
      const selectedOption = eiuSelect ? eiuSelect.options[eiuSelect.selectedIndex] : null;
      const eiuUserId = selectedOption ? selectedOption.getAttribute('data-eiu-userid') : null;
      
      if (!eiuUserId) {
        window.hideEIULoadingModal();
        window.showErrorMessage('Validation error', 'Unable to verify EIU account. Please try selecting again.');
        return;
      }
      
      // Verify the selected EIU account using userId (validate-eiu endpoint expects userId)
      const apiUrl = window.getApiUrl();
      const response = await fetch(`${apiUrl}/users/validate-eiu/${eiuUserId}`, {
        method: 'GET',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      if (response.ok) {
        const data = await response.json();
        if (data.success && data.user) {
          // Hide loading modal and show success modal
          window.hideEIULoadingModal();
          
          setTimeout(() => {
            window.showEIUSuccessModal(data.user);
            
            // Show comprehensive EIU profile information receipt
            if (typeof window.showEIUProfile === 'function') {
              window.showEIUProfile(data.user);
            } else {
              // Fallback to simple validation message if showEIUProfile is not available
              const validationMessage = document.getElementById('eiuValidationMessage');
              if (validationMessage) {
                validationMessage.innerHTML = `
                  <div class="bg-green-50 border border-green-200 rounded-lg p-3 mt-2">
                    <div class="flex items-center gap-2">
                      <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <p class="text-sm text-green-800 font-medium">Valid EIU Account Verified</p>
                    </div>
                  </div>
                `;
                validationMessage.setAttribute('data-verified', 'true');
              }
            }
          }, 500);
        } else {
          window.hideEIULoadingModal();
          window.showErrorMessage('Verification failed', 'The selected EIU account could not be verified.');
        }
      } else {
        window.hideEIULoadingModal();
        const errorData = await response.json().catch(() => ({}));
        window.showErrorMessage('Verification failed', errorData.error || 'Failed to verify the selected EIU account.');
      }
    } catch (error) {
      console.error('Error verifying EIU account:', error);
      window.hideEIULoadingModal();
      window.showErrorMessage('Error', 'An error occurred while verifying the EIU account.');
    }
  };

