  // Modern Warning Modal Functions
  window.showWarningModal = function(message, description) {
    const modal = document.getElementById('warningModal');
    const messageElement = document.getElementById('warningModalMessage');
    const descriptionElement = document.getElementById('warningModalDescription');
    
    if (!modal) {
      console.error('Warning modal not found');
      // Fallback to browser alert if modal doesn't exist
      if (typeof alert !== 'undefined') {
        alert(message);
      }
      return;
    }
    
    // Set message and description
    if (messageElement) {
      messageElement.textContent = message || 'Please fill in the required field.';
    }
    if (descriptionElement) {
      descriptionElement.textContent = description || 'This field is required to continue.';
    }
    
    // Show modal
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Focus the OK button for accessibility
    setTimeout(() => {
      const okButton = modal.querySelector('button');
      if (okButton) {
        okButton.focus();
      }
    }, 100);
    
    // Close on Escape key
    const handleEscape = (e) => {
      if (e.key === 'Escape') {
        window.closeWarningModal();
        document.removeEventListener('keydown', handleEscape);
      }
    };
    document.addEventListener('keydown', handleEscape);
    
    // Close on overlay click
    modal.addEventListener('click', (e) => {
      if (e.target === modal || e.target.classList.contains('warning-modal-overlay')) {
        window.closeWarningModal();
      }
    });
  };

