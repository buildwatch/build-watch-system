                  <span id="notificationBadge" class="absolute -top-2 -right-2 w-7 h-7 bg-red-500 text-white text-xs font-bold rounded-full flex items-center justify-center hidden z-30 shadow-xl border-2 border-white pointer-events-none">0</span>
                </div>
                <button 
                  onclick="if(window.projectInsightsCenter) window.projectInsightsCenter.openModal()"
                  class="group relative px-4 py-2 bg-gradient-to-r from-[#0D7DB5] to-[#0A6A9A] hover:from-[#0A6A9A] hover:to-[#075A85] text-white rounded-lg text-sm font-medium transition-all duration-300 flex items-center gap-2 shadow-md hover:shadow-lg transform hover:scale-105 overflow-hidden"
                  title="View Project Insights & Analytics"
                >
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
                  <svg class="w-4 h-4 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                  </svg>
                  <span class="relative z-10">Insights</span>
                </button>
                <button 
                  onclick="if(window.projectComparisonCenter) { const selected = window.projectComparisonCenter.getSelectedProjects(); if(selected.length >= 2) window.projectComparisonCenter.openModal(); else window.showCompareProjectsModal(); }"
                  class="group relative px-4 py-2 bg-gradient-to-r from-[#0D7DB5] to-[#0A6A9A] hover:from-[#0A6A9A] hover:to-[#075A85] text-white rounded-lg text-sm font-medium transition-all duration-300 flex items-center gap-2 shadow-md hover:shadow-lg transform hover:scale-105 overflow-hidden"
                  title="Compare Selected Projects"
                >
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
                  <svg class="w-4 h-4 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                  </svg>
                  <span class="relative z-10">Compare</span>
                </button>
                <div class="flex bg-gradient-to-r from-blue-50 to-blue-50 border-2 border-[#0D7DB5]/30 rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-all duration-300" style="width: 320px;">
                  <button id="cardTab" class="tab-button text-sm font-medium text-white bg-gradient-to-r from-[#0D7DB5] to-[#0A6A9A] hover:from-[#0A6A9A] hover:to-[#075A85] transition-all duration-300 flex items-center gap-3 active relative overflow-hidden px-6 py-3 shadow-lg">
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/25 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
                    <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                    </svg>
                    <span class="relative z-10 font-semibold">Card View</span>
                  </button>
                  <button id="tableTab" class="tab-button text-sm font-medium text-[#0D7DB5] hover:text-white hover:bg-gradient-to-r hover:from-[#0D7DB5] hover:to-[#0A6A9A] transition-all duration-300 flex items-center gap-3 relative overflow-hidden px-6 py-3 group">
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-blue-200/40 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
                    <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                    <span class="relative z-10 font-semibold">Table View</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Card View Content -->
          <div id="cardView" class="tab-content block p-6">
            <div class="card-grid grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6" id="projectsGrid">
              {projects.map((project) => (
                <div data-project-id={project.id} class="project-card-wrapper relative">
                  <!-- Bulk Selection Checkbox -->
                  <input
                    type="checkbox"
                    class="project-checkbox absolute top-4 left-4 z-10 w-5 h-5 rounded border-gray-300 text-[#0D7DB5] focus:ring-[#0D7DB5] cursor-pointer shadow-lg"
                    value={project.id}
                    onchange="if(window.projectBulkActionsCenter) window.projectBulkActionsCenter.toggleSelection(this.value)"
                  />
                  <!-- Comparison Selection Checkbox -->
                  <input
                    type="checkbox"
                    class="project-compare-checkbox absolute top-4 right-4 z-10 w-5 h-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer shadow-lg"
                    value={project.id}
                    onchange="if(window.projectComparisonCenter) window.projectComparisonCenter.toggleSelection(this.value)"
                    title="Select for comparison"
                  />
                  <!-- Bookmark Icon -->
                  <button
                    onclick={`if(window.projectOrganizationCenter) { const isBookmarked = window.projectOrganizationCenter.isBookmarked('${project.id}'); window.projectOrganizationCenter.toggleBookmark('${project.id}'); this.classList.toggle('text-[#0D7DB5]', !isBookmarked); this.classList.toggle('fill-[#0D7DB5]', !isBookmarked); }`}
                    class="absolute top-12 right-4 z-10 w-6 h-6 text-gray-400 hover:text-[#0D7DB5] transition-colors"
                    title="Bookmark project"
                  >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                    </svg>
                  </button>
                  <!-- Action Buttons -->
                  <div class="absolute bottom-4 right-4 z-10 flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-all">
                    <button
                      onclick={`if(window.projectNotesCenter) window.projectNotesCenter.openModal(${JSON.stringify(project)})`}
                      class="px-3 py-1.5 bg-blue-100 hover:bg-blue-200 text-[#0D7DB5] rounded-lg text-xs font-medium transition-all"
                      title="Add Notes & Annotations"
                    >
                      Notes
                    </button>
                    <button
                      onclick={`if(window.projectArchivingCenter) { const project = ${JSON.stringify(project)}; const status = project.status?.toLowerCase(); if(status === 'complete') { window.projectArchivingCenter.openModal(project); } else { if(window.projectArchivingCenter.showWarningModal) { window.projectArchivingCenter.showWarningModal('Only projects with "Complete" status can be archived.'); } else { alert('Only projects with "Complete" status can be archived.'); } } }`}
                      class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-medium transition-all"
                      title="Archive Project (Only Pending/Complete)"
                    >
                      Archive
                    </button>
                  </div>
                  <ProjectCard 
                    project={project} 
                    userTheme="iu-implementing-office"
                    onClick="viewProjectDetails"
                  />
                </div>
              ))}
            </div>
          </div>

          <!-- Enhanced Table View Content -->
          <div id="tableView" class="tab-content hidden p-4">
            <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-md">
              <div class="flex items-center justify-end mb-2 px-4 pt-3">
                <div class="text-sm text-gray-600">
                  <span id="selectedForComparison">0</span> selected for comparison
                </div>
              </div>
              <table class="w-full text-sm" id="projectsTable">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      <input
                        type="checkbox"
                        id="selectAllProjects"
                        class="w-4 h-4 rounded border-gray-300 text-[#0D7DB5] focus:ring-[#0D7DB5] cursor-pointer"
                        onchange="if(window.projectBulkActionsCenter) { if(this.checked) window.projectBulkActionsCenter.selectAll(); else window.projectBulkActionsCenter.deselectAll(); }"
                      />
                    </th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-project">
                      <div class="flex items-center gap-1.5">
                        Project
                        <button onclick="if(window.projectTableView) window.projectTableView.handleSort('name')" class="text-gray-400 hover:text-gray-600">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                          </svg>
                        </button>
                      </div>
                    </th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-category">Category</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-status">
                      <div class="flex items-center gap-1.5">
                        Status
                        <button onclick="if(window.projectTableView) window.projectTableView.handleSort('status')" class="text-gray-400 hover:text-gray-600">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                          </svg>
                        </button>
                      </div>
                    </th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-budget">
                      <div class="flex items-center gap-1.5">
                        Budget
                        <button onclick="if(window.projectTableView) window.projectTableView.handleSort('budget')" class="text-gray-400 hover:text-gray-600">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                          </svg>
                        </button>
                      </div>
                    </th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-progress">
                      <div class="flex items-center gap-1.5">
                        Progress
                        <button onclick="if(window.projectTableView) window.projectTableView.handleSort('progress')" class="text-gray-400 hover:text-gray-600">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                          </svg>
                        </button>
                      </div>
                    </th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-timeline">Timeline</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-location">Location</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider column-actions">Actions</th>
                  </tr>
                </thead>
                <tbody id="projectsTableBody" class="bg-white divide-y divide-gray-200">
                  {projects.map((project) => {
                    const progress = project.progress || {
                      // Use new field names from backend with proper field mapping
                      timeline: project.progress?.timeline || project.progress?.internalTimeline || project.timelineProgress || 0,
                      budget: project.progress?.budget || project.progress?.internalBudget || project.budgetProgress || 0,
                      physical: project.progress?.physical || project.progress?.internalPhysical || project.physicalProgress || 0,
                      overall: project.progress?.overall || project.overallProgress || 0
                    };
                    
                    return (
                      <tr data-project-id={project.id} class="group hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 whitespace-nowrap">
                          <div class="flex items-center gap-2">
                            <input
                              type="checkbox"
                              class="project-checkbox w-4 h-4 rounded border-gray-300 text-[#0D7DB5] focus:ring-[#0D7DB5] cursor-pointer"
                              value={project.id}
                              onchange="if(window.projectBulkActionsCenter) window.projectBulkActionsCenter.toggleSelection(this.value)"
                            />
                            <input
                              type="checkbox"
                              class="project-compare-checkbox w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer"
                              value={project.id}
                              onchange="if(window.projectComparisonCenter) { window.projectComparisonCenter.toggleSelection(this.value); const selected = window.projectComparisonCenter.getSelectedProjects(); document.getElementById('selectedForComparison').textContent = selected.length; }"
                              title="Select for comparison"
                            />
                          </div>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap column-project">
                          <div class="flex items-center gap-2">
                            <div>
                              <div class="text-sm font-medium text-gray-900">{project.name}</div>
                              <div class="text-xs text-gray-500">{project.projectCode}</div>
                            </div>
                            <button
                              onclick={`if(window.projectOrganizationCenter) { const isBookmarked = window.projectOrganizationCenter.isBookmarked('${project.id}'); window.projectOrganizationCenter.toggleBookmark('${project.id}'); }`}
                              class="text-gray-400 hover:text-[#0D7DB5] transition-colors"
                              title="Bookmark"
                            >
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                              </svg>
                            </button>
                          </div>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap column-category">
                          <span class={`px-2 py-0.5 text-xs font-medium rounded-full capitalize ${
                            project.category === 'infrastructure' ? 'bg-blue-100 text-blue-700' :
                            project.category === 'health' ? 'bg-green-100 text-green-700' :
                            project.category === 'education' ? 'bg-purple-100 text-purple-700' :
                            project.category === 'agriculture' ? 'bg-yellow-100 text-yellow-700' :
                            project.category === 'environment' ? 'bg-emerald-100 text-emerald-700' :
                            project.category === 'transportation' ? 'bg-blue-100 text-[#0D7DB5]' :
                            'bg-gray-100 text-gray-700'
                          }`}>{project.category}</span>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap column-status">
                          {(() => {
                            // Normalize status - convert pending to ongoing
                            const normalizedStatus = (project.status === 'pending' || project.status === 'Pending' || project.status === 'PENDING') 
                              ? 'ongoing' 
                              : (project.status || 'ongoing');
                            return (
                              <span class={`px-2 py-0.5 text-xs font-medium rounded-full ${
                                normalizedStatus === 'ongoing' ? 'bg-blue-100 text-blue-700' :
                                normalizedStatus === 'complete' || normalizedStatus === 'completed' ? 'bg-green-100 text-green-700' :
                                normalizedStatus === 'delayed' ? 'bg-red-100 text-red-700' :
                                'bg-gray-100 text-gray-700'
                              }`}>{normalizedStatus}</span>
                            );
                          })()}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap column-budget">
                          <div class="text-sm text-gray-900">{formatBudget(project.totalBudget)}</div>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap column-progress">
                          <div class="flex items-center">
                            <div class="w-16 bg-gray-200 rounded-full h-2 mr-2 overflow-hidden">
                              <div 
                                class="h-2 rounded-full transition-all duration-2000 ease-out table-progress-bar-fill"
                                style="width: 0%"
                                data-progress={progress.overall}
                                data-progress-color={progress.overall >= 0 && progress.overall <= 25 ? 'bg-red-500' : progress.overall >= 26 && progress.overall <= 50 ? 'bg-yellow-500' : progress.overall >= 51 && progress.overall <= 75 ? 'bg-blue-500' : progress.overall >= 76 && progress.overall <= 100 ? 'bg-green-500' : 'bg-gray-500'}
                              ></div>
                            </div>
                            <span class="text-xs text-gray-900">{progress.overall}%</span>
                          </div>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-xs text-gray-900 column-timeline">
                          {project.endDate || 'N/A'}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap column-location">
                          <div class="text-xs text-gray-900">{project.location || 'N/A'}</div>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-xs font-medium column-actions">
                          <div class="flex items-center gap-1.5 overflow-x-auto">
                            <button 
                              onclick={`viewProjectDetails('${project.id}')`} 
                              class="px-2 py-1 bg-blue-500 hover:bg-blue-600 text-white text-xs font-medium rounded transition-all whitespace-nowrap flex-shrink-0"
                            >
                              View
                            </button>
                            <button 
                              onclick={`editProject('${project.id}')`} 
                              class="px-2 py-1 bg-[#0D7DB5] hover:bg-[#0A6A9A] text-white text-xs font-medium rounded transition-all whitespace-nowrap flex-shrink-0"
                            >
                              Edit
                            </button>
                            <button 
                              onclick={`if(window.projectAssignmentCenter) window.projectAssignmentCenter.openModal(${JSON.stringify(project)})`} 
                              class="px-2 py-1 bg-teal-500 hover:bg-teal-600 text-white text-xs font-medium rounded transition-all whitespace-nowrap flex-shrink-0"
                              title="Assign/Reassign EIU"
                            >
                              Assign EIU
                            </button>
                            <button 
                              onclick={`if(window.projectNotesCenter) window.projectNotesCenter.openModal(${JSON.stringify(project)})`} 
                              class="px-2 py-1 bg-[#0D7DB5] hover:bg-[#0A6A9A] text-white text-xs font-medium rounded transition-all whitespace-nowrap flex-shrink-0"
                              title="Add Notes & Annotations"
                            >
                              Notes
                            </button>
                            <button 
                              onclick={`if(window.projectArchivingCenter) { const project = ${JSON.stringify(project)}; const status = project.status?.toLowerCase(); if(status === 'complete') { window.projectArchivingCenter.openModal(project); } else { if(window.projectArchivingCenter.showWarningModal) { window.projectArchivingCenter.showWarningModal('Only projects with "Complete" status can be archived.'); } } }`} 
                              class="px-2 py-1 bg-gray-500 hover:bg-gray-600 text-white text-xs font-medium rounded transition-all whitespace-nowrap flex-shrink-0"
                              title="Archive Project (Only Pending/Complete)"
                            >
                              Archive
                            </button>
                            {project.status === 'complete' ? (
                              <button 
                                onclick={`generateReport('${project.id}')`} 
                                class="px-2 py-1 bg-green-500 hover:bg-green-600 text-white text-xs font-medium rounded transition-all whitespace-nowrap flex-shrink-0"
                              >
                                Report
                              </button>
                            ) : (
                              <button 
                                onclick={`updateProgress('${project.id}')`} 
                                class="px-2 py-1 bg-green-500 hover:bg-green-600 text-white text-xs font-medium rounded transition-all whitespace-nowrap flex-shrink-0"
                              >
                                Update
                              </button>
                            )}
                            <button 
                              onclick={`window.showDeleteConfirmModal('${project.id}', '${(project.name || '').replace(/'/g, "\\'")}')`} 
                              class="px-2 py-1 bg-red-500 hover:bg-red-600 text-white text-xs font-medium rounded transition-all whitespace-nowrap flex-shrink-0"
