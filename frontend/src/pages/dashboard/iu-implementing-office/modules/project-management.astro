  // Project Analytics & Statistics Dashboard
  async function openProjectAnalyticsModal() {
    const modal = document.getElementById('projectAnalyticsModal');
    const loadingEl = document.getElementById('projectAnalyticsLoading');
    const contentEl = document.getElementById('projectAnalyticsContent');
    
    if (!modal) return;
    
    modal.classList.remove('hidden');
    
    if (loadingEl) loadingEl.classList.remove('hidden');
    if (contentEl) contentEl.style.display = 'none';
    
    try {
      // Load Chart.js dynamically
      if (typeof Chart === 'undefined') {
        await new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
          script.onload = resolve;
          script.onerror = () => reject(new Error('Failed to load Chart.js'));
          document.head.appendChild(script);
        });
      }
      
      // Load and render analytics
      await loadProjectAnalytics();
      
      // Hide loading, show content
      if (loadingEl) loadingEl.classList.add('hidden');
      if (contentEl) contentEl.style.display = 'block';
    } catch (error) {
      console.error('Error loading analytics:', error);
      if (loadingEl) loadingEl.classList.add('hidden');
      if (contentEl) {
        contentEl.innerHTML = `
          <div class="text-center py-12">
            <p class="text-red-500">Failed to load analytics. Please try again.</p>
          </div>
        `;
      }
    }
  }

  function closeProjectAnalyticsModal() {
    const modal = document.getElementById('projectAnalyticsModal');
    if (modal) {
      modal.classList.add('hidden');
      // Destroy all charts to free memory
      Object.values(window.projectAnalyticsCharts || {}).forEach(chart => {
        if (chart && typeof chart.destroy === 'function') {
          chart.destroy();
        }
      });
      window.projectAnalyticsCharts = {};
    }
  }

  async function loadProjectAnalytics() {
    const projects = window.allProjects || [];
    const timeRange = document.getElementById('projectAnalyticsTimeRange')?.value || 'all';
    
    // Filter projects by time range
    let filteredProjects = [...projects];
    if (timeRange !== 'all') {
      const now = new Date();
      const daysAgo = parseInt(timeRange);
      const cutoffDate = new Date(now.getTime() - (daysAgo * 24 * 60 * 60 * 1000));
      filteredProjects = projects.filter(p => {
        const createdDate = new Date(p.createdAt || p.createdDate);
        return createdDate >= cutoffDate;
      });
    }

    // Fetch accurate utilized budget from /api/home/stats (uses approved milestone submissions)
    let accurateUtilizedBudget = 0;
    try {
      const token = localStorage.getItem('token') || sessionStorage.getItem('token');
      if (token) {
        const API_URL = window.getApiUrl ? window.getApiUrl() : (() => {
          const isProd = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
          return isProd 
            ? `${window.location.protocol}//${window.location.hostname}/api`
            : 'http://localhost:3000/api';
        })();
        
        const statsResponse = await fetch(`${API_URL}/home/stats`, {
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        });
        
        if (statsResponse.ok) {
          const statsData = await statsResponse.json();
          if (statsData.success && statsData.utilizedBudget !== undefined) {
            accurateUtilizedBudget = parseFloat(statsData.utilizedBudget) || 0;
            console.log('💰 Analytics: Using accurate utilized budget from /api/home/stats:', accurateUtilizedBudget);
          }
        }
      }
    } catch (error) {
      console.warn('⚠️ Analytics: Failed to fetch accurate utilized budget, using fallback calculation:', error);
    }
    
    // Fallback: Calculate from project data if API fails
    let calculatedUtilizedBudget = 0;
    if (accurateUtilizedBudget === 0) {
      // Try to calculate from milestone submissions in project data
      filteredProjects.forEach(p => {
        if (p.milestones && Array.isArray(p.milestones)) {
          p.milestones.forEach(milestone => {
            if (milestone.submissions && Array.isArray(milestone.submissions)) {
              const approvedSubmission = milestone.submissions
                .filter(s => s.status === 'approved' || s.status === 'iu_approved')
                .sort((a, b) => new Date(b.submittedAt || b.createdAt || 0) - new Date(a.submittedAt || a.createdAt || 0))[0];
              
              if (approvedSubmission) {
                calculatedUtilizedBudget += parseFloat(approvedSubmission.usedBudget || approvedSubmission.budgetUsed || 0);
              }
            }
          });
        }
      });
      
      // Final fallback: Use amountSpent if available
      if (calculatedUtilizedBudget === 0) {
        calculatedUtilizedBudget = filteredProjects.reduce((sum, p) => {
          return sum + parseFloat(p.amountSpent || p.usedBudget || p.budgetUsed || 0);
        }, 0);
      }
    }

    // Calculate statistics
    const stats = {
      total: filteredProjects.length,
      ongoing: filteredProjects.filter(p => p.status === 'ongoing' || p.status === 'delayed').length,
      completed: filteredProjects.filter(p => 
        p.status === 'complete' || 
        p.status === 'completed' || 
        p.status === 'COMPLETED' ||
        p.status?.toLowerCase() === 'complete' ||
        p.status?.toLowerCase() === 'completed'
      ).length,
      delayed: filteredProjects.filter(p => p.status === 'delayed').length,
      notStarted: filteredProjects.filter(p => !p.status || p.status === 'not_started').length,
      totalBudget: filteredProjects.reduce((sum, p) => sum + parseFloat(p.totalBudget || 0), 0),
      utilizedBudget: accurateUtilizedBudget > 0 ? accurateUtilizedBudget : calculatedUtilizedBudget,
      avgProgress: filteredProjects.length > 0 
        ? filteredProjects.reduce((sum, p) => sum + parseFloat(p.overallProgress || 0), 0) / filteredProjects.length 
        : 0
    };

    // Update statistics display
    document.getElementById('analyticsTotalProjects').textContent = stats.total;
    document.getElementById('analyticsOngoingProjects').textContent = stats.ongoing;
    document.getElementById('analyticsCompletedProjects').textContent = stats.completed;
    document.getElementById('analyticsDelayedProjects').textContent = stats.delayed;
    document.getElementById('analyticsTotalBudget').textContent = `₱${stats.totalBudget.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    document.getElementById('analyticsUtilizedBudget').textContent = `₱${stats.utilizedBudget.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    document.getElementById('analyticsAvgProgress').textContent = `${stats.avgProgress.toFixed(1)}%`;

    // Render all charts
    renderProjectCharts(filteredProjects);
  }

