  // Show comprehensive EIU profile information - expose immediately to global scope
  window.showEIUProfile = async function(user) {
    const validationMessage = document.getElementById('eiuValidationMessage');
    if (!validationMessage) return;
    
    // Set verification status for validation
    validationMessage.setAttribute('data-verified', 'true');
    validationMessage.classList.add('text-green-600');

    console.log('EIU User Data:', user); // Debug log to see all available fields

    // Format birthdate - check multiple possible field names
    const birthdateValue = user.birthdate || user.birthDate || user.birth_date;
    const birthdate = birthdateValue ? new Date(birthdateValue).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long', 
      day: 'numeric'
    }) : 'Not specified';

    // Get profile picture URL - try multiple sources and fetch from server if needed
    let profilePicture = user.profilePictureUrl || user.profilePicture || user.profile_picture || user.avatar;
    
    // Always try to fetch from server to get the latest profile picture
    try {
      const userId = user.userId || user.id;
      if (userId) {
        const token = localStorage.getItem('token');
        const apiUrl = window.getApiUrl();
        const response = await fetch(`${apiUrl}/profile/picture/${encodeURIComponent(userId)}?t=${Date.now()}`, {
          headers: token ? { 'Authorization': `Bearer ${token}` } : {}
        });
        if (response.ok) {
          const data = await response.json();
          if (data.success && data.profilePictureUrl && data.profilePictureUrl !== 'null' && data.profilePictureUrl !== '') {
            profilePicture = data.profilePictureUrl;
          }
        }
      }
    } catch (error) {
      console.error('Error fetching profile picture:', error);
    }
    
    // Normalize profile picture URL
    if (profilePicture && profilePicture !== 'null' && profilePicture !== '' && profilePicture !== 'undefined') {
      // Handle relative URLs
      if (profilePicture.startsWith('/') && !profilePicture.startsWith('//')) {
        const apiUrl = window.getApiUrl();
        profilePicture = apiUrl.replace('/api', '') + profilePicture;
      } else if (profilePicture.startsWith('uploads/')) {
        const apiUrl = window.getApiUrl();
        const baseUrl = apiUrl.replace('/api', '');
        profilePicture = baseUrl + '/' + profilePicture;
      }
      // If it's already a full URL (http/https), use it as is
      // If it's a data URL, use it as is
    } else {
      // Fallback to generated avatar
      const initials = (user.name || 'EIU').split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
      profilePicture = `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name || 'EIU')}&background=92751F&color=fff&size=128`;
    }
    
    // Get ongoing projects count from selected option or calculate
    const eiuSelect = document.getElementById('eiuPersonnelId');
    let ongoingProjectsCount = 0;
    let ongoingProjects = [];
    
    if (eiuSelect && eiuSelect.value) {
      const selectedOption = eiuSelect.options[eiuSelect.selectedIndex];
      if (selectedOption) {
        ongoingProjectsCount = parseInt(selectedOption.getAttribute('data-eiu-ongoing-count') || '0');
      }
    }
    
    // If count not found in option, calculate from projects
    if (ongoingProjectsCount === 0) {
      try {
        const token = localStorage.getItem('token');
        const apiUrl = window.getApiUrl();
        const projectsResponse = await fetch(`${apiUrl}/projects?limit=1000`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (projectsResponse.ok) {
          const projectsData = await projectsResponse.json();
          const allProjects = projectsData.success && projectsData.projects ? projectsData.projects : [];
          const userId = user.id || user.userId;
          ongoingProjects = allProjects.filter(p => 
            p.eiuPersonnelId === userId && 
            (p.status === 'ongoing' || p.status === 'delayed' || p.status === 'in_progress' || !p.status || p.status === 'active')
          );
          ongoingProjectsCount = ongoingProjects.length;
        }
      } catch (error) {
        console.error('Error fetching projects for ongoing count:', error);
      }
    }

    // Build comprehensive profile display
    const profileHTML = `
      <div class="bg-green-50 border border-green-200 rounded-xl p-6 space-y-4">
