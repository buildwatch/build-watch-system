---
// LGUFooter.astro: Enhanced professional footer with modern styling
// Theme prop: 'blue' (default), 'orange', 'green', 'light-blue', 'black'
interface Props {
  theme?: 'blue' | 'orange' | 'green' | 'light-blue' | 'black';
}

const { theme = 'blue' } = Astro.props;

// Theme color mappings
const themeColors = {
  blue: {
    divider: 'from-blue-600 via-blue-700 to-blue-600',
    dividerOverlay: 'from-transparent via-blue-400/20 to-transparent',
    dividerCenter: 'via-white/60',
    sectionBorder: 'border-blue-100',
    heading: 'text-blue-700',
    subheading: 'text-blue-600/80',
    cardBorder: 'border-blue-100/50',
    cardBorderHover: 'hover:border-blue-200/60',
    cardBg: 'from-white to-blue-50',
    cardBorderInner: 'border-blue-200/30',
    text: 'text-blue-700',
    textLight: 'text-blue-600/70',
    bgGradient: 'from-blue-700 via-blue-600 to-blue-700',
    bgCard: 'bg-white/10',
    borderCard: 'border-white/20',
    bgCardHover: 'hover:bg-white/15',
    textIcon: 'text-blue-200',
    textWhite: 'text-white',
    link: 'text-blue-600',
    linkHover: 'hover:text-blue-800',
    bgGradientLight: 'from-blue-50 to-indigo-50'
  },
  orange: {
    divider: 'from-orange-600 via-orange-700 to-orange-600',
    dividerOverlay: 'from-transparent via-orange-400/20 to-transparent',
    dividerCenter: 'via-white/60',
    sectionBorder: 'border-orange-100',
    heading: 'text-orange-700',
    subheading: 'text-orange-600/80',
    cardBorder: 'border-orange-100/50',
    cardBorderHover: 'hover:border-orange-200/60',
    cardBg: 'from-white to-orange-50',
    cardBorderInner: 'border-orange-200/30',
    text: 'text-orange-700',
    textLight: 'text-orange-600/70',
    bgGradient: 'from-orange-700 via-orange-600 to-orange-700',
    bgCard: 'bg-white/10',
    borderCard: 'border-white/20',
    bgCardHover: 'hover:bg-white/15',
    textIcon: 'text-orange-200',
    textWhite: 'text-white',
    link: 'text-orange-600',
    linkHover: 'hover:text-orange-800',
    bgGradientLight: 'from-orange-50 to-amber-50'
  },
  green: {
    divider: 'from-green-600 via-green-700 to-green-600',
    dividerOverlay: 'from-transparent via-green-400/20 to-transparent',
    dividerCenter: 'via-white/60',
    sectionBorder: 'border-green-100',
    heading: 'text-green-700',
    subheading: 'text-green-600/80',
    cardBorder: 'border-green-100/50',
    cardBorderHover: 'hover:border-green-200/60',
    cardBg: 'from-white to-green-50',
    cardBorderInner: 'border-green-200/30',
    text: 'text-green-700',
    textLight: 'text-green-600/70',
    bgGradient: 'from-green-700 via-green-600 to-green-700',
    bgCard: 'bg-white/10',
    borderCard: 'border-white/20',
    bgCardHover: 'hover:bg-white/15',
    textIcon: 'text-green-200',
    textWhite: 'text-white',
    link: 'text-green-600',
    linkHover: 'hover:text-green-800',
    bgGradientLight: 'from-green-50 to-emerald-50'
  },
  'light-blue': {
    divider: 'from-sky-600 via-sky-700 to-sky-600',
    dividerOverlay: 'from-transparent via-sky-400/20 to-transparent',
    dividerCenter: 'via-white/60',
    sectionBorder: 'border-sky-100',
    heading: 'text-sky-700',
    subheading: 'text-sky-600/80',
    cardBorder: 'border-sky-100/50',
    cardBorderHover: 'hover:border-sky-200/60',
    cardBg: 'from-white to-sky-50',
    cardBorderInner: 'border-sky-200/30',
    text: 'text-sky-700',
    textLight: 'text-sky-600/70',
    bgGradient: 'from-sky-700 via-sky-600 to-sky-700',
    bgCard: 'bg-white/10',
    borderCard: 'border-white/20',
    bgCardHover: 'hover:bg-white/15',
    textIcon: 'text-sky-200',
    textWhite: 'text-white',
    link: 'text-sky-600',
    linkHover: 'hover:text-sky-800',
    bgGradientLight: 'from-sky-50 to-cyan-50'
  },
  black: {
    divider: 'from-gray-800 via-gray-900 to-gray-800',
    dividerOverlay: 'from-transparent via-gray-600/20 to-transparent',
    dividerCenter: 'via-white/60',
    sectionBorder: 'border-gray-200',
    heading: 'text-gray-900',
    subheading: 'text-gray-700/80',
    cardBorder: 'border-gray-200/50',
    cardBorderHover: 'hover:border-gray-300/60',
    cardBg: 'from-white to-gray-50',
    cardBorderInner: 'border-gray-300/30',
    text: 'text-gray-900',
    textLight: 'text-gray-700/70',
    bgGradient: 'from-gray-900 via-gray-800 to-gray-900',
    bgCard: 'bg-white/10',
    borderCard: 'border-white/20',
    bgCardHover: 'hover:bg-white/15',
    textIcon: 'text-gray-200',
    textWhite: 'text-white',
    link: 'text-gray-700',
    linkHover: 'hover:text-gray-900',
    bgGradientLight: 'from-gray-50 to-slate-50'
  }
};

const colors = themeColors[theme] || themeColors.blue;
---
<footer class="w-full bg-gradient-to-b from-slate-50 to-white relative">
  {/* Elegant Thin Divider Line */}
  <div class={`w-full h-0.5 bg-gradient-to-r ${colors.divider} relative`}>
    <div class={`absolute inset-0 bg-gradient-to-r ${colors.dividerOverlay}`}></div>
    <div class={`absolute top-0 left-1/2 transform -translate-x-1/2 w-24 h-px bg-gradient-to-r from-transparent ${colors.dividerCenter} to-transparent`}></div>
  </div>
  {/* Enhanced Partnerships Section */}
  <div class={`w-full border-b ${colors.sectionBorder} pb-8 pt-6`}>
    <div class="text-center mb-8">
      <h3 class={`text-2xl font-bold ${colors.heading} mb-2`}>Collaborative Partnerships</h3>
      <p class={`${colors.subheading} text-lg font-medium`}>Working together with the following NGAs, NGOs, and PPMCs</p>
    </div>
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {/* Enhanced Agency Cards */}
        <div class={`group bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-lg border ${colors.cardBorder} hover:shadow-xl ${colors.cardBorderHover} transition-all duration-300 hover:-translate-y-1`}>
          <div class="flex flex-col items-center text-center space-y-3">
            <div class={`w-20 h-20 flex items-center justify-center bg-gradient-to-br ${colors.cardBg} border ${colors.cardBorderInner} rounded-xl shadow-md group-hover:scale-105 transition-transform duration-300`}>
              <img src="/agency-dpwh.png" alt="DPWH" class="w-14 h-14 object-contain" />
            </div>
            <div>
              <span class={`font-bold ${colors.text} text-sm block`}>DPWH</span>
              <span class={`text-xs ${colors.textLight} leading-tight`}>Department of Public Works and Highways</span>
            </div>
          </div>
        </div>
        <div class={`group bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-lg border ${colors.cardBorder} hover:shadow-xl ${colors.cardBorderHover} transition-all duration-300 hover:-translate-y-1`}>
          <div class="flex flex-col items-center text-center space-y-3">
            <div class={`w-20 h-20 flex items-center justify-center bg-gradient-to-br ${colors.cardBg} border ${colors.cardBorderInner} rounded-xl shadow-md group-hover:scale-105 transition-transform duration-300`}>
              <img src="/agency-philsa.png" alt="PHILSA" class="w-14 h-14 object-contain" />
            </div>
            <div>
              <span class={`font-bold ${colors.text} text-sm block`}>PHILSA</span>
              <span class={`text-xs ${colors.textLight} leading-tight`}>Philippine Space Agency</span>
            </div>
          </div>
        </div>
        <div class={`group bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-lg border ${colors.cardBorder} hover:shadow-xl ${colors.cardBorderHover} transition-all duration-300 hover:-translate-y-1`}>
          <div class="flex flex-col items-center text-center space-y-3">
            <div class={`w-20 h-20 flex items-center justify-center bg-gradient-to-br ${colors.cardBg} border ${colors.cardBorderInner} rounded-xl shadow-md group-hover:scale-105 transition-transform duration-300`}>
              <img src="/agency-dotr.png" alt="DOTr" class="w-14 h-14 object-contain" />
            </div>
            <div>
              <span class={`font-bold ${colors.text} text-sm block`}>DOTr</span>
              <span class={`text-xs ${colors.textLight} leading-tight`}>Department of Transportation</span>
            </div>
          </div>
        </div>
        <div class={`group bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-lg border ${colors.cardBorder} hover:shadow-xl ${colors.cardBorderHover} transition-all duration-300 hover:-translate-y-1`}>
          <div class="flex flex-col items-center text-center space-y-3">
            <div class={`w-20 h-20 flex items-center justify-center bg-gradient-to-br ${colors.cardBg} border ${colors.cardBorderInner} rounded-xl shadow-md group-hover:scale-105 transition-transform duration-300`}>
              <img src="/agency-namria.png" alt="NAMRIA" class="w-14 h-14 object-contain" />
            </div>
            <div>
              <span class={`font-bold ${colors.text} text-sm block`}>NAMRIA</span>
              <span class={`text-xs ${colors.textLight} leading-tight`}>National Mapping and Resource Information Authority</span>
            </div>
          </div>
        </div>
        <div class={`group bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-lg border ${colors.cardBorder} hover:shadow-xl ${colors.cardBorderHover} transition-all duration-300 hover:-translate-y-1`}>
          <div class="flex flex-col items-center text-center space-y-3">
            <div class={`w-20 h-20 flex items-center justify-center bg-gradient-to-br ${colors.cardBg} border ${colors.cardBorderInner} rounded-xl shadow-md group-hover:scale-105 transition-transform duration-300`}>
              <img src="/agency-neda.png" alt="NEDA" class="w-14 h-14 object-contain" />
            </div>
            <div>
              <span class={`font-bold ${colors.text} text-sm block`}>NEDA</span>
              <span class={`text-xs ${colors.textLight} leading-tight`}>Nation Economic and Development Authority</span>
            </div>
          </div>
        </div>
        <div class={`group bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-lg border ${colors.cardBorder} hover:shadow-xl ${colors.cardBorderHover} transition-all duration-300 hover:-translate-y-1`}>
          <div class="flex flex-col items-center text-center space-y-3">
            <div class={`w-20 h-20 flex items-center justify-center bg-gradient-to-br ${colors.cardBg} border ${colors.cardBorderInner} rounded-xl shadow-md group-hover:scale-105 transition-transform duration-300`}>
              <img src="/agency-lra.png" alt="LRA" class="w-14 h-14 object-contain" />
            </div>
            <div>
              <span class={`font-bold ${colors.text} text-sm block`}>LRA</span>
              <span class={`text-xs ${colors.textLight} leading-tight`}>Land Registration Authority</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Enhanced Contact Information Section */}
  <div class={`w-full bg-gradient-to-r ${colors.bgGradient} text-white py-10 px-4 rounded-t-3xl`}>
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {/* Contact Information */}
        <div class={`${colors.bgCard} backdrop-blur-sm rounded-2xl p-6 border ${colors.borderCard} ${colors.bgCardHover} transition-all duration-300`}>
          <div class="flex flex-col items-center lg:items-start space-y-4">
            <div class="w-24 h-24 bg-white/20 rounded-2xl flex items-center justify-center shadow-lg">
              <img src="/santa-cruz-seal.png" alt="Santa Cruz Seal" class="w-20 h-20" />
            </div>
            <div class="text-center lg:text-left space-y-2">
              <h4 class={`font-bold text-lg ${colors.textWhite} mb-3`}>Contact Information</h4>
              <div class="flex items-start gap-2 text-sm">
                <svg class={`w-4 h-4 ${colors.textIcon} mt-0.5 flex-shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span class={colors.textIcon}>7CJ7+MQ3, Gen. Cailles St, Santa Cruz, Laguna, Philippines</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <svg class={`w-4 h-4 ${colors.textIcon} flex-shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <span class={colors.textIcon}>Phone No. (049) 808 2788</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <svg class={`w-4 h-4 ${colors.textIcon} flex-shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <span class={colors.textIcon}>santacruzlaguna@gmail.com</span>
              </div>
            </div>
          </div>
        </div>

        {/* Government Services */}
        <div class={`${colors.bgCard} backdrop-blur-sm rounded-2xl p-6 border ${colors.borderCard} ${colors.bgCardHover} transition-all duration-300`}>
          <h4 class={`font-bold text-lg ${colors.textWhite} mb-4`}>Government Services</h4>
          <div class="space-y-2">
            <a href="#" class={`block text-sm ${colors.textIcon} hover:text-white hover:translate-x-1 transition-all duration-200 flex items-center gap-2`}>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Government Directory
            </a>
            <a href="#" class={`block text-sm ${colors.textIcon} hover:text-white hover:translate-x-1 transition-all duration-200 flex items-center gap-2`}>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Procurement Service
            </a>
            <a href="#" class={`block text-sm ${colors.textIcon} hover:text-white hover:translate-x-1 transition-all duration-200 flex items-center gap-2`}>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Philippine Government Electronic Procurement System
            </a>
            <a href="#" class={`block text-sm ${colors.textIcon} hover:text-white hover:translate-x-1 transition-all duration-200 flex items-center gap-2`}>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Government Procurement Policy Board - Technical Support Office
            </a>
            <a href="#" class={`block text-sm ${colors.textIcon} hover:text-white hover:translate-x-1 transition-all duration-200 flex items-center gap-2`}>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Budget and Treasury Management System
            </a>
            <a href="#" class={`block text-sm ${colors.textIcon} hover:text-white hover:translate-x-1 transition-all duration-200 flex items-center gap-2`}>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Unified Accounts Code Structure
            </a>
            <a href="#" class={`block text-sm ${colors.textIcon} hover:text-white hover:translate-x-1 transition-all duration-200 flex items-center gap-2`}>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              LGU 360
            </a>
            <a href="#" class={`block text-sm ${colors.textIcon} hover:text-white hover:translate-x-1 transition-all duration-200 flex items-center gap-2`}>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              BSP Financial Inclusion
            </a>
            <a href="#" class={`block text-sm ${colors.textIcon} hover:text-white hover:translate-x-1 transition-all duration-200 flex items-center gap-2`}>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              Privacy Policy
            </a>
          </div>
        </div>

        {/* Social Media & Official Pages */}
        <div class={`${colors.bgCard} backdrop-blur-sm rounded-2xl p-6 border ${colors.borderCard} ${colors.bgCardHover} transition-all duration-300`}>
          <h4 class={`font-bold text-lg ${colors.textWhite} mb-4`}>Connect with Us</h4>
          <div class="space-y-3">
            <a href="#" class={`flex items-center gap-3 text-sm ${colors.textIcon} hover:text-white transition-all duration-200 group`}>
              <div class={`w-8 h-8 ${theme === 'blue' ? 'bg-blue-500' : theme === 'orange' ? 'bg-orange-500' : theme === 'green' ? 'bg-green-500' : theme === 'light-blue' ? 'bg-sky-500' : 'bg-gray-700'} rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform duration-200`}>
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
