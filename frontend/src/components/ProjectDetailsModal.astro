  // Debugging function for milestone progress calculation
  window.debugMilestoneProgress = async function(projectId = null) {
    const pid = projectId || window.currentProject?.id || window.selectedProject?.id;
    if (!pid) {
      console.error('❌ No project ID available. Please provide projectId or open a project modal first.');
      return;
    }
    
    console.log('🔍 [DEBUG] Starting milestone progress debugging for project:', pid);
    
    try {
      const token = localStorage.getItem('token') || sessionStorage.getItem('token');
      if (!token) {
        console.error('❌ No authentication token found');
        return;
      }
      
      const API_URL = window.getApiUrl();
      
      // Fetch project with milestones
      const projectResponse = await fetch(`${API_URL}/projects/${pid}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      if (!projectResponse.ok) {
        console.error('❌ Failed to fetch project:', projectResponse.status);
        return;
      }
      
      const projectData = await projectResponse.json();
      const project = projectData.project || projectData;
      const milestones = project.milestones || project.ProjectMilestones || [];
      
      console.log('📋 [DEBUG] Project Data:', {
        id: project.id,
        name: project.name,
        milestonesCount: milestones.length
      });
      
      // Fetch milestone submissions
      const submissionsResponse = await fetch(`${API_URL}/milestones/milestone-submissions?projectId=${pid}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      let submissionsMap = {};
      if (submissionsResponse.ok) {
        const submissionsData = await submissionsResponse.json();
        const submissions = submissionsData.submissions || submissionsData.data || [];
        
        submissions.forEach(submission => {
          if (!submissionsMap[submission.milestoneId]) {
            submissionsMap[submission.milestoneId] = [];
          }
          submissionsMap[submission.milestoneId].push(submission);
        });
        
        console.log('📝 [DEBUG] Submissions Map:', {
          totalSubmissions: submissions.length,
          milestonesWithSubmissions: Object.keys(submissionsMap).length,
          submissionsByMilestone: Object.entries(submissionsMap).map(([id, subs]) => ({
            milestoneId: id,
            count: subs.length,
            approved: subs.filter(s => s.status === 'approved' || s.status === 'iu_approved').length
          }))
        });
      }
      
      // Calculate progress for each milestone
      console.log('🧮 [DEBUG] Calculating progress for each milestone:');
      milestones.forEach((milestone, index) => {
        if (submissionsMap[milestone.id]) {
          milestone.submissions = submissionsMap[milestone.id];
        }
        
        const progressData = calculateMilestoneProgress(milestone, submissionsMap);
        
        console.log(`\n📊 [DEBUG] Milestone ${index + 1}: "${milestone.title || milestone.name}"`, {
          milestoneId: milestone.id,
          milestoneWeight: milestone.weight,
          milestoneStatus: milestone.status,
          timelineStatus: milestone.timelineStatus,
          budgetStatus: milestone.budgetStatus,
          physicalStatus: milestone.physicalStatus,
          plannedBudget: milestone.plannedBudget || milestone.budgetPlanned,
          usedBudget: milestone.usedBudget,
          submissions: milestone.submissions?.map(s => ({
            id: s.id,
            status: s.status,
            usedBudget: s.usedBudget,
            budgetUtilizationPercentage: s.budgetUtilizationPercentage,
            approvedAt: s.approvedAt || s.iuApprovedAt
          })) || [],
          calculatedProgress: {
            overall: progressData.overall,
            timeline: progressData.timeline,
            budget: progressData.budget,
            physical: progressData.physical,
            timelineCapacity: progressData.timelineCapacity,
            budgetCapacity: progressData.budgetCapacity,
            physicalCapacity: progressData.physicalCapacity
          },
          display: {
            overallProgress: `${progressData.overall.toFixed(2)}%`,
            timelineLoaded: `${progressData.timeline.toFixed(1)}%`,
            budgetLoaded: `${progressData.budget.toFixed(1)}%`,
            physicalLoaded: `${progressData.physical.toFixed(1)}%`
          }
        });
      });
      
      console.log('\n✅ [DEBUG] Milestone progress debugging complete!');
      console.log('💡 [DEBUG] Compare these values with what you see in Project Summary & Report timetable tab');
      
    } catch (error) {
      console.error('❌ [DEBUG] Error during debugging:', error);
    }
  };
  
  console.log('✅ [ProjectDetailsModal] Debug function available: window.debugMilestoneProgress(projectId)');
</script> 