  // Fetch last updated date from latest LGU-IU approval
  async function fetchLastUpdatedDate(projectId) {
    if (!projectId) return null;
    
    try {
      const token = localStorage.getItem('token') || sessionStorage.getItem('token');
      if (!token) return null;
      
      const API_URL = window.getApiUrl();
      
      // Fetch milestone submissions for this project
      const submissionsResponse = await fetch(`${API_URL}/milestones/milestone-submissions?projectId=${projectId}`, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });
      
      if (submissionsResponse.ok) {
        const submissionsData = await submissionsResponse.json();
        const submissions = submissionsData.submissions || submissionsData.data || [];
        
        // Filter for approved submissions by LGU-IU (status: 'approved' or 'iu_approved')
        const approvedSubmissions = submissions.filter(s => 
          s.status === 'approved' || s.status === 'iu_approved'
        );
        
        if (approvedSubmissions.length > 0) {
          // Sort by approval date (most recent first)
          approvedSubmissions.sort((a, b) => {
            const dateA = new Date(a.approvedAt || a.iuApprovedAt || a.updatedAt || a.createdAt || 0);
            const dateB = new Date(b.approvedAt || b.iuApprovedAt || b.updatedAt || b.createdAt || 0);
            return dateB - dateA;
          });
          
          // Get the most recent approval date
          const latestApproval = approvedSubmissions[0];
          const lastUpdatedDate = latestApproval.approvedAt || latestApproval.iuApprovedAt || latestApproval.updatedAt || latestApproval.createdAt;
          
          console.log('✅ Found last updated date from LGU-IU approval:', lastUpdatedDate);
          return lastUpdatedDate;
        }
      }
      
      console.log('⚠️ No approved submissions found for last updated date');
      return null;
    } catch (error) {
      console.error('❌ Error fetching last updated date:', error);
      return null;
    }
  }

  // Helper function to safely set text content
  function safeSetTextContent(elementId, value) {
    let element = document.getElementById(elementId);
    
    // Special handling for totalBudget to avoid duplicate ID conflicts
    if (elementId === 'totalBudget') {
      // Try to find the element within the modal specifically
      const modal = document.getElementById('projectDetailsModal');
      if (modal) {
        const modalElement = modal.querySelector('#totalBudget');
        if (modalElement) {
          element = modalElement;
        } else {
          // If multiple elements exist, find the one inside the modal
          const allElements = document.querySelectorAll('#totalBudget');
          if (allElements.length > 1) {
            element = Array.from(allElements).find(el => el.closest('#projectDetailsModal') === modal) || element;
          }
        }
      }
      
      console.log('💰 safeSetTextContent called for totalBudget:');
      console.log('  - element found:', !!element);
      console.log('  - element is in modal:', element ? element.closest('#projectDetailsModal') !== null : false);
      console.log('  - value:', value);
      console.log('  - value type:', typeof value);
      console.log('  - value after trim:', value !== null && value !== undefined ? String(value).trim() : 'null/undefined');
    }
    
    if (element) {
      // Only show N/A if value is null, undefined, or empty string after trimming
      const displayValue = (value !== null && value !== undefined && String(value).trim() !== '') 
        ? String(value).trim() 
        : 'N/A';
      element.textContent = displayValue;
      
      // Add debugging for totalBudget element
      if (elementId === 'totalBudget') {
