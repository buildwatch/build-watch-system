    // Check if all milestones are completed and update project status accordingly
    if (project.milestones && Array.isArray(project.milestones) && project.milestones.length > 0) {
      const allMilestonesCompleted = project.milestones.every(milestone => {
        const status = milestone.status || 'pending';
        const hasApprovedSubmission = milestone.submissions?.some(s => 
          s.status === 'approved' || s.status === 'iu_approved'
        ) || false;
        const hasApprovedDivisions = milestone.timelineStatus === 'approved' || 
                                     milestone.budgetStatus === 'approved' || 
                                     milestone.physicalStatus === 'approved';
        return status === 'completed' || status === 'approved' || hasApprovedSubmission || hasApprovedDivisions;
      });
      
      if (allMilestonesCompleted && project.status !== 'completed' && project.status !== 'complete') {
        project.status = 'completed';
        // Set actual completion date if not already set
        if (!project.actualCompletionDate && !project.completionDate) {
          // Find the last completed milestone's completion date
          const completedMilestones = project.milestones.filter(m => {
            const status = m.status || 'pending';
            const hasApprovedSubmission = m.submissions?.some(s => 
              s.status === 'approved' || s.status === 'iu_approved'
            ) || false;
            return status === 'completed' || status === 'approved' || hasApprovedSubmission;
          });
          
          if (completedMilestones.length > 0) {
