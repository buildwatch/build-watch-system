  // Calculate milestone-specific progress (not project overall progress)
  // This matches the calculation logic from progress-timeline.astro
  function calculateMilestoneProgress(milestone, submissionsMap = null) {
    console.log(`🔍 [ProjectDetailsModal] calculateMilestoneProgress for "${milestone.title || milestone.name}"`, {
      milestoneId: milestone.id,
      milestoneStatus: milestone.status,
      milestoneWeight: milestone.weight,
      milestoneProgress: milestone.progress,
      hasSubmissions: !!(milestone.submissions && Array.isArray(milestone.submissions)),
      submissionsCount: milestone.submissions?.length || 0,
      hasSubmissionsMap: !!submissionsMap
    });
    
    // PRIORITY 1: Check if milestone has its own individual progress value (from milestone update)
    // This is the actual progress gained for this specific milestone
    if (milestone.progress !== undefined && milestone.progress !== null && milestone.progress !== 0) {
      const progress = parseFloat(milestone.progress);
      if (progress > 0) {
        console.log(`✅ [ProjectDetailsModal] Using milestone's individual progress: ${progress}%`);
        // Distribute evenly across divisions for display
        const divProgress = progress / 3;
        return {
          overall: progress,
          timeline: divProgress,
          budget: divProgress,
          physical: divProgress,
          timelineCapacity: milestone.timelineWeight || milestone.weight / 3,
          budgetCapacity: milestone.budgetWeight || milestone.weight / 3,
          physicalCapacity: milestone.physicalWeight || milestone.weight / 3
        };
      }
    }
    
    // Attach submissions from submissionsMap if milestone doesn't have them
    if (!milestone.submissions && submissionsMap && submissionsMap[milestone.id]) {
      milestone.submissions = submissionsMap[milestone.id];
      console.log(`✅ [ProjectDetailsModal] Attached ${milestone.submissions.length} submissions from map`);
    }
    
    // PRIORITY 2: For completed/approved milestones, calculate from approved submissions
    const isCompleted = milestone.status === 'completed' || milestone.status === 'approved' ||
                       (milestone.timelineStatus === 'approved' && milestone.budgetStatus === 'approved' && milestone.physicalStatus === 'approved');
    
    if (isCompleted) {
      const milestoneWeight = parseFloat(milestone.weight || 0);
      if (milestoneWeight > 0) {
        // Get division weights (default to equal distribution if not set)
        const timelineDivWeight = parseFloat(milestone.timelineWeight || milestoneWeight / 3);
        const budgetDivWeight = parseFloat(milestone.budgetWeight || milestoneWeight / 3);
        const physicalDivWeight = parseFloat(milestone.physicalWeight || milestoneWeight / 3);
        
        // Get budget data from milestone or approved submission
        let plannedBudget = parseFloat(milestone.plannedBudget || milestone.budgetPlanned || 0);
        let usedBudget = parseFloat(milestone.usedBudget || 0);
        
        console.log(`💰 [ProjectDetailsModal] [${milestone.title}] Initial budget data: plannedBudget=${plannedBudget}, usedBudget=${usedBudget}`);
        
        // Try to get budget data from approved submission if not in milestone
        if ((plannedBudget === 0 || usedBudget === 0 || isNaN(usedBudget)) && milestone.submissions && Array.isArray(milestone.submissions)) {
          const approvedSubmission = milestone.submissions.find(s => 
            s.status === 'approved' || s.status === 'iu_approved'
          );
          if (approvedSubmission) {
            console.log(`📝 [ProjectDetailsModal] Found approved submission for "${milestone.title}":`, {
              usedBudget: approvedSubmission.usedBudget,
              budgetUtilizationPercentage: approvedSubmission.budgetUtilizationPercentage,
              plannedBudget: approvedSubmission.plannedBudget || approvedSubmission.budgetPlanned
            });
            if (plannedBudget === 0) plannedBudget = parseFloat(approvedSubmission.plannedBudget || approvedSubmission.budgetPlanned || 0);
            if (usedBudget === 0 || isNaN(usedBudget)) {
              usedBudget = parseFloat(approvedSubmission.usedBudget || 0);
              // Also try to get from budgetUtilizationPercentage if usedBudget is still 0
              if (usedBudget === 0 && approvedSubmission.budgetUtilizationPercentage && plannedBudget > 0) {
                const utilizationPercent = parseFloat(approvedSubmission.budgetUtilizationPercentage) || 0;
                usedBudget = (plannedBudget * utilizationPercent) / 100;
                console.log(`📊 [ProjectDetailsModal] Calculated usedBudget from budgetUtilizationPercentage: ${usedBudget}`);
              }
            }
          }
        }
        
        // If still no usedBudget, try to get from submissionsMap
        if ((usedBudget === 0 || isNaN(usedBudget)) && submissionsMap && submissionsMap[milestone.id]) {
          const milestoneSubmissions = submissionsMap[milestone.id];
          const approvedSubmission = milestoneSubmissions.find(s => 
            s.status === 'approved' || s.status === 'iu_approved'
          );
          if (approvedSubmission) {
            usedBudget = parseFloat(approvedSubmission.usedBudget || 0);
            if (usedBudget === 0 && approvedSubmission.budgetUtilizationPercentage && plannedBudget > 0) {
              const utilizationPercent = parseFloat(approvedSubmission.budgetUtilizationPercentage) || 0;
              usedBudget = (plannedBudget * utilizationPercent) / 100;
              console.log(`📊 [ProjectDetailsModal] Calculated usedBudget from submissionsMap budgetUtilizationPercentage: ${usedBudget}`);
            }
          }
        }
        
        console.log(`💰 [ProjectDetailsModal] [${milestone.title}] Final budget data: plannedBudget=${plannedBudget}, usedBudget=${usedBudget}`);
        
        // Calculate actual progress based on division statuses and budget utilization
        let actualTimelineProgress = 0;
        let actualBudgetProgress = 0;
        let actualPhysicalProgress = 0;
        
        // Timeline division: if approved/completed, use full weight
        if (milestone.timelineStatus === 'completed' || milestone.timelineStatus === 'approved' || milestone.timelineStatus === 'iu_approved' || milestone.timelineStatus === 'secretariat_approved') {
          actualTimelineProgress = timelineDivWeight;
        } else if (milestone.timelineStatus === 'in_progress' || milestone.timelineStatus === 'ongoing') {
          actualTimelineProgress = timelineDivWeight * 0.5;
        }
        
        // Budget division: calculate from actual budget utilization
        if (milestone.budgetStatus === 'completed' || milestone.budgetStatus === 'approved' || milestone.budgetStatus === 'iu_approved' || milestone.budgetStatus === 'secretariat_approved') {
          if (plannedBudget > 0 && usedBudget > 0) {
            // Use actual budget utilization ratio
            const budgetUtilizationRatio = Math.min(1, usedBudget / plannedBudget);
            actualBudgetProgress = budgetDivWeight * budgetUtilizationRatio;
            console.log(`💰 [ProjectDetailsModal] [${milestone.title}] Budget calculation: usedBudget=${usedBudget}, plannedBudget=${plannedBudget}, ratio=${budgetUtilizationRatio.toFixed(3)}, progress=${actualBudgetProgress.toFixed(2)}%`);
          } else {
            // Try to get budgetUtilizationPercentage from approved submission
            let budgetUtilizationRatio = 1.0; // Default to 100% if no data
            if (milestone.submissions && Array.isArray(milestone.submissions)) {
              const approvedSubmission = milestone.submissions.find(s => 
                s.status === 'approved' || s.status === 'iu_approved'
              );
              if (approvedSubmission && approvedSubmission.budgetUtilizationPercentage !== undefined && approvedSubmission.budgetUtilizationPercentage !== null) {
                budgetUtilizationRatio = Math.min(1, parseFloat(approvedSubmission.budgetUtilizationPercentage) / 100);
                console.log(`✅ [ProjectDetailsModal] Using budgetUtilizationPercentage from submission: ${approvedSubmission.budgetUtilizationPercentage}%`);
              }
            } else if (submissionsMap && submissionsMap[milestone.id]) {
              const approvedSubmission = submissionsMap[milestone.id].find(s => 
                s.status === 'approved' || s.status === 'iu_approved'
              );
              if (approvedSubmission && approvedSubmission.budgetUtilizationPercentage !== undefined && approvedSubmission.budgetUtilizationPercentage !== null) {
                budgetUtilizationRatio = Math.min(1, parseFloat(approvedSubmission.budgetUtilizationPercentage) / 100);
                console.log(`✅ [ProjectDetailsModal] Using budgetUtilizationPercentage from submissionsMap: ${approvedSubmission.budgetUtilizationPercentage}%`);
              }
            }
            actualBudgetProgress = budgetDivWeight * budgetUtilizationRatio;
          }
        } else if (milestone.budgetStatus === 'in_progress' || milestone.budgetStatus === 'ongoing') {
          if (plannedBudget > 0 && usedBudget > 0) {
            const budgetUtilizationRatio = Math.min(1, usedBudget / plannedBudget);
            actualBudgetProgress = budgetDivWeight * budgetUtilizationRatio * 0.5;
          } else {
            // Try to get budgetUtilizationPercentage from approved submission
            let budgetUtilizationRatio = 0.5; // Default to 50% if no data
            if (milestone.submissions && Array.isArray(milestone.submissions)) {
              const approvedSubmission = milestone.submissions.find(s => 
                s.status === 'approved' || s.status === 'iu_approved'
              );
              if (approvedSubmission && approvedSubmission.budgetUtilizationPercentage !== undefined && approvedSubmission.budgetUtilizationPercentage !== null) {
                budgetUtilizationRatio = Math.min(1, parseFloat(approvedSubmission.budgetUtilizationPercentage) / 100) * 0.5;
              }
            } else if (submissionsMap && submissionsMap[milestone.id]) {
              const approvedSubmission = submissionsMap[milestone.id].find(s => 
                s.status === 'approved' || s.status === 'iu_approved'
              );
              if (approvedSubmission && approvedSubmission.budgetUtilizationPercentage !== undefined && approvedSubmission.budgetUtilizationPercentage !== null) {
                budgetUtilizationRatio = Math.min(1, parseFloat(approvedSubmission.budgetUtilizationPercentage) / 100) * 0.5;
              }
            }
            actualBudgetProgress = budgetDivWeight * budgetUtilizationRatio;
          }
        }
        
        // Physical division: if approved/completed, use full weight
        if (milestone.physicalStatus === 'completed' || milestone.physicalStatus === 'approved' || milestone.physicalStatus === 'iu_approved' || milestone.physicalStatus === 'secretariat_approved') {
          actualPhysicalProgress = physicalDivWeight;
        } else if (milestone.physicalStatus === 'in_progress' || milestone.physicalStatus === 'ongoing') {
          actualPhysicalProgress = physicalDivWeight * 0.5;
        }
        
        // Sum up the actual progress from all divisions
        const calculatedProgress = actualTimelineProgress + actualBudgetProgress + actualPhysicalProgress;
        
        console.log(`✅ [ProjectDetailsModal] [${milestone.title}] Calculated milestone progress from division contributions: ${calculatedProgress.toFixed(2)}% (Timeline: ${actualTimelineProgress.toFixed(2)}%, Budget: ${actualBudgetProgress.toFixed(2)}%, Physical: ${actualPhysicalProgress.toFixed(2)}%)`);
        
        return {
          overall: calculatedProgress,
          timeline: actualTimelineProgress,
          budget: actualBudgetProgress,
          physical: actualPhysicalProgress,
          timelineCapacity: timelineDivWeight,
          budgetCapacity: budgetDivWeight,
          physicalCapacity: physicalDivWeight
        };
      }
      
      // If completed but no specific progress, use 100% as fallback
      console.log(`⚠️ [ProjectDetailsModal] Completed milestone but no progress data, using 100%`);
      return {
        overall: 100,
        timeline: milestone.timelineWeight || 33.33,
        budget: milestone.budgetWeight || 33.33,
        physical: milestone.physicalWeight || 33.34,
        timelineCapacity: milestone.timelineWeight || 33.33,
        budgetCapacity: milestone.budgetWeight || 33.33,
        physicalCapacity: milestone.physicalWeight || 33.34
      };
    }
    
    // PRIORITY 3: Calculate based on division statuses for non-completed milestones
    const milestoneWeight = parseFloat(milestone.weight || 0);
    if (milestoneWeight > 0) {
      const timelineDivWeight = parseFloat(milestone.timelineWeight || milestoneWeight / 3);
      const budgetDivWeight = parseFloat(milestone.budgetWeight || milestoneWeight / 3);
      const physicalDivWeight = parseFloat(milestone.physicalWeight || milestoneWeight / 3);
      
      let approvedDivisions = 0;
      let totalDivisions = 0;
      
      if (milestone.timelineStatus) {
        totalDivisions++;
        if (milestone.timelineStatus === 'approved' || milestone.timelineStatus === 'iu_approved') approvedDivisions++;
      }
      if (milestone.budgetStatus) {
        totalDivisions++;
        if (milestone.budgetStatus === 'approved' || milestone.budgetStatus === 'iu_approved') approvedDivisions++;
      }
      if (milestone.physicalStatus) {
        totalDivisions++;
        if (milestone.physicalStatus === 'approved' || milestone.physicalStatus === 'iu_approved') approvedDivisions++;
      }
      
      if (totalDivisions > 0) {
        const divisionProgress = (approvedDivisions / totalDivisions) * milestoneWeight;
        console.log(`✅ [ProjectDetailsModal] Calculated division progress: ${divisionProgress.toFixed(2)}% (${approvedDivisions}/${totalDivisions} divisions approved)`);
        return {
          overall: divisionProgress,
          timeline: milestone.timelineStatus === 'approved' ? timelineDivWeight : 0,
          budget: milestone.budgetStatus === 'approved' ? budgetDivWeight : 0,
          physical: milestone.physicalStatus === 'approved' ? physicalDivWeight : 0,
          timelineCapacity: timelineDivWeight,
          budgetCapacity: budgetDivWeight,
          physicalCapacity: physicalDivWeight
        };
      }
    }
    
    // Default: no progress
    console.log(`⚠️ [ProjectDetailsModal] No progress data found for "${milestone.title}", returning 0%`);
    return {
      overall: 0,
      timeline: 0,
      budget: 0,
      physical: 0,
      timelineCapacity: milestone.timelineWeight || 0,
      budgetCapacity: milestone.budgetWeight || 0,
      physicalCapacity: milestone.physicalWeight || 0
    };
  }

  function populateMilestoneProgress(milestones, projectProgress = null) {
    console.log('📈 [ProjectDetailsModal] Populating milestone progress:', { 
      milestones, 
      type: typeof milestones, 
      isArray: Array.isArray(milestones),
      milestonesCount: milestones?.length || 0,
      projectProgress 
    });
    
    const container = document.getElementById('milestoneProgress');
    if (!container) {
      console.error('❌ Milestone progress container not found');
      return;
    }
    
    container.innerHTML = '';

    if (!milestones || !Array.isArray(milestones) || milestones.length === 0) {
      container.innerHTML = `
        <div class="bg-white p-4 rounded-lg border text-center text-gray-500">
          <p class="text-sm">No phase progress data available</p>
          <p class="text-xs text-gray-400 mt-1">Progress will be displayed once EIU submits updates</p>
        </div>
      `;
      return;
    }

    // Fetch milestone submissions to get accurate progress data
    const projectId = window.currentProject?.id || window.selectedProject?.id;
    let submissionsMap = {};
    
    // Fetch submissions if project ID is available
    if (projectId) {
      fetchMilestoneSubmissions(projectId).then(map => {
        submissionsMap = map || {};
        console.log('✅ [ProjectDetailsModal] Fetched submissions map:', Object.keys(submissionsMap).length, 'milestones have submissions');
        renderMilestoneProgress(milestones, submissionsMap);
      }).catch(err => {
        console.warn('⚠️ [ProjectDetailsModal] Could not fetch submissions, proceeding without:', err);
        renderMilestoneProgress(milestones, {});
      });
    } else {
      renderMilestoneProgress(milestones, {});
    }
  }

  // Fetch milestone submissions for a project
  async function fetchMilestoneSubmissions(projectId) {
    if (!projectId) return {};
    
    try {
      const token = localStorage.getItem('token') || sessionStorage.getItem('token');
      if (!token) return {};
      
      const API_URL = window.getApiUrl();
      const submissionsResponse = await fetch(`${API_URL}/milestones/milestone-submissions?projectId=${projectId}`, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });
      
      if (submissionsResponse.ok) {
        const submissionsData = await submissionsResponse.json();
        const submissions = submissionsData.submissions || submissionsData.data || [];
        
        // Create a map of milestoneId -> submissions array
        const map = {};
        submissions.forEach(submission => {
          if (!map[submission.milestoneId]) {
            map[submission.milestoneId] = [];
          }
          map[submission.milestoneId].push(submission);
        });
        
        return map;
      }
    } catch (error) {
      console.error('❌ [ProjectDetailsModal] Error fetching milestone submissions:', error);
    }
    
    return {};
  }

  // Render milestone progress cards
  function renderMilestoneProgress(milestones, submissionsMap) {
    const container = document.getElementById('milestoneProgress');
    if (!container) return;
    
    // Deduplicate milestones before rendering
    const seenIds = new Set();
    const seenTitles = new Set();
    const uniqueMilestones = [];
    
    milestones.forEach((milestone) => {
      const milestoneId = milestone.id || milestone.milestoneId;
      const milestoneTitle = (milestone.title || milestone.name || '').trim().toLowerCase();
      
      const isDuplicate = (milestoneId && seenIds.has(milestoneId)) || 
                         (milestoneTitle && seenTitles.has(milestoneTitle));
      
      if (!isDuplicate) {
        if (milestoneId) seenIds.add(milestoneId);
        if (milestoneTitle) seenTitles.add(milestoneTitle);
        uniqueMilestones.push(milestone);
      }
    });
    
    console.log(`📊 Rendering ${uniqueMilestones.length} unique milestones (filtered ${milestones.length - uniqueMilestones.length} duplicates)`);
    
    uniqueMilestones.forEach((milestone, index) => {
      const progressDiv = document.createElement('div');
      progressDiv.className = 'bg-white rounded-lg border border-gray-200 p-4';
      
      const title = milestone.title || milestone.name || `Milestone ${index + 1}`;
      
      // Attach submissions to milestone if available
      if (submissionsMap[milestone.id]) {
        milestone.submissions = submissionsMap[milestone.id];
      }
      
      // Calculate milestone-specific progress (NOT project overall progress)
      const milestoneProgressData = calculateMilestoneProgress(milestone, submissionsMap);
      
      // Get milestone weight for display
      const milestoneWeight = parseFloat(milestone.weight || 0);
      
      let overallProgress = milestoneProgressData.overall || 0;
      let timelineProgress = milestoneProgressData.timelineCapacity || milestoneProgressData.timeline || 0;
      let budgetProgress = milestoneProgressData.budgetCapacity || milestoneProgressData.budget || 0;
      let physicalProgress = milestoneProgressData.physicalCapacity || milestoneProgressData.physical || 0;
      let timelineLoaded = milestoneProgressData.timeline || 0;
      let budgetLoaded = milestoneProgressData.budget || 0;
      let physicalLoaded = milestoneProgressData.physical || 0;
      
      // Check if this specific milestone was approved/completed (for status badge only)
      const isMilestoneApproved = milestone.status === 'completed' || 
                                           milestone.status === 'approved' || 
                                           milestone.status === 'compiled_for_secretariat' ||
                                           milestone.status === 'Complete' ||
                                           milestone.status === 'complete' ||
                                           milestone.status === 'under_approval' ||
                                           milestone.status === 'approved_by_secretariat' ||
                                 milestone.status === 'in_progress' ||
                                 (milestone.timelineStatus === 'approved' && milestone.budgetStatus === 'approved' && milestone.physicalStatus === 'approved');
      
      // NOTE: We show the actual calculated progress regardless of approval status
      // The approval status only affects the status badge, not the progress values
      
      // For progress bar width: calculate fill percentage based on utilization within capacity
      let timelineBarWidth, budgetBarWidth, physicalBarWidth;
      if (isMilestoneApproved && timelineProgress > 0) {
        timelineBarWidth = (timelineLoaded / timelineProgress) * 100;
        } else {
        timelineBarWidth = 0;
      }
      
      if (isMilestoneApproved && budgetProgress > 0) {
        budgetBarWidth = (budgetLoaded / budgetProgress) * 100;
        } else {
        budgetBarWidth = 0;
      }
      
      if (isMilestoneApproved && physicalProgress > 0) {
        physicalBarWidth = (physicalLoaded / physicalProgress) * 100;
        } else {
        physicalBarWidth = 0;
      }
      
      // For progress bar colors
      const getProgressBarColor = (progress) => {
        if (progress >= 100) return 'bg-green-500';
        if (progress >= 50) return 'bg-blue-500';
        if (progress > 0) return 'bg-yellow-500';
        return 'bg-gray-300';
      };
      
      let timelineColor = isMilestoneApproved ? 'bg-green-500' : getProgressBarColor(timelineLoaded);
      let budgetColor = isMilestoneApproved ? 'bg-green-500' : getProgressBarColor(budgetLoaded);
      let physicalColor = isMilestoneApproved ? 'bg-green-500' : getProgressBarColor(physicalLoaded);
      
      console.log(`📈 Milestone ${index + 1} progress calculation:`, {
          title,
        isApproved: isMilestoneApproved,
          overallProgress,
          timelineProgress,
          budgetProgress,
          physicalProgress,
          timelineLoaded,
          budgetLoaded,
          physicalLoaded,
        timelineBarWidth,
        budgetBarWidth,
        physicalBarWidth
      });
      
      
      // Check milestone status - prioritize approved/completed status
      let status = milestone.status || 'pending';
      
      // Check if milestone has approved submission (from backend or milestone data)
      const hasApprovedSubmission = milestone.submissions?.some(s => 
        s.status === 'approved' || s.status === 'iu_approved'
      ) || false;
      
      // If milestone has approved submission, it's completed
      if (hasApprovedSubmission && status !== 'completed') {
        status = 'completed';
        console.log(`✅ Milestone "${title}" has approved submission, marking as completed`);
      }
      
      console.log(`🔍 Status mapping for milestone "${title}":`, {
        originalStatus: milestone.status,
        mappedStatus: status,
        hasApprovedSubmission: hasApprovedSubmission,
        statusType: typeof milestone.status,
        statusLength: milestone.status?.length,
        statusTrimmed: milestone.status?.trim(),
        statusLowercase: milestone.status?.toLowerCase(),
        statusChecks: {
          isCompleted: milestone.status === 'completed',
          isApproved: milestone.status === 'approved',
          isCompiled: milestone.status === 'compiled_for_secretariat',
          isComplete: milestone.status === 'Complete' || milestone.status === 'complete',
          isUnderApproval: milestone.status === 'under_approval',
          isApprovedBySecretariat: milestone.status === 'approved_by_secretariat',
          isInProgress: milestone.status === 'in_progress',
          isOngoing: milestone.status === 'ongoing',
          isDelayed: milestone.status === 'delayed'
        }
      });
      
      // Check if milestone is overdue
      const dueDate = milestone.dueDate || milestone.deadline || milestone.targetDate || milestone.completionDate;
      const isOverdue = dueDate && (() => {
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const milestoneDate = new Date(dueDate);
        milestoneDate.setHours(0, 0, 0, 0);
        return milestoneDate < today;
      })();
      
