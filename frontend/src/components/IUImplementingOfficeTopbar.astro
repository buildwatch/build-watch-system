  // Initialize sidebar toggle functionality
  function initializeSidebarToggle() {
    const sidebarToggleBtn = document.getElementById('iu-implementing-sidebar-toggle');
    const sidebar = document.querySelector('aside');
    const toggleIcon = document.getElementById('iu-implementing-sidebar-toggle-icon');
    
    if (sidebarToggleBtn && sidebar && toggleIcon) {
      console.log('🔧 Initializing IU Implementing Office sidebar toggle functionality');
      
      // Icon paths
      const hamburgerIcon = "M4 6h16M4 12h16M4 18h16";
      const arrowRightIcon = "M9 5l7 7-7 7";
      
      function updateIcon(isCollapsed) {
        // Add smooth rotation animation
        toggleIcon.style.transform = 'rotate(180deg)';
        toggleIcon.style.transition = 'all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        
        setTimeout(() => {
          const iconPath = toggleIcon.querySelector('path');
          if (iconPath) {
            iconPath.setAttribute('d', isCollapsed ? arrowRightIcon : hamburgerIcon);
          }
          toggleIcon.style.transform = 'rotate(0deg)';
        }, 200);
      }
      
      // Check if sidebar is collapsed from localStorage
      const isCollapsed = localStorage.getItem('iu-implementing-sidebar-collapsed') === 'true';
      if (isCollapsed) {
        sidebar.classList.add('collapsed');
        updateIcon(true);
      }
      
      // Function to update header class based on sidebar state
      function updateHeaderClass(isCollapsed) {
        const header = document.querySelector('header');
        if (header) {
          if (isCollapsed) {
            header.classList.remove('sidebar-expanded');
          } else {
            header.classList.add('sidebar-expanded');
          }
        }
      }
      
      // Initialize header class based on current sidebar state
      updateHeaderClass(isCollapsed);
      
      sidebarToggleBtn.addEventListener('click', () => {
        console.log('🔄 Toggling IU Implementing Office sidebar');
        
        const isCurrentlyCollapsed = sidebar.classList.contains('collapsed');
        
        if (isCurrentlyCollapsed) {
          // Expand sidebar
          sidebar.classList.remove('collapsed');
          localStorage.setItem('iu-implementing-sidebar-collapsed', 'false');
          updateIcon(false);
          updateHeaderClass(false);
          console.log('📖 IU Implementing Office Sidebar expanded');
        } else {
          // Collapse sidebar
          sidebar.classList.add('collapsed');
          localStorage.setItem('iu-implementing-sidebar-collapsed', 'true');
          updateIcon(true);
          updateHeaderClass(true);
          console.log('📕 IU Implementing Office Sidebar collapsed');
        }
      });
    } else {
      console.warn('❌ IU Implementing Office sidebar toggle elements not found');
    }
  }

  // Mobile Search Toggle Functionality
  function initializeIUMobileSearch() {
    const mobileSearchToggle = document.getElementById('iu-mobile-search-toggle');
    const mobileSearchWrapper = document.getElementById('iu-mobile-search-wrapper');
    const mobileSearchInput = document.getElementById('iu-mobile-search');
    const mobileSearchClose = document.getElementById('iu-mobile-search-close');
    
    if (!mobileSearchToggle || !mobileSearchWrapper || !mobileSearchInput) {
      return;
    }
    
    mobileSearchToggle.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isVisible = !mobileSearchWrapper.classList.contains('invisible');
      if (isVisible) {
        mobileSearchWrapper.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
        mobileSearchInput.blur();
      } else {
        mobileSearchWrapper.classList.remove('opacity-0', 'invisible', 'translate-y-[-10px]');
        mobileSearchWrapper.classList.add('opacity-100', 'visible', 'translate-y-0');
        setTimeout(() => mobileSearchInput.focus(), 100);
      }
    });
    
    if (mobileSearchClose) {
      mobileSearchClose.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        mobileSearchWrapper.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
        mobileSearchWrapper.classList.remove('opacity-100', 'visible', 'translate-y-0');
        mobileSearchInput.blur();
      });
    }
    
    document.addEventListener('click', (e) => {
      if (!mobileSearchWrapper.contains(e.target) && !mobileSearchToggle.contains(e.target)) {
        if (!mobileSearchWrapper.classList.contains('invisible')) {
          mobileSearchWrapper.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
          mobileSearchWrapper.classList.remove('opacity-100', 'visible', 'translate-y-0');
        }
      }
    });
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileSearchWrapper.classList.contains('invisible')) {
        mobileSearchWrapper.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
        mobileSearchWrapper.classList.remove('opacity-100', 'visible', 'translate-y-0');
        mobileSearchInput.blur();
