  // Mobile Search Toggle Functionality
  function initializeSecretariatMobileSearch() {
    const mobileSearchToggle = document.getElementById('secretariat-mobile-search-toggle');
    const mobileSearchWrapper = document.getElementById('secretariat-mobile-search-wrapper');
    const mobileSearchInput = document.getElementById('secretariat-mobile-search');
    const mobileSearchClose = document.getElementById('secretariat-mobile-search-close');
    
    if (!mobileSearchToggle || !mobileSearchWrapper || !mobileSearchInput) {
      return;
    }
    
    mobileSearchToggle.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isVisible = !mobileSearchWrapper.classList.contains('invisible');
      if (isVisible) {
        mobileSearchWrapper.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
        mobileSearchInput.blur();
      } else {
        mobileSearchWrapper.classList.remove('opacity-0', 'invisible', 'translate-y-[-10px]');
        mobileSearchWrapper.classList.add('opacity-100', 'visible', 'translate-y-0');
        setTimeout(() => mobileSearchInput.focus(), 100);
      }
    });
    
    if (mobileSearchClose) {
      mobileSearchClose.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        mobileSearchWrapper.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
        mobileSearchWrapper.classList.remove('opacity-100', 'visible', 'translate-y-0');
        mobileSearchInput.blur();
      });
    }
    
    document.addEventListener('click', (e) => {
      if (!mobileSearchWrapper.contains(e.target) && !mobileSearchToggle.contains(e.target)) {
        if (!mobileSearchWrapper.classList.contains('invisible')) {
          mobileSearchWrapper.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
          mobileSearchWrapper.classList.remove('opacity-100', 'visible', 'translate-y-0');
        }
      }
    });
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileSearchWrapper.classList.contains('invisible')) {
        mobileSearchWrapper.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
        mobileSearchWrapper.classList.remove('opacity-100', 'visible', 'translate-y-0');
        mobileSearchInput.blur();
      }
    });
    
    const desktopSearch = document.getElementById('secretariat-global-search');
    if (desktopSearch) {
      mobileSearchInput.addEventListener('input', (e) => {
        desktopSearch.value = e.target.value;
        if (desktopSearch.dispatchEvent) {
          desktopSearch.dispatchEvent(new Event('input', { bubbles: true }));
        }
      });
      desktopSearch.addEventListener('input', (e) => {
        mobileSearchInput.value = e.target.value;
      });
    }
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSecretariatMobileSearch);
