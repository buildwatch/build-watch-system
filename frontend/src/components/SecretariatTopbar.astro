    function updateClock() {
      const now = new Date();
      const options = { 
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'Asia/Manila'
      };
      
      const timeString = now.toLocaleString('en-US', options);
      sidebarClockEl.textContent = timeString;
    }
    
    // Update immediately and then every second
    updateClock();
    setInterval(updateClock, 1000);
  }

